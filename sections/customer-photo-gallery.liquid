{%- liquid
  assign ratio = '1 / 1'
  case section.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign portrait_height = section.settings.portrait_height | divided_by: 100.0
      assign ratio = '1 / ' | append: portrait_height
    when 'landscape'
      assign ratio = '4 / 3'
  endcase
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .photo-gallery-{{ section.id }} .photo-gallery__heading {
    margin: 0 0 24px;
  }

  .photo-gallery-{{ section.id }} .photo-gallery__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    gap: {{ section.settings.gap_mobile }}px;
  }

  .photo-gallery-{{ section.id }} .photo-gallery__item {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.corner_radius }}px;
    background-color: rgba(0, 0, 0, 0.04);
  }

  .photo-gallery-{{ section.id }} .photo-gallery__item img,
  .photo-gallery-{{ section.id }} .photo-gallery__item svg {
    width: 100%;
    display: block;
  }

  {%- if section.settings.image_ratio == 'adapt' -%}
    .photo-gallery-{{ section.id }} .photo-gallery__item img {
      height: auto;
    }
  {%- else -%}
    .photo-gallery-{{ section.id }} .photo-gallery__item {
      aspect-ratio: {{ ratio }};
    }
    .photo-gallery-{{ section.id }} .photo-gallery__item img {
      position: absolute;
      inset: 0;
      height: 100%;
      object-fit: cover;
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .photo-gallery-{{ section.id }} .photo-gallery__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
      gap: {{ section.settings.gap }}px;
    }
  }
{%- endstyle -%}

<div class="photo-gallery photo-gallery-{{ section.id }} section-{{ section.id }}-padding">
  <div class="page-width">

    {%- if section.settings.heading != blank -%}
      <h2
        class="photo-gallery__heading"
        style="text-align: {{ section.settings.heading_alignment }};"
      >
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="photo-gallery__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'image' -%}
            {%- capture image_markup -%}
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 400 }} 400w,
                    {{ block.settings.image | image_url: width: 600 }} 600w,
                    {{ block.settings.image | image_url: width: 800 }} 800w,
                    {{ block.settings.image | image_url: width: 1200 }} 1200w
                  "
                  sizes="(min-width: 750px) calc(100vw / {{ section.settings.columns_desktop }}), calc(100vw / {{ section.settings.columns_mobile }})"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'photo-gallery__placeholder' }}
              {%- endif -%}
            {%- endcapture -%}

            <div class="photo-gallery__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a
                  href="{{ block.settings.link }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="View customer photo"
                  style="display: block; width: 100%; height: 100%;"
                >
                  {{ image_markup }}
                </a>
              {%- else -%}
                {{ image_markup }}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Customer Photo Gallery",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to hide. (You already have a heading above, so you can leave this blank.)"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between images (desktop)",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap between images (mobile)",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Image style"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "info": "Pick \"Square\" or \"Portrait\" to crop all photos to the same shape so the grid looks even.",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "adapt", "label": "Adapt to original photo" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "portrait_height",
      "label": "Portrait image height",
      "min": 110,
      "max": 170,
      "step": 5,
      "unit": "%",
      "default": 125,
      "info": "Higher = taller images (less top/bottom cropping for tall photos). 125% matches the old 4:5 ratio."
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner rounding",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)",
          "info": "Optional. e.g. link to the Instagram post this photo came from."
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "Customer Photo Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}