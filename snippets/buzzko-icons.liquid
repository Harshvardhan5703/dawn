            <path d="M20 47 H30" stroke="#d9cfe6" stroke-width="2" stroke-linecap="round"/>
            <path class="bz-s bz-heart" d="M38 58 C33.4 54.8 32.6 51.2 35.4 50.2 C36.9 49.7 37.7 50.5 38 51.4 C38.3 50.5 39.1 49.7 40.6 50.2 C43.4 51.2 42.6 54.8 38 58 Z" fill="var(--bz-pink)" stroke-width="1.8"/>
          </g>
        </g>
        <path class="bz-s" d="M8 23 L32 41 L56 23 V46 Q56 52 50 52 H14 Q8 52 8 46 Z" fill="var(--bz-blue)"/>
      </svg>

    {%- when 6 -%}
      <svg class="bz-svg" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <circle class="bz-s" cx="32" cy="11" r="8" fill="none" stroke-width="3"/>
        <g class="bz-key-swing">
          <path class="bz-s" d="M32 19 V27" stroke-width="3"/>
          <circle class="bz-s" cx="32" cy="29.5" r="3" fill="#fff"/>
          <path class="bz-s" d="M32 58 C18 49 16 38 24 34.5 C28.5 32.6 31.4 35.2 32 38 C32.6 35.2 35.5 32.6 40 34.5 C48 38 46 49 32 58 Z" fill="var(--bz-pink)"/>
          <path d="M22.5 42 Q22.5 38.5 26 37.5" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" opacity=".9"/>
          <circle cx="28" cy="44" r="1.5" fill="var(--bz-ink)"/>
          <circle cx="36" cy="44" r="1.5" fill="var(--bz-ink)"/>
          <path class="bz-s" d="M29.7 47.6 Q32 49.8 34.3 47.6" stroke-width="1.8"/>
        </g>
        <g transform="translate(53 40)"><path class="bz-spark bz-spark-1" d="M0 -4 Q0 0 4 0 Q0 0 0 4 Q0 0 -4 0 Q0 0 0 -4Z" fill="#ffe08a" stroke="var(--bz-ink)" stroke-width="1.5" stroke-linejoin="round"/></g>
        <g transform="translate(10 44)"><path class="bz-spark bz-spark-2" d="M0 -3 Q0 0 3 0 Q0 0 0 3 Q0 0 -3 0 Q0 0 0 -3Z" fill="#b8e2ff" stroke="var(--bz-ink)" stroke-width="1.4" stroke-linejoin="round"/></g>
      </svg>

    {%- when 7 -%}
      <svg class="bz-svg" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <g class="bz-flame">
          <path class="bz-s" d="M32 3 C39 11 41.5 15 38.5 19.5 C36.5 21.5 27.5 21.5 25.5 19.5 C22.5 15 25 11 32 3 Z" fill="#ffab4a" stroke-width="2.2"/>
          <path d="M32 10.5 C35.6 15 36.6 17 35 19 C33.6 20.2 30.4 20.2 29 19 C27.4 17 28.4 15 32 10.5 Z" fill="var(--bz-yellow)"/>
        </g>
