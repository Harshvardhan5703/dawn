{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}


<!-- buzzko_dbg handle="{{ collection.handle }}" -->
<!-- buzzko_dbg filters="{% for f in collection.filters %}{{ f.label }}|{% endfor %}" -->
<!-- buzzko_dbg is_charm="{{ buzzko_is_charm_page }}" -->


{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* BuzzKo Coming Soon collection state */
  #ProductGridContainer .buzzko-coming-soon {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 460px;
    width: 100%;
    overflow: hidden;
    border-radius: 24px;
    background:
      radial-gradient(ellipse at 15% 20%, #F8B5D1 0, transparent 24%),
      radial-gradient(ellipse at 85% 25%, #BEE3F8 0, transparent 25%),
      radial-gradient(ellipse at 80% 85%, #D0F4DE 0, transparent 23%),
      radial-gradient(ellipse at 15% 85%, #FFECB3 0, transparent 22%),
      #FFF9F6;
  }

  #ProductGridContainer .buzzko-coming-soon__content {
    position: relative;
    z-index: 2;
    max-width: 520px;
    padding: 5rem 2rem;
    text-align: center;
  }

  #ProductGridContainer .buzzko-coming-soon__label {
    display: inline-block;
    margin: 0 0 1.8rem;
    padding: 0.7rem 1.6rem;
    border: 1px solid #1A1A1A;
    border-radius: 999px;
    background: #F8B5D1;
    color: #1A1A1A;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  #ProductGridContainer .buzzko-coming-soon__title {
    margin: 0;
    color: #1A1A1A;
    font-size: clamp(3rem, 5vw, 5.2rem);
    line-height: 1.1;
  }

  #ProductGridContainer .buzzko-coming-soon__text {
    max-width: 390px;
    margin: 1.8rem auto 0;
    color: #555;
    font-size: 1.6rem;
    line-height: 1.6;
  }

  #ProductGridContainer .buzzko-coming-soon__sparkle {
    display: block;
    margin-bottom: 0.8rem;
    color: #1A1A1A;
    font-size: 3rem;
  }

  #ProductGridContainer .buzzko-coming-soon__dots {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2.5rem;
  }

  #ProductGridContainer .buzzko-coming-soon__dots span {
    width: 3.2rem;
    height: 0.6rem;
    border-radius: 999px;
  }

  #ProductGridContainer .buzzko-coming-soon__dots span:nth-child(1) { background: #F8B5D1; }
  #ProductGridContainer .buzzko-coming-soon__dots span:nth-child(2) { background: #BEE3F8; }
  #ProductGridContainer .buzzko-coming-soon__dots span:nth-child(3) { background: #D0F4DE; }

  #ProductGridContainer .buzzko-coming-soon__shape {
    position: absolute;
    z-index: 1;
    display: block;
    border: 2px solid rgba(26, 26, 26, 0.12);
    border-radius: 30%;
    transform: rotate(25deg);
  }

  #ProductGridContainer .buzzko-coming-soon__shape--pink {
    top: 12%; left: 12%; width: 70px; height: 70px; background: #F8B5D1;
  }
  #ProductGridContainer .buzzko-coming-soon__shape--blue {
    top: 17%; right: 13%; width: 48px; height: 48px; background: #BEE3F8; transform: rotate(45deg);
  }
  #ProductGridContainer .buzzko-coming-soon__shape--yellow {
    bottom: 13%; left: 17%; width: 42px; height: 42px; background: #FFECB3; border-radius: 50%;
  }
  #ProductGridContainer .buzzko-coming-soon__shape--green {
    right: 15%; bottom: 12%; width: 64px; height: 64px; background: #D0F4DE; transform: rotate(15deg);
  }

  @media screen and (max-width: 749px) {
    #ProductGridContainer .buzzko-coming-soon { min-height: 380px; border-radius: 16px; }
    #ProductGridContainer .buzzko-coming-soon__content { padding: 4rem 2rem; }
    #ProductGridContainer .buzzko-coming-soon__title { font-size: 3.4rem; }
    #ProductGridContainer .buzzko-coming-soon__text { font-size: 1.4rem; }
    #ProductGridContainer .buzzko-coming-soon__shape--pink { width: 45px; height: 45px; }
    #ProductGridContainer .buzzko-coming-soon__shape--blue { width: 35px; height: 35px; }
    #ProductGridContainer .buzzko-coming-soon__shape--green { width: 42px; height: 42px; }
  }

  /* ============================================================
     BuzzKo: Soft filter UI
     ============================================================ */
  .facets__summary,
  .facets__disclosure .facets__summary {
    border: none !important;
    border-radius: 0 !important;
    padding: 0.8rem 0 !important;
    background: transparent !important;
  }

  .facets__summary > div,
  .facets__summary > span,
  .facets__summary > .svg-wrapper {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
  }

  .facets__summary svg,
  .facets__summary .icon-caret,
  .facets__summary .svg-wrapper {
    margin-inline-start: 10px !important;
    margin-left: 10px !important;
    flex-shrink: 0 !important;
    position: static !important;
    inset: auto !important;
  }

  .facets__summary > div > *:not(:first-child),
  .facets__summary span + * {
    margin-left: 10px !important;
  }

  .facets__summary span:first-child,
  .facets__summary .facets__summary-label {
    margin-inline-end: 4px !important;
    margin-right: 4px !important;
  }

  .facets__display {
    border-radius: 16px !important;
    border: 1px solid rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 12px 30px rgba(0, 0, 0, .08) !important;
    overflow: hidden;
  }

  .facets__price .field,
  .facets__price .field__input,
  .facets__price input[type="number"],
  .facets__price input[type="text"] {
    border-radius: 10px !important;
    border: 1px solid rgba(0, 0, 0, 0.15) !important;
    padding-left: 1.2rem !important;
  }

  .facets__price .field::after,
  .facets__price .field::before {
    border-radius: 10px !important;
  }

  .facets__price .field__label,
  .facets__price .field__currency {
    border-radius: 10px 0 0 10px !important;
  }

  .facet-checkbox > svg,
  .facet-checkbox .icon-checkmark,
  .facet-checkbox input[type="checkbox"] + .icon-checkmark {
    border-radius: 6px !important;
  }

  .facets__reset {
    border-radius: 6px !important;
    padding: 0.4rem 0.8rem;
  }

  .facets__button,
  .facets__button-no-js,
  .button.facets__button {
    border-radius: 8px !important;
  }

  .active-facets__button,
  .active-facets__button-inner {
    border-radius: 999px !important;
  }

  .facets__price .field__input,
  .facets__price input[type="number"],
  .facets__price input[type="text"] {
    border: 0 !important;
    box-shadow: none !important;
    outline: none !important;
    background: transparent !important;
    border-radius: 10px !important;
    padding-left: 1.2rem !important;
  }

  .facets__price .field::after,
  .facets__price .field::before {
    border: 1px solid rgba(0, 0, 0, 0.15) !important;
    border-radius: 10px !important;
    box-shadow: none !important;
    pointer-events: none !important;
  }

  .facets__price .field {
    border-radius: 10px !important;
    overflow: hidden !important;
  }

  .facets__price .field__input:focus,
  .facets__price .field__input:focus-visible,
  .facets__price input:focus,
  .facets__price input:focus-visible {
    border: 0 !important;
    box-shadow: none !important;
    outline: none !important;
  }

  .facets__price .field:focus-within::after,
  .facets__price .field:focus-within::before {
    border: 1px solid #1A1A1A !important;
    border-radius: 10px !important;
  }

  .facets__price input,
  .facets__price input[type="number"],
  .facets__price input[type="text"],
  .facets__price .field__input,
  .facets__price .field__input:focus,
  .facets__price .field__input:focus-visible,
  .facets__price .field__input:active {
    border: 0 !important;
    outline: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
    border-radius: 10px !important;
    padding-left: 1.2rem !important;
    -webkit-appearance: none !important;
    appearance: none !important;
  }

  .facets__price .field,
  .facets__price .field::before,
  .facets__price .field::after,
  .facets__price .field:focus-within::before,
  .facets__price .field:focus-within::after {
    border: 0 !important;
    box-shadow: none !important;
    outline: 0 !important;
  }

  .facets__price .field {
    border: 1px solid rgba(0, 0, 0, 0.15) !important;
    border-radius: 10px !important;
    overflow: hidden !important;
    background: transparent !important;
  }

  .facets__price .field:focus-within {
    border-color: #1A1A1A !important;
    box-shadow: none !important;
    outline: 0 !important;
  }

  @media screen and (max-width: 749px) {
    #main-collection-filters,
    .facets-wrapper,
    .facets-container,
    .facets__wrapper {
      margin-bottom: 24px !important;
    }

    #ProductGridContainer {
      padding-top: 8px;
    }

    .mobile-facets__wrapper,
    .mobile-facets {
      margin-bottom: 8px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  BuzzKo: figure out which filter groups must be hidden on this collection,
  so we can pre-hide them via CSS before they paint (no flash).
{%- endcomment -%}
{%- assign buzzko_category_handles = 'charms,lighters,frames,handicrafts,keychains' | split: ',' -%}
{%- assign buzzko_is_category_page = false -%}
{%- if buzzko_category_handles contains collection.handle -%}
  {%- assign buzzko_is_category_page = true -%}
{%- endif -%}
{%- assign buzzko_is_charm_page = false -%}
{%- if collection.handle == 'charms' -%}
  {%- assign buzzko_is_charm_page = true -%}
{%- endif -%}

{%- assign buzzko_hidden_indices = '' -%}
{%- for buzzko_filter in collection.filters -%}
  {%- assign buzzko_label = buzzko_filter.label | downcase -%}
  {%- assign buzzko_hide_this = false -%}

  {%- if buzzko_label contains 'categor' -%}
    {%- if buzzko_is_category_page -%}
      {%- assign buzzko_hide_this = true -%}
    {%- endif -%}
  {%- elsif buzzko_label contains 'charm style' -%}
    {%- unless buzzko_is_charm_page -%}
      {%- assign buzzko_hide_this = true -%}
    {%- endunless -%}
  {%- endif -%}

  {%- if buzzko_hide_this -%}
    {%- assign buzzko_hidden_indices = buzzko_hidden_indices | append: forloop.index | append: ',' -%}
  {%- endif -%}
{%- endfor -%}

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
        <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
          <form class="facets-vertical-form" id="FacetSortForm">
            <div class="facet-filters sorting caption">
              <div class="facet-filters__field">
                <h2 class="facet-filters__label caption-large text-body">
                  <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
                </h2>
                <div class="select">
                  {%- assign sort_by = collection.sort_by | default: 'most-relevant' -%}
                  <select
                    name="sort_by"
                    class="facet-filters__sort select__select caption-large"
                    id="SortBy"
                    aria-describedby="a11y-refresh-page-message"
                  >
                    {% render 'buzzko-sort-options', results: collection %}
                  </select>
                  <span class="svg-wrapper">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </div>
              </div>
            </div>

            <div class="product-count-vertical light" role="status">
              <h2 class="product-count__text text-body">
                <span id="ProductCountDesktop">
                  {%- if collection.results_count -%}
                    {{
                      'templates.search.results_with_count'
                      | t: terms: collection.terms, count: collection.results_count
                    }}
                  {%- elsif collection.products_count == collection.all_products_count -%}
                    {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                  {%- else -%}
                    {{
                      'products.facets.product_count'
                      | t: product_count: collection.products_count, count: collection.all_products_count
                    }}
                  {%- endif -%}
                </span>
              </h2>
              {%- render 'loading-spinner' -%}
            </div>
          </form>
        </facet-filters-form>
      {%- endif -%}

      <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
        {{ 'component-facets.css' | asset_url | stylesheet_tag }}
        <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

        {%- if buzzko_hidden_indices != blank -%}
          <style>
            {%- assign buzzko_indices = buzzko_hidden_indices | split: ',' -%}
            {%- for buzzko_idx in buzzko_indices -%}
              {%- if buzzko_idx != blank -%}
                .js-filter[data-index="{{ buzzko_idx }}"],
                .facets__disclosure[data-index="{{ buzzko_idx }}"],
                .js-filter[data-index="mobile-{{ buzzko_idx }}"],
                .facets__disclosure[data-index="mobile-{{ buzzko_idx }}"],
                .mobile-facets__details[data-index="mobile-{{ buzzko_idx }}"] {
                  display: none !important;
                }
              {%- endif -%}
            {%- endfor -%}
          </style>
        {%- endif -%}

        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <aside
            aria-labelledby="verticalTitle"
            class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
            id="main-collection-filters"
            data-id="{{ section.id }}"
          >
            {% render 'facets',
              results: collection,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: section.settings.enable_sorting,
              filter_type: section.settings.filter_type,
              paginate: paginate
            %}
          </aside>
        {%- endif -%}

        <div
          class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          id="ProductGridContainer"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
        >
          {%- if collection.products.size == 0 -%}
            <div
              class="collection collection--empty page-width"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>

              {% if collection.all_products_count == 0 %}
                <div class="buzzko-coming-soon">
                  <span class="buzzko-coming-soon__shape buzzko-coming-soon__shape--pink"></span>
                  <span class="buzzko-coming-soon__shape buzzko-coming-soon__shape--blue"></span>
                  <span class="buzzko-coming-soon__shape buzzko-coming-soon__shape--yellow"></span>
                  <span class="buzzko-coming-soon__shape buzzko-coming-soon__shape--green"></span>

                  <div class="buzzko-coming-soon__content">
                    <span class="buzzko-coming-soon__sparkle">✦</span>
                    <span class="buzzko-coming-soon__label">COMING SOON</span>

                    <h2 class="buzzko-coming-soon__title">
                      Something cute<br>is on its way!
                    </h2>

                    <p class="buzzko-coming-soon__text">
                      {{ collection.title | escape }} are getting ready.
                      Stay tuned for our next drop!
                    </p>

                    <div class="buzzko-coming-soon__dots">
                      <span></span>
                      <span></span>
                      <span></span>
                    </div>
                  </div>
                </div>
              {% else %}
                <div class="title-wrapper center">
                  <h2 class="title title--primary">
                    {{ 'sections.collection_template.empty' | t -}}
                    <br>
                    {{
                      'sections.collection_template.use_fewer_filters_html'
                      | t: link: collection.url, class: 'underlined-link link'
                    }}
                  </h2>
                </div>
              {% endif %}
            </div>
          {%- else -%}
            <div
              class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
            >
              <div class="loading-overlay gradient"></div>
              <ul
                id="product-grid"
                data-id="{{ section.id }}"
                class="
                  grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                  grid--{{ section.settings.columns_desktop }}-col-desktop
                  {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
                "
              >
                {% assign skip_card_product_styles = false %}
                {%- for product in collection.products -%}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}
                  <li
                    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                      {% comment %} 
                        RENDER THE GLOBAL PRODUCT CARD SNIPPET HERE 
                      {% endcomment %}
                      {% render 'buzzko-product-card', product: product, index: forloop.index0, card_subtitle: section.settings.card_subtitle %}
                  </li>
                  {%- assign skip_card_product_styles = true -%}
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
    {% if section.settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {%- endif -%}
  </div>
</collection-component>

<!-- Mobile 2-column Grid Override -->
<style>
  @media screen and (max-width: 749px) {
    #ProductGridContainer #product-grid.product-grid {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      grid-auto-flow: row !important;
      column-gap: 10px !important;
      row-gap: 12px !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      list-style: none !important;
    }

    #ProductGridContainer #product-grid.product-grid > .grid__item {
      display: block !important;
      width: auto !important;
      max-width: none !important;
      min-width: 0 !important;
      flex: 0 0 auto !important;
      grid-column: auto !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    #ProductGridContainer #product-grid.product-grid > .grid__item:only-child {
      width: auto !important;
      max-width: none !important;
      grid-column: span 2 !important;
    }
  }
</style>

<!-- Filter Caret Spacing Fixer -->
<script>
(function () {
  function fixCarets() {
    document.querySelectorAll('.facets__summary').forEach(function (summary) {
      var labelSpan = summary.querySelector('span');
      var caret = summary.querySelector('svg, .icon-caret, .svg-wrapper');

      if (caret) {
        caret.style.setProperty('margin-left', '10px', 'important');
        caret.style.setProperty('margin-inline-start', '10px', 'important');
        caret.style.setProperty('flex-shrink', '0', 'important');
      }
      if (labelSpan && labelSpan !== caret) {
        labelSpan.style.setProperty('margin-right', '6px', 'important');
      }
      var inner = summary.querySelector('div, span');
      if (inner && inner.contains(caret)) {
        inner.style.setProperty('display', 'inline-flex', 'important');
        inner.style.setProperty('align-items', 'center', 'important');
        inner.style.setProperty('gap', '10px', 'important');
      }
    });
  }

  fixCarets();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fixCarets);
  } else {
    fixCarets();
  }
  window.addEventListener('load', fixCarets);
  setTimeout(fixCarets, 400);
  setTimeout(fixCarets, 1200);

  if (window.MutationObserver) {
    var scheduled = false;
    new MutationObserver(function () {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(function () { scheduled = false; fixCarets(); });
    }).observe(document.body, { childList: true, subtree: true });
  }
  document.addEventListener('shopify:section:load', fixCarets);
})();
</script>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Products per row"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
