{% style %}
  #BuzzkoHero-{{ section.id }} {
    --buzzko-pink: #ff5ca8;
    --buzzko-bg: #fffaf5;
    --buzzko-radius: 30px;
  }

  #BuzzkoHero-{{ section.id }} {
    width: 100%;
    background: var(--buzzko-bg);
    overflow: hidden;
  }

  /* DESKTOP SPLIT LAYOUT */
  #BuzzkoHero-{{ section.id }} .buzzko-hero__container {
    width: min(1400px, calc(100% - 64px));
    margin: 0 auto;
    padding: 20px 0 40px; 
    display: grid;
    grid-template-columns: 1fr 1.4fr; 
    gap: 60px; 
    align-items: center;
  }

  /* LEFT SIDE STATIC CONTENT */
  #BuzzkoHero-{{ section.id }} .buzzko-hero__left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 32px; 
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__left-img {
    width: 100%;
    max-width: 450px; 
    height: auto;
    display: block;
    object-fit: contain;
  }

  /* BUTTON */
  #BuzzkoHero-{{ section.id }} .buzzko-hero__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 36px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    color: var(--btn-text, #fff);
    background: var(--btn-bg, var(--buzzko-pink));
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
    background: var(--btn-hover, #e94a96);
  }

  /* RIGHT SIDE SLIDESHOW */
  #BuzzkoHero-{{ section.id }} .buzzko-hero__slideshow {
    position: relative;
    width: 100%;
    border-radius: var(--buzzko-radius);
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__slides {
    position: relative;
    width: 100%;
    aspect-ratio: 1.5 / 1; 
    max-height: 520px; 
    background-color: #fdf3f5;
    overflow: hidden;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 500ms ease, visibility 500ms ease;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__slide picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__slide img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  /* CONTROLS (Arrows & Dots) */
  #BuzzkoHero-{{ section.id }} .buzzko-hero__controls {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__control {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.4);
    color: #ffffff;
    cursor: pointer;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 180ms ease;
    backdrop-filter: blur(4px);
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__control:hover {
    background: rgba(0, 0, 0, 0.7);
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__control--prev {
    left: 20px;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__control--next {
    right: 20px;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    pointer-events: auto;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__dot {
    width: 10px;
    height: 10px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.3);
    cursor: pointer;
    transition: background 180ms ease, width 180ms ease;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__dot.is-active {
    background: #111111;
    width: 24px;
    border-radius: 999px;
  }

  /* EMPTY STATE */
  #BuzzkoHero-{{ section.id }} .buzzko-hero__empty {
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--buzzko-radius);
    background: #eee;
    color: #666;
  }

  /* TABLET */
  @media screen and (max-width: 989px) {
    #BuzzkoHero-{{ section.id }} .buzzko-hero__container {
      display: block; 
      width: calc(100% - 40px);
      max-width: 900px; 
      padding: 20px 0 40px;
    }

    #BuzzkoHero-{{ section.id }} .buzzko-hero__left {
      display: none; 
    }

    #BuzzkoHero-{{ section.id }} .buzzko-hero__slides {
      aspect-ratio: 16 / 9;
      max-height: none;
      border-radius: 24px;
    }
  }

  /* MOBILE */
  @media screen and (max-width: 749px) {
    #BuzzkoHero-{{ section.id }} .buzzko-hero__container {
      display: block; 
      width: calc(100% - 28px);
      padding: 16px 0 32px;
    }

    #BuzzkoHero-{{ section.id }} .buzzko-hero__left {
      display: none;
    }

    #BuzzkoHero-{{ section.id }} .buzzko-hero__slides {
      aspect-ratio: 4 / 5;
      border-radius: 20px;
    }

    #BuzzkoHero-{{ section.id }} .buzzko-hero__control {
      display: none;
    }

    #BuzzkoHero-{{ section.id }} .buzzko-hero__dots {
      bottom: 16px;
    }
  }
{% endstyle %}

<section id="BuzzkoHero-{{ section.id }}" class="buzzko-hero">
  <div class="buzzko-hero__container">
    
    <!-- LEFT SIDE (Single Combined Image + Button) -->
    <div class="buzzko-hero__left">
      {% if section.settings.left_image != blank %}
        {{ section.settings.left_image | image_url: width: 800 | image_tag: class: 'buzzko-hero__left-img', loading: 'eager', alt: 'Hero Left Image' }}
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          class="buzzko-hero__cta-btn"
          style="
            --btn-bg: {{ section.settings.button_color }};
            --btn-text: {{ section.settings.button_text_color }};
            --btn-hover: {{ section.settings.button_hover_color }};
          "
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>

    <!-- RIGHT SIDE SLIDER -->
    <div
      class="buzzko-hero__slideshow"
      data-buzzko-slideshow
      data-autoplay="{{ section.settings.autoplay }}"
      data-interval="{{ section.settings.interval | times: 1000 }}"
    >
      {% if section.blocks.size > 0 %}
        <div class="buzzko-hero__slides">
          {% for block in section.blocks %}
            {% if block.settings.image != blank %}
              {% liquid
                assign slide_loading = 'lazy'
                if forloop.first
                  assign slide_loading = 'eager'
                endif
              %}
              <div class="buzzko-hero__slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
                <picture>
                  {% if block.settings.image_mobile != blank %}
                    <source
                      media="(max-width: 749px)"
                      srcset="
                        {{ block.settings.image_mobile | image_url: width: 600 }} 600w,
                        {{ block.settings.image_mobile | image_url: width: 800 }} 800w,
                        {{ block.settings.image_mobile | image_url: width: 1080 }} 1080w
                      "
                      sizes="100vw"
                    >
                  {% endif %}
                  {{ block.settings.image
                    | image_url: width: 2400
                    | image_tag:
                      loading: slide_loading,
                      widths: '600,800,1000,1200,1400,1600,1800,2000,2400',
                      sizes: '(min-width: 990px) 60vw, 100vw',
                      alt: block.settings.alt_text
                  }}
                </picture>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if section.settings.show_slide_controls and section.blocks.size > 1 %}
          <div class="buzzko-hero__controls">
            
            <button type="button" class="buzzko-hero__control buzzko-hero__control--prev" data-slide-prev aria-label="Previous slide">
              <!-- SVG Left Arrow -->
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            
            <div class="buzzko-hero__dots">
              {% for block in section.blocks %}
                {% if block.settings.image != blank %}
                  <button
                    type="button"
                    class="buzzko-hero__dot{% if forloop.first %} is-active{% endif %}"
                    data-slide-dot="{{ forloop.index0 }}"
                    aria-label="Go to slide {{ forloop.index }}"
                  ></button>
                {% endif %}
              {% endfor %}
            </div>
            
            <button type="button" class="buzzko-hero__control buzzko-hero__control--next" data-slide-next aria-label="Next slide">
              <!-- SVG Right Arrow -->
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>

          </div>
        {% endif %}

      {% else %}
        <div class="buzzko-hero__empty">Add a hero slide from the theme editor.</div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.querySelector('#BuzzkoHero-{{ section.id }}');
    if (!section) return;

    const slideshow = section.querySelector('[data-buzzko-slideshow]');
    if (!slideshow) return;

    const slides = Array.from(slideshow.querySelectorAll('[data-slide]'));
    if (slides.length <= 1) return;

    const dots = Array.from(slideshow.querySelectorAll('[data-slide-dot]'));
    const nextButton = slideshow.querySelector('[data-slide-next]');
    const prevButton = slideshow.querySelector('[data-slide-prev]');

    let currentIndex = 0;
    let timer = null;

    const showSlide = (index) => {
      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === currentIndex);
      });

      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === currentIndex);
      });
    };

    const nextSlide = () => showSlide(currentIndex + 1);
    const prevSlide = () => showSlide(currentIndex - 1);

    const startAutoplay = () => {
      if (slideshow.dataset.autoplay !== 'true') return;
      const interval = Number(slideshow.dataset.interval) || 5000;
      clearInterval(timer);
      timer = setInterval(nextSlide, interval);
    };

    nextButton?.addEventListener('click', () => { nextSlide(); startAutoplay(); });
    prevButton?.addEventListener('click', () => { prevSlide(); startAutoplay(); });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        showSlide(Number(dot.dataset.slideDot));
        startAutoplay();
      });
    });

    /* MOBILE SWIPE */
    let touchStartX = 0;
    let touchEndX = 0;

    slideshow.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    slideshow.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    const handleSwipe = () => {
      const swipeThreshold = 50;
      if (touchEndX < touchStartX - swipeThreshold) {
        nextSlide();
        startAutoplay();
      }
      if (touchEndX > touchStartX + swipeThreshold) {
        prevSlide();
        startAutoplay();
      }
    };

    showSlide(0);
    startAutoplay();

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.detail.sectionId === '{{ section.id }}') {
        clearInterval(timer);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "BuzzKo Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Left Side Content (Desktop Only)"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Combined Left Image",
      "info": "Upload a single image with both 'NOW OPEN' and 'Cute Essentials'"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#ff5ca8"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button background on hover",
      "default": "#e94a96"
    },
    {
      "type": "header",
      "content": "Slideshow Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slideshow",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Slide duration",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_slide_controls",
      "label": "Show arrows and dots",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop slide image",
          "info": "Recommended: 1600 x 1066px (1.5:1)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile slide image",
          "info": "Recommended: 1080 x 1350px (4:5). Leave empty to use Desktop image."
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BuzzKo Hero",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}