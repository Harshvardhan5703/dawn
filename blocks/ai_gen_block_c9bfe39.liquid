{% doc %}
  @prompt
    Create a visually rich and vibrant Returns & Refunds page section for a gift and accessories brand called Buzzko. The section should have a fun, modern aesthetic with colorful icons or emoji, styled cards or blocks for each topic (Return Window, Refund Process, Non-Returnable Items, Exchanges, How to Initiate a Return), bold headings, pastel or vibrant background colors per card, and good spacing. Each card should have an icon or emoji, a heading, and concise info. Make it feel lively and on-brand — not just plain text on a white background.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-returns-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 48px 20px;
    background: #fffaf5;
    color: #171717;
    box-sizing: border-box;
  }

  .ai-returns-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-returns-{{ ai_gen_id }}__intro {
    text-align: center;
    margin: 0 auto 32px;
    max-width: 720px;
  }

  .ai-returns-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 10px;
    color: #7139a5;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .ai-returns-{{ ai_gen_id }}__title {
    margin: 0 0 12px;
    color: #171717;
    font-size: clamp(30px, 5vw, 48px);
    line-height: 1.08;
    font-weight: 800;
  }

  .ai-returns-{{ ai_gen_id }}__lead {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
  }

  .ai-returns-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }

  .ai-returns-{{ ai_gen_id }}__card {
    grid-column: span 2;
    min-height: 190px;
    padding: 24px;
    border-radius: 20px;
    color: #171717;
    box-sizing: border-box;
  }

  .ai-returns-{{ ai_gen_id }}__card:nth-child(1) { background: #ffe6a7; }
  .ai-returns-{{ ai_gen_id }}__card:nth-child(2) { background: #d9f2e6; }
  .ai-returns-{{ ai_gen_id }}__card:nth-child(3) { background: #eadcff; }
  .ai-returns-{{ ai_gen_id }}__card:nth-child(4) { background: #ffdcd4; }
  .ai-returns-{{ ai_gen_id }}__card:nth-child(5) { background: #d9e9ff; }
  .ai-returns-{{ ai_gen_id }}__card:nth-child(4),
  .ai-returns-{{ ai_gen_id }}__card:nth-child(5) { grid-column: span 3; }

  .ai-returns-{{ ai_gen_id }}__icon {
    display: block;
    margin-bottom: 12px;
    font-size: 30px;
    line-height: 1;
  }

  .ai-returns-{{ ai_gen_id }}__card-title {
    margin: 0 0 8px;
    font-size: 21px;
    line-height: 1.2;
    font-weight: 800;
  }

  .ai-returns-{{ ai_gen_id }}__copy {
    font-size: 15px;
    line-height: 1.55;
  }

  .ai-returns-{{ ai_gen_id }}__copy p { margin: 0; }

  @media screen and (max-width: 749px) {
    .ai-returns-{{ ai_gen_id }} { padding: 36px 16px; }
    .ai-returns-{{ ai_gen_id }}__inner { width: 100%; }
    .ai-returns-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; gap: 12px; }
    .ai-returns-{{ ai_gen_id }}__card,
    .ai-returns-{{ ai_gen_id }}__card:nth-child(4),
    .ai-returns-{{ ai_gen_id }}__card:nth-child(5) { grid-column: auto; min-height: 0; padding: 22px; }
  }
{% endstyle %}

<section class="ai-returns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-returns-{{ ai_gen_id }}__inner">
    <header class="ai-returns-{{ ai_gen_id }}__intro">
      {% if block.settings.eyebrow != blank %}<p class="ai-returns-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      <h2 class="ai-returns-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
      <div class="ai-returns-{{ ai_gen_id }}__lead">{{ block.settings.intro }}</div>
    </header>
    <div class="ai-returns-{{ ai_gen_id }}__grid">
      {% for i in (1..5) %}
        {% liquid
          assign icon_key = 'card_' | append: i | append: '_icon'
          assign title_key = 'card_' | append: i | append: '_title'
          assign copy_key = 'card_' | append: i | append: '_copy'
        %}
        <article class="ai-returns-{{ ai_gen_id }}__card">
          <span class="ai-returns-{{ ai_gen_id }}__icon" aria-hidden="true">{{ block.settings[icon_key] | escape }}</span>
          <h3 class="ai-returns-{{ ai_gen_id }}__card-title">{{ block.settings[title_key] | escape }}</h3>
          <div class="ai-returns-{{ ai_gen_id }}__copy">{{ block.settings[copy_key] }}</div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Returns and refunds",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Buzzko care guide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Returns, made easy ✨" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Something not quite right? Here’s the quick guide to getting things sorted.</p>" },
    { "type": "header", "content": "Return window" },
    { "type": "text", "id": "card_1_icon", "label": "Icon", "default": "⏰" },
    { "type": "text", "id": "card_1_title", "label": "Heading", "default": "Return window" },
    { "type": "richtext", "id": "card_1_copy", "label": "Details", "default": "<p>Request a return within 7 days of delivery. Keep your item unused and in its original packaging.</p>" },
    { "type": "header", "content": "Refund process" },
    { "type": "text", "id": "card_2_icon", "label": "Icon", "default": "💸" },
    { "type": "text", "id": "card_2_title", "label": "Heading", "default": "Refund process" },
    { "type": "richtext", "id": "card_2_copy", "label": "Details", "default": "<p>After your return is received and checked, approved refunds go back to your original payment method.</p>" },
    { "type": "header", "content": "Non-returnable items" },
    { "type": "text", "id": "card_3_icon", "label": "Icon", "default": "🚫" },
    { "type": "text", "id": "card_3_title", "label": "Heading", "default": "Non-returnable items" },
    { "type": "richtext", "id": "card_3_copy", "label": "Details", "default": "<p>Personalised, custom-made, final-sale, and used items can’t be returned unless they arrive damaged or faulty.</p>" },
    { "type": "header", "content": "Exchanges" },
    { "type": "text", "id": "card_4_icon", "label": "Icon", "default": "🔁" },
    { "type": "text", "id": "card_4_title", "label": "Heading", "default": "Exchanges" },
    { "type": "richtext", "id": "card_4_copy", "label": "Details", "default": "<p>Want a different style? Contact us to check availability. Exchanges depend on stock and must meet the return conditions.</p>" },
    { "type": "header", "content": "Start a return" },
    { "type": "text", "id": "card_5_icon", "label": "Icon", "default": "📩" },
    { "type": "text", "id": "card_5_title", "label": "Heading", "default": "How to initiate a return" },
    { "type": "richtext", "id": "card_5_copy", "label": "Details", "default": "<p>Message our support team with your order number and reason for return. We’ll share the next steps and return instructions.</p>" }
  ],
  "presets": [
    { "name": "Returns and refunds" }
  ],
  "tag": null,
  "class": "buzzko-returns-block"
}
{% endschema %}