{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* =====================================================
     BuzzKo cart — page layout
  ===================================================== */
  #MainContent:has(cart-items):has(#main-cart-footer:not(.is-empty)) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: 40px;
    align-items: start;
    max-width: 1360px;
    margin: 0 auto;
    padding: 48px 40px 80px;
  }

  @media screen and (max-width: 989px) {
    #MainContent:has(cart-items):has(#main-cart-footer:not(.is-empty)) {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 32px 20px 64px;
    }
  }

  /* Page header */
  .buzzko-cart-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin: 0 0 28px;
  }

  /* Hide header instantly if Dawn's AJAX empties the cart */
  cart-items.is-empty .buzzko-cart-header { display: none; }

  .buzzko-cart-header__title {
    margin: 0;
    color: #1A1A1A;
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .buzzko-cart-header__title::after {
    content: " ✦";
    color: #FF60B9;
    font-size: 0.7em;
    vertical-align: top;
  }

  .buzzko-cart-header__link {
    color: #1A1A1A;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1.5px solid currentColor;
    padding-bottom: 2px;
    white-space: nowrap;
  }

  .buzzko-cart-header__link:hover { color: #FF60B9; }

  /* =====================================================
     Line items
  ===================================================== */
  .buzzko-cart-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Dawn dims the list while a request is running; keep it fully visible so it feels instant */
  #main-cart-items.cart__items--disabled { opacity: 1 !important; }

  .buzzko-cart-list .js-contents {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .buzzko-item {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
    padding: 18px;
    background: #fff;
    border: 1.5px solid #EBE5DF;
    border-radius: 16px;
  }

  .buzzko-item:hover {
    border-color: #DCD4CC;
    box-shadow: 0 4px 18px rgba(26, 26, 26, 0.05);
  }

  .buzzko-item__media {
    display: block;
    width: 96px;
    height: 96px;
    border-radius: 12px;
    overflow: hidden;
    background: #F5F1EC;
    flex-shrink: 0;
  }

  .buzzko-item__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .buzzko-item__body { min-width: 0; }

  .buzzko-item__title {
    display: inline-block;
    margin: 0 0 4px;
    color: #1A1A1A;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    text-decoration: none;
  }

  .buzzko-item__title:hover { text-decoration: underline; }

  .buzzko-item__variant {
    margin: 0 0 2px;
    color: #85807B;
    font-size: 12.5px;
    line-height: 1.4;
  }

  .buzzko-item__sku {
    color: #B5AEA7;
    font-size: 11.5px;
    letter-spacing: 0.02em;
    line-height: 1.4;
  }

  .buzzko-item__stock {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    color: #1A1A1A;
    font-size: 12px;
    font-weight: 600;
  }

  .buzzko-item__stock svg { width: 14px; height: 14px; color: #4CAF50; flex-shrink: 0; }
  .buzzko-item__stock--out svg { color: #C24545; }

  .buzzko-item__right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
    min-width: 200px;
  }

  .buzzko-item__price {
    color: #1A1A1A;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-align: right;
    white-space: nowrap;
    line-height: 1.3;
    display: flex;
    align-items: baseline;
    gap: 8px;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .buzzko-item__price-compare {
    color: #B5AEA7;
    font-size: 12px;
    font-weight: 500;
    text-decoration: line-through;
  }

  .buzzko-item__controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .buzzko-item .quantity {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid #EBE5DF;
    border-radius: 999px;
    background: #fff;
    overflow: hidden;
    min-height: 36px;
  }

  .buzzko-item .quantity__button {
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    background: transparent !important;
    color: #1A1A1A;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .buzzko-item .quantity__button:disabled,
  .buzzko-item .quantity__button.disabled { opacity: .35; cursor: not-allowed; }
  .buzzko-item .quantity__button.disabled { pointer-events: auto !important; }

  .buzzko-item .quantity__button svg { width: 12px; height: 12px; }
  .buzzko-item .quantity__button .svg-wrapper { width: 12px; height: 12px; display: inline-flex; }

  .buzzko-item .quantity__input {
    width: 32px;
    height: 34px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #1A1A1A;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
    -moz-appearance: textfield;
    appearance: textfield;
    font-family: inherit;
  }

  .buzzko-item .quantity__input::-webkit-outer-spin-button,
  .buzzko-item .quantity__input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .buzzko-item__trash {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #85807B;
    cursor: pointer;
    text-decoration: none;
  }

  .buzzko-item__trash svg {
    width: 16px;
    height: 16px;
  }

  .buzzko-item__trash:hover {
    color: #C24545;
    background: #FCEFEF;
  }


  .buzzko-item__discounts {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    color: #1A1A1A;
    font-size: 12px;
    font-weight: 600;
  }

  .buzzko-item__discounts li { display: inline-flex; align-items: center; gap: 4px; }
  .buzzko-item__discounts svg { width: 12px; height: 12px; }

  .buzzko-item__error {
    margin-top: 8px;
    color: #C24545;
    font-size: 12px;
    font-weight: 600;
  }

  /* Let Dawn's updateLiveRegions reveal the row when it writes a message */
  .buzzko-item__error:has(.cart-item__error-text:not(:empty)) {
    display: block !important;
  }

  @media screen and (max-width: 749px) {
    .buzzko-item {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 14px;
      padding: 14px;
    }

    .buzzko-item__media { width: 72px; height: 72px; border-radius: 10px; }

    .buzzko-item__right {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-width: 0;
      padding-top: 14px;
      margin-top: 4px;
      border-top: 1px dashed #EBE5DF;
    }

    .buzzko-item__price { text-align: left; justify-content: flex-start; }
  }

  /* =====================================================
     Empty state
  ===================================================== */
  cart-items.is-empty .page-width { max-width: 720px; padding: 0 20px; }
  cart-items.is-empty .title-wrapper-with-link { display: none; }

  .buzzko-empty {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: 40px auto 60px;
    padding: 72px 32px;
    border-radius: 24px;
    text-align: center;
    background:
      radial-gradient(ellipse at 15% 20%, #F8B5D1 0, transparent 24%),
      radial-gradient(ellipse at 85% 25%, #BEE3F8 0, transparent 25%),
      radial-gradient(ellipse at 80% 85%, #D0F4DE 0, transparent 23%),
      radial-gradient(ellipse at 15% 85%, #FFECB3 0, transparent 22%),
      #FFF9F6;
  }

  .buzzko-empty__emoji {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin: 0 auto 22px;
    border-radius: 50%;
    background: #FFECB3;
    font-size: 32px;
    line-height: 1;
  }

  .buzzko-empty__label {
    display: inline-block;
    margin: 0 0 16px;
    padding: 7px 14px;
    border: 1.5px solid #1A1A1A;
    border-radius: 999px;
    background: #F8B5D1;
    color: #1A1A1A;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .buzzko-empty__title {
    max-width: 460px;
    margin: 0 auto 12px;
    color: #1A1A1A;
    font-size: clamp(26px, 3.4vw, 38px);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .buzzko-empty__text {
    max-width: 380px;
    margin: 0 auto 26px;
    color: #6B6663;
    font-size: 15px;
    line-height: 1.6;
  }

  .buzzko-empty__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: 999px;
    background: #F8B5D1;
    color: #1A1A1A;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .buzzko-empty__cta:hover { background: #e469af; transform: translateY(-1px); }

  .buzzko-item__each {
    margin: -10px 0 0;
    color: #85807B;
    font-size: 12px;
    font-weight: 500;
    text-align: right;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .buzzko-item__each[hidden] { display: none; }

  @media screen and (max-width: 749px) {
    .buzzko-item__each { text-align: left; margin-top: -6px; }
  }

  /* BuzzKo mobile hardening */
  @media screen and (max-width: 749px) {
    .buzzko-item__body { min-width: 0; }

    .buzzko-item__title {
      display: block;
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .buzzko-item__trash { flex-shrink: 0; }

    .buzzko-item__price {
      min-width: 0;
      flex-wrap: wrap;
    }
  }

  @media screen and (max-width: 749px) {
    .buzzko-item__right {
      grid-column: 1 / -1 !important;
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) auto !important;
      grid-template-areas:
        "price controls"
        "each  controls" !important;
      align-items: center !important;
      column-gap: 14px !important;
      row-gap: 2px !important;
      min-width: 0 !important;
      width: 100% !important;
      padding-top: 14px !important;
      margin-top: 4px !important;
      border-top: 1px dashed #EBE5DF !important;
    }

    .buzzko-item__price {
      grid-area: price !important;
      justify-content: flex-start !important;
      text-align: left !important;
      flex-wrap: nowrap !important;
      gap: 8px !important;
      min-width: 0 !important;
    }

    .buzzko-item__each {
      grid-area: each !important;
      text-align: left !important;
      margin: 0 !important;
    }

    .buzzko-item__controls {
      grid-area: controls !important;
      gap: 8px !important;
    }

    .buzzko-item .quantity { min-height: 32px !important; }
    .buzzko-item .quantity__button { width: 28px !important; height: 28px !important; }
    .buzzko-item .quantity__input {
      width: 28px !important;
      height: 32px !important;
      font-size: 12.5px !important;
    }

    .buzzko-item__trash {
      width: 32px !important;
      height: 32px !important;
      flex-shrink: 0 !important;
    }
  }

  @media screen and (max-width: 749px) {
    .buzzko-item .quantity {
      min-height: 30px !important;
      border-radius: 999px !important;
    }

    .buzzko-item .quantity__button {
      width: 30px !important;
      height: 30px !important;
    }

    .buzzko-item .quantity__button svg,
    .buzzko-item .quantity__button .svg-wrapper {
      width: 11px !important;
      height: 11px !important;
    }

    .buzzko-item .quantity__input {
      width: 26px !important;
      height: 30px !important;
      font-size: 12.5px !important;
      font-weight: 600 !important;
    }

    .buzzko-item__right { column-gap: 12px !important; }
    .buzzko-item__controls { gap: 6px !important; }

    .buzzko-item__trash {
      width: 30px !important;
      height: 30px !important;
    }
  }

  @media screen and (max-width: 749px) {
    .buzzko-item__controls { align-items: center !important; }

    .buzzko-item .quantity {
      display: inline-flex !important;
      width: 78px !important;
      min-width: 74px !important;
      max-width: 79px !important;
      min-height: 30px !important;
      height: 30px !important;
      flex: 0 0 auto !important;
    }

    .buzzko-item .quantity__button {
      width: 24px !important;
      min-width: 24px !important;
      max-width: 24px !important;
      height: 30px !important;
      padding: 0 !important;
      flex: 0 0 24px !important;
      background: transparent !important;
      border: 0 !important;
    }

    .buzzko-item .quantity__button svg,
    .buzzko-item .quantity__button .svg-wrapper {
      width: 9px !important;
      height: 9px !important;
      max-width: 9px !important;
      max-height: 9px !important;
    }

    .buzzko-item .quantity__input {
      width: 26px !important;
      min-width: 26px !important;
      max-width: 26px !important;
      height: 30px !important;
      padding: 0 !important;
      flex: 0 0 26px !important;
      font-size: 12px !important;
      text-align: center !important;
    }
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<span hidden data-buzzko-money-format="{{ shop.money_format | escape }}"></span>

<cart-items
  class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% endif %}"
  view-event-payload="{{ cart | standard_event_data: 'view', context: 'page' | escape }}"
>
  <div class="page-width">

    {%- if cart == empty -%}
      <div class="buzzko-empty">
        <span class="buzzko-empty__emoji" aria-hidden="true">🛍️</span>
        <span class="buzzko-empty__label">YOUR BAG</span>
        <h1 class="buzzko-empty__title">Your cart is feeling a little light…</h1>
        <p class="buzzko-empty__text">Let's fill it with something cute. Your little favourites are waiting.</p>
        <a href="{{ routes.all_products_collection_url }}" class="buzzko-empty__cta">
          Start shopping
        </a>
      </div>
      
      <!-- Dummy .js-contents so Dawn's AJAX doesn't throw an error if it tries to find it -->
      <div class="js-contents" hidden></div>

    {%- else -%}
      <header class="buzzko-cart-header">
        <h1 class="buzzko-cart-header__title">{{ 'sections.cart.title' | t }}</h1>
        <a href="{{ routes.all_products_collection_url }}" class="buzzko-cart-header__link">
          {{ 'general.continue_shopping' | t }}
        </a>
      </header>

      <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart__contents critical-hidden">
        <div class="cart__items buzzko-cart-list" id="main-cart-items" data-id="{{ section.id }}">
          <div class="js-contents">
            {%- for item in cart.items -%}
              {%- liquid
                assign can_update_quantity = item.instructions.can_update_quantity | default: true
                assign can_remove = item.instructions.can_remove | default: true
                assign min_qty = item.variant.quantity_rule.min | default: 1
                assign max_qty = item.variant.quantity_rule.max
                if max_qty == nil and item.variant.inventory_management != blank and item.variant.inventory_policy == 'deny' and item.variant.inventory_quantity > 0
                  assign max_qty = item.variant.inventory_quantity
                endif
                assign show_compare = false
                if item.variant.compare_at_price > item.final_price
                  assign show_compare = true
                endif
              -%}
              <div
                class="buzzko-item cart-item"
                id="CartItem-{{ item.index | plus: 1 }}"
                data-index="{{ item.index | plus: 1 }}"
                data-line-key="{{ item.key }}"
                data-qty="{{ item.quantity }}"
                data-line-cents="{{ item.final_line_price }}"
                data-unit-final="{{ item.final_price }}"
                data-unit-original="{{ item.original_price }}"
              >
                <a href="{{ item.url }}" class="buzzko-item__media" aria-hidden="true" tabindex="-1">
                  {%- if item.image -%}
                    <img
                      src="{{ item.image | image_url: width: 240 }}"
                      alt="{{ item.image.alt | escape }}"
                      loading="lazy"
                      width="120"
                      height="{{ 120 | divided_by: item.image.aspect_ratio | ceil }}"
                    >
                  {%- endif -%}
                </a>

                <div class="buzzko-item__body">
                  <a href="{{ item.url }}" class="buzzko-item__title">
                    {{- item.product.title | escape -}}
                  </a>

                  {%- unless item.product.has_only_default_variant -%}
                    <div class="buzzko-item__variant">
                      {%- for option in item.options_with_values -%}
                        {{ option.value }}{% unless forloop.last %} · {% endunless %}
                      {%- endfor -%}
                    </div>
                  {%- endunless -%}

                  {%- if item.sku != blank -%}
                    <div class="buzzko-item__sku">SKU: {{ item.sku }}</div>
                  {%- endif -%}

                  <div class="buzzko-item__stock{% unless item.variant.available %} buzzko-item__stock--out{% endunless %}">
                    {%- if item.variant.available -%}
                      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M3 8.5l3.5 3.5L13 5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      In Stock
                    {%- else -%}
                      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="8" cy="8" r="6"/>
                        <path d="M8 5v4M8 11.5v.01" stroke-linecap="round"/>
                      </svg>
                      Out of Stock
                    {%- endif -%}
                  </div>

                  {%- if item.line_level_discount_allocations.size > 0 -%}
                    <ul class="buzzko-item__discounts">
                      {%- for discount in item.line_level_discount_allocations -%}
                        <li>
                          {{- 'icon-discount.svg' | inline_asset_content -}}
                          {{ discount.discount_application.title | escape }}
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="buzzko-item__right">
                  <div class="buzzko-item__price">
                    {%- if item.original_line_price != item.final_line_price -%}
                      <span>{{ item.final_line_price | money }}</span>
                      <s class="buzzko-item__price-compare">{{ item.original_line_price | money }}</s>
                    {%- else -%}
                      <span>{{ item.original_line_price | money }}</span>
                      {%- if show_compare -%}
                        {%- assign compare_line = item.variant.compare_at_price | times: item.quantity -%}
                        <s
                          class="buzzko-item__price-compare"
                          data-buzzko-compare
                          data-line-key="{{ item.key }}"
                          data-compare-unit="{{ item.variant.compare_at_price }}"
                        >{{ compare_line | money }}</s>
                      {%- endif -%}
                    {%- endif -%}
                  </div>

                  <div
                    class="buzzko-item__each"
                    data-buzzko-each
                    data-line-key="{{ item.key }}"
                    {% if item.quantity <= 1 %}hidden{% endif %}
                  >
                    {{ item.final_price | money }} each
                  </div>

                  <div class="buzzko-item__controls">
                    <quantity-input class="quantity cart-quantity">
                      <button
                        class="quantity__button{% if item.quantity <= min_qty %} disabled{% endif %}"
                        name="minus"
                        type="button"
                        {% if can_update_quantity == false %}disabled{% endif %}
                        aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}"
                      >
                        <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
                      </button>
                      <input
                        class="quantity__input"
                        data-quantity-variant-id="{{ item.variant.id }}"
                        data-quantity-line-key="{{ item.key }}"
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        {% # theme-check-disable %}
                        data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                        min="{{ min_qty }}"
                        data-min="{{ item.variant.quantity_rule.min }}"
                        {% if max_qty != nil %}max="{{ max_qty }}"{% endif %}
                        step="{{ item.variant.quantity_rule.increment }}"
                        {% # theme-check-enable %}
                        aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                        id="Quantity-{{ item.index | plus: 1 }}"
                        data-index="{{ item.index | plus: 1 }}"
                        {% if can_update_quantity == false %}disabled{% endif %}
                      >
                      <button
                        class="quantity__button{% if max_qty != nil and item.quantity >= max_qty %} disabled{% endif %}"
                        name="plus"
                        type="button"
                        {% if can_update_quantity == false %}disabled{% endif %}
                        aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}"
                      >
                        <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                      </button>
                    </quantity-input>

                    <cart-remove-button
                      id="Remove-{{ item.index | plus: 1 }}"
                      data-index="{{ item.index | plus: 1 }}"
                      {% unless can_remove %}class="hidden"{% endunless %}
                    >
                      <a
                        href="{{ item.url_to_remove }}"
                        class="buzzko-item__trash"
                        aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                        title="Remove"
                      >
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M2.5 4.5h11"/>
                          <path d="M5.5 4.5V3.2a1 1 0 011-1h3a1 1 0 011 1v1.3"/>
                          <path d="M11.8 4.5l-.55 8.6a1 1 0 01-1 .9H5.75a1 1 0 01-1-.9L4.2 4.5"/>
                          <path d="M6.6 7v4M9.4 7v4"/>
                        </svg>
                      </a>
                    </cart-remove-button>
                  </div>

                  <div
                    class="buzzko-item__error cart-item__error"
                    id="Line-item-error-{{ item.index | plus: 1 }}"
                    role="alert"
                    hidden
                  >
                    <small class="cart-item__error-text"></small>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </form>
    {%- endif -%}

    <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
    <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">
      {{ 'accessibility.loading' | t }}
    </p>
  </div>
</cart-items>

<script>
  /* =====================================================
     BuzzKo instant cart: the screen changes the moment a
     button is pressed; Shopify's real answer replaces it
     when it arrives. If Shopify refuses, we roll back.
  ===================================================== */
  (function () {
    if (window.__buzzkoInstantInit) return;
    window.__buzzkoInstantInit = true;

    var undo = [];
    var timer = null;
    var ROOT = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

    /* ---- tiny helpers that remember how to undo themselves ---- */
    function setText(el, text) {
      if (!el || el.textContent === text) return;
      var old = el.textContent;
      undo.push(function () { el.textContent = old; });
      el.textContent = text;
    }
    function setAttr(el, name, value) {
      if (!el) return;
      var had = el.hasAttribute(name), old = el.getAttribute(name);
      undo.push(function () { if (had) el.setAttribute(name, old); else el.removeAttribute(name); });
      el.setAttribute(name, value);
    }
    function setHidden(el, hidden) {
      if (!el) return;
      var old = el.hidden;
      undo.push(function () { el.hidden = old; });
      el.hidden = hidden;
    }
    function setStyle(el, prop, value) {
      if (!el) return;
      var old = el.style[prop];
      undo.push(function () { el.style[prop] = old; });
      el.style[prop] = value;
    }
    function toggleClass(el, cls, on) {
      if (!el) return;
      var had = el.classList.contains(cls);
      undo.push(function () { el.classList.toggle(cls, had); });
      el.classList.toggle(cls, on);
    }

    function rollback() {
      clearTimeout(timer);
      var fns = undo;
      undo = [];
      for (var i = fns.length - 1; i >= 0; i--) { try { fns[i](); } catch (e) {} }
    }
    function settle() {
      clearTimeout(timer);
      undo = [];
    }
    function armTimer() {
      clearTimeout(timer);
      timer = setTimeout(rollback, 8000); // no answer in 8s: put the old numbers back
    }

    /* ---- money ---- */
    function moneyFormat() {
      var el = document.querySelector('[data-buzzko-money-format]');
      var f = (el && el.getAttribute('data-buzzko-money-format')) || 'Rs. {{amount}}';
      return f.replace(/<[^>]*>/g, '');
    }

    function formatMoney(cents, format) {
      var placeholder = /\{\{\s*(\w+)\s*\}\}/;
      function fm(number, precision, thousands, decimal) {
        thousands = thousands || ',';
        decimal = decimal || '.';
        var n = (number / 100).toFixed(precision);
        var parts = n.split('.');
        return parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands) +
               (parts[1] ? decimal + parts[1] : '');
      }
      var m = format.match(placeholder);
      var value;
      switch (m && m[1]) {
        case 'amount_no_decimals': value = fm(cents, 0); break;
        case 'amount_with_comma_separator': value = fm(cents, 2, '.', ','); break;
        case 'amount_no_decimals_with_comma_separator': value = fm(cents, 0, '.', ','); break;
        case 'amount_with_apostrophe_separator': value = fm(cents, 2, "'", '.'); break;
        default: value = fm(cents, 2);
      }
      return format.replace(placeholder, value);
    }
    window.__buzzkoFormatMoney = formatMoney;

    /* ---- header bag number ---- */
    function updateBag(n) {
      var b = document.querySelector('#cart-icon-bubble .cart-count-bubble');
      if (!b) return;
      setText(b.querySelector('[aria-hidden="true"]'), String(n));
    }

    /* ---- footer: subtotal, discount preview, offer bar, total ---- */
    function applyDelta(dCents, dCount) {
      var totalEl = document.querySelector('[data-buzzko-total]');
      if (!totalEl) return;

      var fmt = moneyFormat();
      var offerEl = document.querySelector('[data-buzzko-offer]');
      var subEl = document.querySelector('[data-buzzko-subtotal]');
      var summary = totalEl.closest('.buzzko-summary');

      var S = parseInt(totalEl.getAttribute('data-total-cents'), 10) || 0;
      var F = parseInt(totalEl.getAttribute('data-total-final-cents'), 10);
      if (isNaN(F)) F = S;
      var newS = Math.max(0, S + dCents);

      var has10 = !!summary && summary.classList.contains('buzzko-has-buzzko10');
      var hasOther = !!summary && summary.classList.contains('buzzko-has-other-code');
      var threshold = offerEl ? (parseInt(offerEl.getAttribute('data-threshold'), 10) || 0) : 0;
      var pct = offerEl ? (parseInt(offerEl.getAttribute('data-percent'), 10) || 0) : 0;

      var previewOn = threshold > 0 && !has10 && !hasOther && newS >= threshold;
      var newF;
      if (previewOn) newF = newS - Math.floor(newS * pct / 100);
      else if ((has10 || hasOther) && S > 0) newF = Math.round(newS * F / S);
      else newF = newS;

      setAttr(totalEl, 'data-total-cents', String(newS));
      setAttr(totalEl, 'data-total-final-cents', String(newF));
      setText(totalEl, formatMoney(newF, fmt));
      setText(subEl, formatMoney(newS, fmt));

      var label = document.querySelector('[data-buzzko-subtotal-label]');
      if (label) {
        var n = Math.max(0, (parseInt(label.getAttribute('data-item-count'), 10) || 0) + dCount);
        setAttr(label, 'data-item-count', String(n));
        setText(label, 'Subtotal (' + n + ' ' + (n === 1 ? 'item' : 'items') + ')');
        updateBag(n);
      }

      var row = document.querySelector('[data-buzzko-discount-row]');
      if (row) {
        setHidden(row, !previewOn);
        setText(row.querySelector('[data-buzzko-discount-amount]'),
                '-' + formatMoney(Math.floor(newS * pct / 100), fmt));
      }

      if (offerEl && threshold > 0) {
        var unlocked = newS >= threshold;
        setStyle(offerEl.querySelector('[data-buzzko-offer-fill]'), 'width',
                 Math.min(100, newS * 100 / threshold) + '%');
        toggleClass(offerEl, 'buzzko-offer--unlocked', unlocked);
        setText(offerEl.querySelector('[data-buzzko-offer-label]'),
                unlocked
                  ? pct + '% off unlocked and auto applied!'
                  : 'Add ' + formatMoney(threshold - newS, fmt) + ' more to unlock ' + pct + '% off!');
      }
    }

    /* ---- one line item ---- */
    function readLine(item) {
      return {
        qty: parseInt(item.getAttribute('data-qty'), 10) || 0,
        cents: parseInt(item.getAttribute('data-line-cents'), 10) || 0,
        unitFinal: parseInt(item.getAttribute('data-unit-final'), 10) || 0,
        unitOriginal: parseInt(item.getAttribute('data-unit-original'), 10) || 0
      };
    }

    function clearErrors() {
      document.querySelectorAll('.cart-item__error-text').forEach(function (e) { e.textContent = ''; });
    }

    function updateLine(item, newQty) {
      var L = readLine(item);
      var fmt = moneyFormat();
      var newLine = L.unitFinal * newQty;

      var price = item.querySelector('.buzzko-item__price');
      if (price) {
        setText(price.querySelector('span'), formatMoney(newLine, fmt));
        var s = price.querySelector('s');
        if (s) {
          var cmp = s.getAttribute('data-compare-unit');
          var unit = cmp !== null ? (parseInt(cmp, 10) || 0) : L.unitOriginal;
          setText(s, formatMoney(unit * newQty, fmt));
        }
      }
      setHidden(item.querySelector('[data-buzzko-each]'), newQty <= 1);
      var qIn = item.querySelector('.quantity__input');
      if (qIn) {
        var lo = parseInt(qIn.getAttribute('min'), 10);
        var hi = parseInt(qIn.getAttribute('max'), 10);
        var bMinus = item.querySelector('.quantity__button[name="minus"]');
        var bPlus = item.querySelector('.quantity__button[name="plus"]');
        if (bMinus && !isNaN(lo)) toggleClass(bMinus, 'disabled', newQty <= lo);
        if (bPlus && !isNaN(hi)) toggleClass(bPlus, 'disabled', newQty >= hi);
      }
      setAttr(item, 'data-qty', String(newQty));
      setAttr(item, 'data-line-cents', String(newLine));

      applyDelta(newLine - L.cents, newQty - L.qty);
    }

    function removeLine(item) {
      var L = readLine(item);
      setStyle(item, 'display', 'none');
      setAttr(item, 'data-qty', '0');
      setAttr(item, 'data-line-cents', '0');
      applyDelta(-L.cents, -L.qty);
    }

    /* + / − / typed quantity (Dawn already updates the number itself) */
    document.addEventListener('change', function (e) {
      try {
        var input = e.target;
        if (!input.matches || !input.matches('.buzzko-item .quantity__input')) return;
        if (input.checkValidity && !input.checkValidity()) return;
        var item = input.closest('.buzzko-item');
        var q = parseInt(input.value, 10);
        if (!item || isNaN(q) || q < 0) return;

        clearErrors();
        armTimer();
        if (q === 0) removeLine(item); else updateLine(item, q);
      } catch (err) {
        rollback(); // any surprise: skip the instant update, Dawn still does the real one
      }
    });

    /* A greyed-out + / − was pressed: say why, briefly */
    function flashNote(item, msg) {
      var t = item.querySelector('.cart-item__error-text');
      if (!t) return;
      t.__buzzkoMsg = msg; // our own note, not a Shopify error
      t.textContent = msg;
      clearTimeout(t.__buzzkoNote);
      t.__buzzkoNote = setTimeout(function () { if (t.textContent === msg) t.textContent = ''; }, 2500);
    }

    document.addEventListener('click', function (e) {
      try {
        var btn = e.target.closest && e.target.closest('.buzzko-item .quantity__button.disabled');
        if (!btn) return;
        var item = btn.closest('.buzzko-item');
        var input = item && item.querySelector('.quantity__input');
        if (!input) return;
        flashNote(item, btn.getAttribute('name') === 'minus'
          ? 'Minimum quantity is ' + (input.getAttribute('min') || 1) + '. Use the bin to remove.'
          : 'Only ' + input.getAttribute('max') + ' available.');
      } catch (err) {}
    });

    /* trash can: hide the line at once */
    document.addEventListener('click', function (e) {
      try {
        var trash = e.target.closest && e.target.closest('.buzzko-item__trash');
        if (!trash) return;
        var item = trash.closest('.buzzko-item');
        if (!item || item.style.display === 'none') return;

        window.__buzzkoLastClickedLineKey = item.getAttribute('data-line-key');
        clearErrors();
        armTimer();
        removeLine(item);
      } catch (err) {
        rollback();
      }
    }, true);

    /* ---- stock limits learned from Shopify itself ---- */
    function limitKey(input) {
      var id = input && input.getAttribute('data-quantity-variant-id');
      return id ? 'buzzko_max_' + id : null;
    }
    function rememberLimit(input, limit) {
      var k = limitKey(input);
      if (!k) return;
      try { sessionStorage.setItem(k, String(limit)); } catch (e) {}
    }
    function setPlusState(item, qty, max) {
      var plus = item.querySelector('.quantity__button[name="plus"]');
      if (plus && !isNaN(max)) plus.classList.toggle('disabled', qty >= max);
    }
    // Put a learned limit on every quantity box that has none, so + stops there
    function applyLearnedLimits() {
      document.querySelectorAll('.buzzko-item .quantity__input').forEach(function (input) {
        if (input.hasAttribute('max')) return;
        var k = limitKey(input), v = null;
        if (!k) return;
        try { v = sessionStorage.getItem(k); } catch (e) {}
        var max = parseInt(v, 10);
        if (isNaN(max) || max < 1) return;
        input.setAttribute('max', String(max));
        var item = input.closest('.buzzko-item');
        if (item) setPlusState(item, parseInt(input.value, 10) || 0, max);
      });
    }

    // After a stock error: ask Shopify what is really in the cart and show that,
    // instead of snapping back to where the spamming started
    function resync(errEl) {
      try {
        var item = errEl.closest('.buzzko-item');
        if (!item) return;
        var key = item.getAttribute('data-line-key');
        var input = item.querySelector('.quantity__input');
        var m = errEl.textContent.match(/\d+/);
        var limit = m ? parseInt(m[0], 10) : NaN;

        fetch(ROOT + 'cart.js', { headers: { 'Accept': 'application/json' } })
          .then(function (res) { return res.json(); })
          .then(function (cart) {
            var line = (cart.items || []).filter(function (i) { return i.key === key; })[0];
            if (!line || !input) return;

            if (!isNaN(limit) && limit >= line.quantity && limit > 0) {
              input.setAttribute('max', String(limit));
              rememberLimit(input, limit);
            }
            var current = parseInt(item.getAttribute('data-qty'), 10) || 0;
            if (line.quantity !== current) updateLine(item, line.quantity);
            undo = [];
            input.value = line.quantity;
            var max = parseInt(input.getAttribute('max'), 10);
            setPlusState(item, line.quantity, max);
          })
          .catch(function () {});
      } catch (err) {}
    }

    // Stock error that names a limit ("Only 50 ..."): go straight to that limit,
    // no stop at the old number on the way, then let Shopify confirm in the background.
    // Any other error: put the old numbers back, then show what Shopify really has.
    function handleError(errEl) {
      clearTimeout(timer);
      var item = errEl.closest('.buzzko-item');
      var m = errEl.textContent.match(/\d+/);
      var n = m ? parseInt(m[0], 10) : NaN;
      var shown = item ? (parseInt(item.getAttribute('data-qty'), 10) || 0) : 0;
      var input = item && item.querySelector('.quantity__input');

      if (item && input && !isNaN(n) && n > 0 && n < shown) {
        input.setAttribute('max', String(n));
        rememberLimit(input, n);
        updateLine(item, n);
        input.value = n;
        setPlusState(item, n, n);
      } else {
        rollback();
      }
      resync(errEl);
    }

    /* Shopify said no (out of stock, limit, network): put the old numbers back */
    function watchErrors() {
      var host = document.querySelector('cart-items');
      if (!host || !window.MutationObserver) return;
      new MutationObserver(function () {
        if (!undo.length) return;
        var errs = host.querySelectorAll('.cart-item__error-text');
        for (var i = 0; i < errs.length; i++) {
          var txt = errs[i].textContent.trim();
          if (txt && txt !== errs[i].__buzzkoMsg) { handleError(errs[i]); return; }
        }
      }).observe(host, { childList: true, subtree: true, characterData: true });
    }

    /* Shopify said yes: its real numbers are already on screen, forget the undo list */
    function hook() {
      watchErrors();
      applyLearnedLimits();
      if (typeof subscribe === 'function' && window.PUB_SUB_EVENTS) {
        subscribe(PUB_SUB_EVENTS.cartUpdate, function () { settle(); applyLearnedLimits(); });
      }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', hook);
    else hook();
  })();


  // Reload immediately when the cart hits 0
  (function watchEmptyCart() {
    var cartItems = document.querySelector('cart-items');
    if (!cartItems) return;
    
    var observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(mutation) {
        if (mutation.attributeName === 'class') {
          // ONLY reload if 'is-empty' was just ADDED.
          // This prevents the infinite loop when 'buzzko-first-paint' is removed.
          var wasEmpty = mutation.oldValue && mutation.oldValue.includes('is-empty');
          var isEmpty = cartItems.classList.contains('is-empty');
          
          if (isEmpty && !wasEmpty) {
            window.location.reload();
          }
        }
      });
    });
    
    observer.observe(cartItems, { 
      attributes: true, 
      attributeOldValue: true, 
      attributeFilter: ['class'] 
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ]
}
{% endschema %}