{% comment %}
  BuzzKo — Benefits Bento
  4-column bento grid with animated isometric SVG icons.
  Each tile has a size (Small / Wide / Large), color, and icon choice.
{% endcomment %}

{%- comment -%}
  ================================================================
  ICON LIBRARY v2 — isometric illustrations with per-element classes
  so we can animate specific parts on hover.

  Rules every icon follows:
  - true 2:1 isometric angles (2px across per 1px down)
  - light from top-left: top = lightest, left = mid, right = darkest
  - one stroke weight (2px outlines, 1.3-1.5px for small details)
  - soft ground shadow, so icons sit on the tile instead of floating
  ================================================================
{%- endcomment -%}


{%- comment -%} ============ TRUCK ============ {%- endcomment -%}
{%- capture buzzko_icon_truck -%}
  <svg viewBox="0 0 100 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <g class="bzi-truck">
      <!-- Drawn facing the lower-right. Built once, then mirrored. -->
      <g transform="translate(100 0) scale(-1 1)" stroke="#1A1A1A" stroke-linejoin="round" stroke-linecap="round">

        <!-- Ground shadow -->
        <polygon points="30,73 18,67 70,41 82,47" fill="rgba(26,26,26,0.12)" stroke="none"/>

        <!-- CARGO BOX -->
        <path d="M36 29 L48 35 L48 59 L36 53 Z" fill="#FFE680" stroke-width="2"/>
        <path d="M48 35 L36 29 L70 12 L82 18 Z" fill="#FFF1B8" stroke-width="2"/>
        <path d="M48 35 L82 18 L82 42 L48 59 Z" fill="#FFD93D" stroke-width="2"/>
        <!-- Heart sticker on the side, projected onto the side plane -->
        <g transform="matrix(0.894 -0.447 0 1 65 38.5)">
          <path d="M0 6 C -9 0 -8 -8 -3.5 -7.5 C -1.5 -7.2 0 -5.5 0 -4.5 C 0 -5.5 1.5 -7.2 3.5 -7.5 C 8 -8 9 0 0 6 Z"
                fill="#FF60B9" stroke-width="1.6"/>
        </g>

        <!-- CAB -->
        <path d="M18 44 L30 50 L30 68 L18 62 Z" fill="#BEE3F8" stroke-width="2"/>
        <path d="M30 50 L48 41 L48 59 L30 68 Z" fill="#29A8E0" stroke-width="2"/>
        <path d="M30 50 L18 44 L36 35 L48 41 Z" fill="#D6EEFA" stroke-width="2"/>
        <!-- Windshield -->
        <path d="M20.5 46.5 L28 50.2 L28 57 L20.5 53.3 Z" fill="#29A8E0" stroke-width="1.5"/>
        <!-- Side window + glint + handle -->
        <path d="M32 52 L42 47 L42 53 L32 58 Z" fill="#D6EEFA" stroke-width="1.5"/>
        <path d="M34 55 L37 53.5" stroke="#fff" stroke-width="1.5"/>
        <path d="M43.5 55 L46 53.8" stroke-width="1.5"/>
        <!-- Headlights -->
        <path d="M19.5 59 L22.5 60.5 L22.5 63 L19.5 61.5 Z" fill="#FFD93D" stroke-width="1.2"/>
        <path d="M25.5 61.5 L28.5 63 L28.5 65.5 L25.5 64 Z" fill="#FFD93D" stroke-width="1.2"/>

        <!-- WHEELS (circles squashed onto the side plane) -->
        <!-- front -->
        <g transform="matrix(0.894 -0.447 0 1 37.4 61.7)"><circle r="6" fill="#1A1A1A" stroke="none"/></g>
        <g transform="matrix(0.894 -0.447 0 1 39 62.5)">
          <circle r="6" fill="#2B2B2B" stroke-width="1.5"/>
          <circle r="2.8" fill="#fff" stroke-width="1.2"/>
        </g>
        <!-- rear -->
        <g transform="matrix(0.894 -0.447 0 1 70.4 45.7)"><circle r="6" fill="#1A1A1A" stroke="none"/></g>
        <g transform="matrix(0.894 -0.447 0 1 72 46.5)">
          <circle r="6" fill="#2B2B2B" stroke-width="1.5"/>
          <circle r="2.8" fill="#fff" stroke-width="1.2"/>
        </g>
      </g>
    </g>

    <!-- Speed lines trailing behind, revealed on hover -->

    <g class="bzi-truck-smoke" opacity="0" stroke="#1A1A1A" stroke-width="2.5" stroke-linecap="round">
      <path d="M 26 52 L 19 48.5"/>
      <path d="M 15 46.5 L 8 43"/>
      <path d="M 4 41.5 L 0 39.5"/>
    </g>
  </svg>
{%- endcapture -%}


{%- comment -%} ============ GIFT ============ {%- endcomment -%}
{%- capture buzzko_icon_gift -%}
  <svg viewBox="0 0 100 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <g stroke="#1A1A1A" stroke-linejoin="round" stroke-linecap="round">

      <!-- Ground shadow -->
      <ellipse cx="50" cy="64" rx="31" ry="10" fill="rgba(26,26,26,0.12)" stroke="none"/>

      <!-- BOX BODY -->
      <!-- inside of the box, only seen when the lid lifts -->
      <path d="M50 52 L26 40 L50 28 L74 40 Z" fill="#C93A82" stroke-width="2"/>
      <path d="M26 40 L50 52 L50 72 L26 60 Z" fill="#F8B5D1" stroke-width="2"/>
      <path d="M50 52 L74 40 L74 60 L50 72 Z" fill="#FF60B9" stroke-width="2"/>
      <!-- ribbon on body -->
      <path d="M35 44.5 L41 47.5 L41 67.5 L35 64.5 Z" fill="#FFD93D" stroke-width="1.5"/>
      <path d="M59 47.5 L65 44.5 L65 64.5 L59 67.5 Z" fill="#F2B705" stroke-width="1.5"/>

      <!-- LID (lifts on hover) -->
      <g class="bzi-gift-lid">
        <path d="M23 32.5 L50 46 L50 54 L23 40.5 Z" fill="#F8B5D1" stroke-width="2"/>
        <path d="M50 46 L77 32.5 L77 40.5 L50 54 Z" fill="#FF60B9" stroke-width="2"/>
        <path d="M50 46 L23 32.5 L50 19 L77 32.5 Z" fill="#FFDCEF" stroke-width="2"/>

        <!-- ribbon bands over the lid sides -->
        <path d="M35 38.5 L41 41.5 L41 49.5 L35 46.5 Z" fill="#FFD93D" stroke-width="1.5"/>
        <path d="M59 41.5 L65 38.5 L65 46.5 L59 49.5 Z" fill="#F2B705" stroke-width="1.5"/>
        <!-- ribbon bands crossing the lid top -->
        <path d="M35 38.5 L41 41.5 L68 28 L62 25 Z" fill="#FFE680" stroke-width="1.5"/>
        <path d="M59 41.5 L65 38.5 L38 25 L32 28 Z" fill="#FFE680" stroke-width="1.5"/>
        <!-- hides the doubled lines where the bands cross -->
        <path d="M50 31 L56 34 L50 37 L44 34 Z" fill="#FFE680" stroke="none"/>

        <!-- bow -->
        <path d="M49 31 C 44 19 30 17 32.5 26.5 C 34 32 43 33.5 49 33 Z" fill="#FFD93D" stroke-width="1.6"/>
        <path d="M51 31 C 56 19 70 17 67.5 26.5 C 66 32 57 33.5 51 33 Z" fill="#FFD93D" stroke-width="1.6"/>
        <path d="M49 31 C 45 24 38 22 36.5 26" stroke-width="1.2" fill="none"/>
        <path d="M51 31 C 55 24 62 22 63.5 26" stroke-width="1.2" fill="none"/>
        <ellipse cx="50" cy="32" rx="4.2" ry="3.4" fill="#F2B705" stroke-width="1.6"/>
      </g>
    </g>

    <!-- Sparkles that pop when the lid lifts -->
    <g class="bzi-gift-sparkles" opacity="0" stroke="#1A1A1A" stroke-width="1.2" stroke-linejoin="round">
      <path d="M88 16 Q88.8 21.2 94 22 Q88.8 22.8 88 28 Q87.2 22.8 82 22 Q87.2 21.2 88 16 Z" fill="#FFD93D"/>
      <path d="M12 12 Q12.7 16.3 17 17 Q12.7 17.7 12 22 Q11.3 17.7 7 17 Q11.3 16.3 12 12 Z" fill="#B9E404"/>
    </g>
  </svg>
{%- endcapture -%}


{%- comment -%} ============ HEART ============ {%- endcomment -%}
{%- capture buzzko_icon_heart -%}
  <svg viewBox="0 0 100 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <g class="bzi-heart" stroke="#1A1A1A" stroke-linejoin="round" stroke-linecap="round">

      <!-- Ground shadow -->
      <ellipse cx="50" cy="73" rx="26" ry="4" fill="rgba(26,26,26,0.12)" stroke="none"/>

      <!-- Thickness: back copy (outlined), then a middle copy to fill the gap -->
      <path transform="translate(0 8)"
            d="M50 58 C 28 44 16 34 16 22 C 16 12 24 6 33 6 C 40 6 46 10 50 16 C 54 10 60 6 67 6 C 76 6 84 12 84 22 C 84 34 72 44 50 58 Z"
            fill="#C93A82" stroke-width="2.5"/>
      <path transform="translate(0 4)"
            d="M50 58 C 28 44 16 34 16 22 C 16 12 24 6 33 6 C 40 6 46 10 50 16 C 54 10 60 6 67 6 C 76 6 84 12 84 22 C 84 34 72 44 50 58 Z"
            fill="#C93A82" stroke="none"/>

      <!-- Front face -->
      <path d="M50 58 C 28 44 16 34 16 22 C 16 12 24 6 33 6 C 40 6 46 10 50 16 C 54 10 60 6 67 6 C 76 6 84 12 84 22 C 84 34 72 44 50 58 Z"
            fill="#FF60B9" stroke-width="2.5"/>

      <!-- Gloss -->
      <path d="M25 22 C 25 15 29 12 34 12" stroke="#FFDCEF" stroke-width="3.2" fill="none"/>
      <circle cx="25" cy="29" r="1.8" fill="#FFDCEF" stroke="none"/>

      <!-- Sparkle -->
      <path d="M90 4 Q90.8 9.2 96 10 Q90.8 10.8 90 16 Q89.2 10.8 84 10 Q89.2 9.2 90 4 Z"
            fill="#FFD93D" stroke-width="1.3"/>
    </g>
  </svg>
{%- endcapture -%}


{%- comment -%} ============ SPARKLE (faceted star) ============ {%- endcomment -%}
{%- capture buzzko_icon_sparkle -%}
  <svg viewBox="0 0 100 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <g class="bzi-sparkle" stroke-linejoin="round" stroke-linecap="round">

      <!-- Eight facets, lit from the top-left -->
      <g stroke="#1A1A1A" stroke-width="1.3">
        <path d="M50 6 L39 29 L50 40 Z"   fill="#FFF1B8"/>
        <path d="M50 6 L61 29 L50 40 Z"   fill="#FFD93D"/>
        <path d="M86 40 L61 29 L50 40 Z"  fill="#FFD93D"/>
        <path d="M86 40 L61 51 L50 40 Z"  fill="#F2B705"/>
        <path d="M50 74 L61 51 L50 40 Z"  fill="#E5A800"/>
        <path d="M50 74 L39 51 L50 40 Z"  fill="#F2B705"/>
        <path d="M14 40 L39 51 L50 40 Z"  fill="#F7C920"/>
        <path d="M14 40 L39 29 L50 40 Z"  fill="#FFE680"/>
      </g>

      <!-- Outer outline on top of the facets -->
      <path d="M50 6 L61 29 L86 40 L61 51 L50 74 L39 51 L14 40 L39 29 Z"
            stroke="#1A1A1A" stroke-width="2.5"/>

      <!-- Accent sparkles -->
      <path d="M18 7 Q18.6 11.4 23 12 Q18.6 12.6 18 17 Q17.4 12.6 13 12 Q17.4 11.4 18 7 Z"
            fill="#FF60B9" stroke="#1A1A1A" stroke-width="1.3"/>
      <path d="M86 60 Q86.6 64.4 91 65 Q86.6 65.6 86 70 Q85.4 65.6 81 65 Q85.4 64.4 86 60 Z"
            fill="#B9E404" stroke="#1A1A1A" stroke-width="1.3"/>
    </g>
  </svg>
{%- endcapture -%}


{%- comment -%} ============ SHIELD ============ {%- endcomment -%}
{%- capture buzzko_icon_shield -%}
  <svg viewBox="0 0 100 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <g class="bzi-shield" stroke="#1A1A1A" stroke-linejoin="round" stroke-linecap="round">

      <!-- Ground shadow -->
      <ellipse cx="50" cy="75" rx="24" ry="3" fill="rgba(26,26,26,0.12)" stroke="none"/>

      <!-- Thickness (extruded toward the lower right) -->
      <path transform="translate(6 6)"
            d="M46 6 L76 17 L76 36 C 76 52 63 62 46 68 C 29 62 16 52 16 36 L16 17 Z"
            fill="#1E8DBF" stroke-width="2.5"/>
      <path transform="translate(3 3)"
            d="M46 6 L76 17 L76 36 C 76 52 63 62 46 68 C 29 62 16 52 16 36 L16 17 Z"
            fill="#1E8DBF" stroke="none"/>

      <!-- Front face -->
      <path d="M46 6 L76 17 L76 36 C 76 52 63 62 46 68 C 29 62 16 52 16 36 L16 17 Z"
            fill="#BEE3F8" stroke-width="2.5"/>

      <!-- Inner bevel -->
      <path d="M46 14 L69 22.5 L69 36 C 69 47 59 55 46 60 C 33 55 23 47 23 36 L23 22.5 Z"
            fill="#D6EEFA" stroke-width="1.5"/>

      <!-- Sticker-style check -->
      <path d="M35 36 L43 44.5 L58 27" stroke="#1A1A1A" stroke-width="8.5" fill="none"/>
      <path d="M35 36 L43 44.5 L58 27" stroke="#B9E404" stroke-width="4.5" fill="none"/>
    </g>
  </svg>
{%- endcapture -%}


{%- comment -%} ============ RETURN ============ {%- endcomment -%}
{%- capture buzzko_icon_return -%}
  <svg viewBox="0 0 100 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <g stroke="#1A1A1A" stroke-linejoin="round" stroke-linecap="round">

      <!-- Ground shadow -->
      <ellipse cx="50" cy="62" rx="29" ry="9" fill="rgba(26,26,26,0.12)" stroke="none"/>

      <!-- Box -->
      <path d="M28 43 L50 54 L50 70 L28 59 Z" fill="#B9E404" stroke-width="2"/>
      <path d="M50 54 L72 43 L72 59 L50 70 Z" fill="#8FBE00" stroke-width="2"/>
      <path d="M50 54 L28 43 L50 32 L72 43 Z" fill="#D0F4DE" stroke-width="2"/>

      <!-- Tape over the top and down the front-left face -->
      <path d="M35 56 L43 60 L43 50.5 L35 46.5 Z" fill="#F8B5D1" stroke-width="1.3"/>
      <path d="M35 46.5 L43 50.5 L65 39.5 L57 35.5 Z" fill="#FFDCEF" stroke-width="1.3"/>

      <!-- Shipping label on the right face -->
      <path d="M56 54 L66 49 L66 55 L56 60 Z" fill="#fff" stroke-width="1.2"/>
      <path d="M58 57 L64 54" stroke-width="1"/>
    </g>

    <!-- Return arrow (outlined sticker style) -->
    <g class="bzi-return-arrow" stroke-linecap="round" stroke-linejoin="round" fill="none">
      <path d="M78 36 C 78 6 22 6 22 30" stroke="#1A1A1A" stroke-width="7.5"/>
      <path d="M14.5 24 L22 32.5 L29.5 24" stroke="#1A1A1A" stroke-width="7.5"/>
      <path d="M78 36 C 78 6 22 6 22 30" stroke="#fff" stroke-width="3.5"/>
      <path d="M14.5 24 L22 32.5 L29.5 24" stroke="#fff" stroke-width="3.5"/>
    </g>
  </svg>
{%- endcapture -%}

<section
  id="BuzzkoBenefits-{{ section.id }}"
  class="buzzko-benefits"
>
  <div class="buzzko-benefits__container">

    {% if section.settings.heading != blank %}
      <div class="buzzko-benefits__header">
        <h2 class="buzzko-benefits__heading">
          {{ section.settings.heading | remove: '✦' | strip }}
          <span class="buzzko-benefits__sparkle">✦</span>
        </h2>
      </div>
    {% endif %}

    <div class="buzzko-benefits__grid">

      {% for block in section.blocks %}

        {%- liquid
          case block.settings.icon
            when 'truck'
              assign icon_svg = buzzko_icon_truck
            when 'gift'
              assign icon_svg = buzzko_icon_gift
            when 'heart'
              assign icon_svg = buzzko_icon_heart
            when 'sparkle'
              assign icon_svg = buzzko_icon_sparkle
            when 'shield'
              assign icon_svg = buzzko_icon_shield
            when 'return'
              assign icon_svg = buzzko_icon_return
            else
              assign icon_svg = buzzko_icon_sparkle
          endcase
        -%}

        {%- capture tile_style -%}
          --tile-bg: {{ block.settings.background_color | default: '#F8B5D1' }};
        {%- endcapture -%}

        <div
          class="bz-tile bz-tile--{{ block.settings.size }}"
          style="{{ tile_style | strip_newlines }}"
          {{ block.shopify_attributes }}
        >
          <div class="bz-tile__icon">
            {{ icon_svg }}
          </div>

          <div class="bz-tile__content">
            {% if block.settings.title != blank %}
              <h3 class="bz-tile__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.subtitle != blank %}
              <p class="bz-tile__subtitle">{{ block.settings.subtitle }}</p>
            {% endif %}
          </div>
        </div>

      {% endfor %}

    </div>

  </div>
</section>


<style>

  #BuzzkoBenefits-{{ section.id }} {
    background: #FFFAF5;
    width: 100%;

    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #BuzzkoBenefits-{{ section.id }} .buzzko-benefits__container {
    width: min(1400px, calc(100% - 64px));
    margin: 0 auto;
  }


  /* ---------- Header ---------- */

  #BuzzkoBenefits-{{ section.id }} .buzzko-benefits__header {
    margin-bottom: 32px;
  }

  #BuzzkoBenefits-{{ section.id }} .buzzko-benefits__heading {
    margin: 0;
    color: #111;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  #BuzzkoBenefits-{{ section.id }} .buzzko-benefits__sparkle {
    display: inline-block;
    margin-left: 8px;
    font-size: 0.8em;
    font-weight: 400;
    vertical-align: middle;
  }


  /* ---------- Bento grid ---------- */

  #BuzzkoBenefits-{{ section.id }} .buzzko-benefits__grid {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(170px, auto);
    grid-auto-flow: dense;

    gap: 16px;
  }


  /* ---------- Tile base ---------- */

  #BuzzkoBenefits-{{ section.id }} .bz-tile {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;

    padding: 26px 24px 24px;

    background: var(--tile-bg, #F8B5D1);
    border-radius: 22px;

    min-width: 0;

    transition: transform 220ms cubic-bezier(0.3, 1.2, 0.5, 1),
                box-shadow 220ms ease;
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile:hover,
  #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview {
    transform: translateY(-4px);
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.09);
  }

  /* Size variants */
  #BuzzkoBenefits-{{ section.id }} .bz-tile--small {
    grid-column: span 1;
    grid-row: span 1;
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile--wide {
    grid-column: span 2;
    grid-row: span 1;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 22px;
    padding: 26px 28px;
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile--large {
    grid-column: span 2;
    grid-row: span 2;
    padding: 32px 30px 30px;
  }


  /* ---------- Icon wrapper ---------- */

  #BuzzkoBenefits-{{ section.id }} .bz-tile__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    max-width: 140px;

    margin: 0 auto;
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile--wide .bz-tile__icon {
    width: 84px;
    max-width: 84px;
    margin: 0;
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile--large .bz-tile__icon {
    max-width: 220px;
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile__icon svg {
    width: 100%;
    height: auto;
    display: block;
  }


  /* ---------- Tile text ---------- */

  #BuzzkoBenefits-{{ section.id }} .bz-tile__content {
    min-width: 0;
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile__title {
    margin: 0;
    color: #1A1A1A;
    font-size: 16px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile--large .bz-tile__title {
    font-size: 22px;
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile__subtitle {
    margin: 4px 0 0;
    color: rgba(26, 26, 26, 0.72);
    font-size: 13px;
    line-height: 1.4;
    font-weight: 500;
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile--large .bz-tile__subtitle {
    font-size: 15px;
  }


  /* =====================================================
     ICON ANIMATIONS
     Triggered by :hover on pointer devices, and by the
     .bz-inview class on touch devices (set via JS below).
     ===================================================== */

  /* Truck — drives forward with a springy overshoot,
     speed lines trail behind one after another */

  #BuzzkoBenefits-{{ section.id }} .bzi-truck {
    transform-origin: center;
    /* Strong overshoot — the truck goes a bit too far, then settles back.
       Feels like it has momentum and suspension. */
    transition: transform 680ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile:hover .bzi-truck,
  #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview .bzi-truck {
    transform: translate(14px, 7px);
  }

  /* Speed lines — each one fades in and slides left on its own delay,
     creating a swoosh trail behind the truck */

  #BuzzkoBenefits-{{ section.id }} .bzi-truck-smoke {
    transition: opacity 220ms ease 100ms;
  }

  /* Each dash slides further back-left along the ground line (2:1 ratio,
     opposite the truck's forward motion). Staggered delays make them
     stream out one after another like the truck is pulling away from them. */
  #BuzzkoBenefits-{{ section.id }} .bzi-truck-smoke path {
    transform-origin: center;
    transform: translate(0, 0);
    transition: transform 620ms cubic-bezier(0.22, 1.2, 0.5, 1);
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile:hover .bzi-truck-smoke,
  #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview .bzi-truck-smoke {
    opacity: 1;
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile:hover .bzi-truck-smoke path,
  #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview .bzi-truck-smoke path {
    transform: translate(-12px, -6px);
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile:hover .bzi-truck-smoke path:nth-child(1),
  #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview .bzi-truck-smoke path:nth-child(1) {
    transition-delay: 100ms;
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile:hover .bzi-truck-smoke path:nth-child(2),
  #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview .bzi-truck-smoke path:nth-child(2) {
    transition-delay: 180ms;
  }

  #BuzzkoBenefits-{{ section.id }} .bz-tile:hover .bzi-truck-smoke path:nth-child(3),
  #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview .bzi-truck-smoke path:nth-child(3) {
    transition-delay: 260ms;
  }

  /* Gift — lid lifts, sparkles pop */
  #BuzzkoBenefits-{{ section.id }} .bzi-gift-lid {
    transform-origin: center bottom;
    transition: transform 460ms cubic-bezier(0.34, 1.5, 0.5, 1);
  }
  #BuzzkoBenefits-{{ section.id }} .bz-tile:hover .bzi-gift-lid,
  #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview .bzi-gift-lid {
    transform: translateY(-10px) rotate(-5deg);
  }
  #BuzzkoBenefits-{{ section.id }} .bzi-gift-sparkles {
    transform-origin: center 40%;
    transition: opacity 280ms ease 180ms, transform 440ms cubic-bezier(0.34, 1.5, 0.5, 1) 180ms;
    transform: scale(0.4);
  }
  #BuzzkoBenefits-{{ section.id }} .bz-tile:hover .bzi-gift-sparkles,
  #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview .bzi-gift-sparkles {
    opacity: 1;
    transform: scale(1);
  }

  /* Heart — beat */
  #BuzzkoBenefits-{{ section.id }} .bzi-heart {
    transform-origin: 50% 55%;
  }
  #BuzzkoBenefits-{{ section.id }} .bz-tile:hover .bzi-heart,
  #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview .bzi-heart {
    animation: bzHeartBeat 720ms ease-in-out;
  }
  @keyframes bzHeartBeat {
    0%   { transform: scale(1); }
    20%  { transform: scale(1.14); }
    40%  { transform: scale(1); }
    60%  { transform: scale(1.09); }
    100% { transform: scale(1); }
  }

  /* Sparkle — rotate + glow */
  #BuzzkoBenefits-{{ section.id }} .bzi-sparkle {
    transform-origin: 50% 50%;
    transition: transform 700ms cubic-bezier(0.34, 1.2, 0.5, 1);
  }
  #BuzzkoBenefits-{{ section.id }} .bz-tile:hover .bzi-sparkle,
  #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview .bzi-sparkle {
    transform: rotate(180deg) scale(1.06);
  }

  /* Shield — pop */
  #BuzzkoBenefits-{{ section.id }} .bzi-shield {
    transform-origin: 50% 50%;
    transition: transform 420ms cubic-bezier(0.34, 1.5, 0.5, 1);
  }
  #BuzzkoBenefits-{{ section.id }} .bz-tile:hover .bzi-shield,
  #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview .bzi-shield {
    transform: scale(1.1);
  }

  /* Return — arrow swings around the arc's centre */
  #BuzzkoBenefits-{{ section.id }} .bzi-return-arrow {
    transform-origin: 50% 40%;
    transition: transform 560ms cubic-bezier(0.34, 1.4, 0.5, 1);
  }
  #BuzzkoBenefits-{{ section.id }} .bz-tile:hover .bzi-return-arrow,
  #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview .bzi-return-arrow {
    transform: rotate(-14deg);
  }


  /* Reduced motion — kill animations but keep layout */

  @media (prefers-reduced-motion: reduce) {
    #BuzzkoBenefits-{{ section.id }} .bz-tile,
    #BuzzkoBenefits-{{ section.id }} .bz-tile * {
      transition: none !important;
      animation: none !important;
    }
  }


  /* =====================================================
     TABLET — 2-column bento
     ===================================================== */

  @media screen and (max-width: 989px) {

    #BuzzkoBenefits-{{ section.id }} .buzzko-benefits__container {
      width: min(100% - 40px, 700px);
    }

    #BuzzkoBenefits-{{ section.id }} .buzzko-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(160px, auto);
      gap: 14px;
    }

    #BuzzkoBenefits-{{ section.id }} .bz-tile--wide,
    #BuzzkoBenefits-{{ section.id }} .bz-tile--large {
      grid-column: span 2;
    }

    #BuzzkoBenefits-{{ section.id }} .bz-tile--large {
      grid-row: span 2;
    }
  }


  /* =====================================================
     MOBILE — horizontal scroll, single row of tiles
     ===================================================== */

  @media screen and (max-width: 749px) {

    #BuzzkoBenefits-{{ section.id }} {
      padding: {{ section.settings.padding_top | times: 0.75 | round }}px 0 {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }

    #BuzzkoBenefits-{{ section.id }} .buzzko-benefits__container {
      width: 100%;
    }

    #BuzzkoBenefits-{{ section.id }} .buzzko-benefits__header {
      width: calc(100% - 28px);
      margin: 0 auto 20px;
    }

    #BuzzkoBenefits-{{ section.id }} .buzzko-benefits__heading {
      font-size: 24px;
    }

    #BuzzkoBenefits-{{ section.id }} .buzzko-benefits__grid {
      display: flex;
      flex-wrap: nowrap;

      overflow-x: auto;
      -webkit-overflow-scrolling: touch;

      gap: 12px;

      padding: 4px 14px 14px;

      scroll-snap-type: x mandatory;
      scroll-padding-inline: 14px;

      scrollbar-width: none;
    }

    #BuzzkoBenefits-{{ section.id }} .buzzko-benefits__grid::-webkit-scrollbar {
      display: none;
    }

    #BuzzkoBenefits-{{ section.id }} .bz-tile,
    #BuzzkoBenefits-{{ section.id }} .bz-tile--small,
    #BuzzkoBenefits-{{ section.id }} .bz-tile--wide,
    #BuzzkoBenefits-{{ section.id }} .bz-tile--large {
      flex: 0 0 72%;

      grid-column: auto;
      grid-row: auto;

      scroll-snap-align: start;

      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;

      padding: 24px 20px 22px;
      border-radius: 20px;
      min-height: 220px;
    }

    #BuzzkoBenefits-{{ section.id }} .bz-tile__icon,
    #BuzzkoBenefits-{{ section.id }} .bz-tile--wide .bz-tile__icon,
    #BuzzkoBenefits-{{ section.id }} .bz-tile--large .bz-tile__icon {
      width: 100%;
      max-width: 130px;
      margin: 0 auto;
    }

    #BuzzkoBenefits-{{ section.id }} .bz-tile__title,
    #BuzzkoBenefits-{{ section.id }} .bz-tile--large .bz-tile__title {
      font-size: 16px;
    }

    #BuzzkoBenefits-{{ section.id }} .bz-tile__subtitle,
    #BuzzkoBenefits-{{ section.id }} .bz-tile--large .bz-tile__subtitle {
      font-size: 13px;
    }

    /* On mobile the tile itself shouldn't jump up while scrolling —
       the icon animations carry the motion. */
    #BuzzkoBenefits-{{ section.id }} .bz-tile.bz-inview {
      transform: none;
      box-shadow: none;
    }

  }

</style>


<script>
  (function () {
    var root = document.getElementById('BuzzkoBenefits-{{ section.id }}');
    if (!root) return;

    var tiles = root.querySelectorAll('.bz-tile');
    if (!tiles.length) return;

    /* Only drive animations from the viewport on devices that can't hover.
       Desktop keeps the pure :hover behaviour — no JS needed there. */
    var touchLike = window.matchMedia('(hover: none), (max-width: 749px)').matches;
    var reduced   = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!touchLike || reduced) return;

    /* No IntersectionObserver? Just show everything at once. */
    if (!('IntersectionObserver' in window)) {
      tiles.forEach(function (t) { t.classList.add('bz-inview'); });
      return;
    }

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        /* toggle() rather than add() so the animation replays
           every time a tile scrolls back into view */
        entry.target.classList.toggle('bz-inview', entry.isIntersecting);
      });
    }, {
      /* Fire when half the tile is visible — feels natural for the
         wide/short tiles and won't miss the tall ones. */
      threshold: 0.5
    });

    tiles.forEach(function (t) { observer.observe(t); });
  })();
</script>


