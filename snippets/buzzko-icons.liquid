    {%- when 4 -%}
      <svg class="bz-svg" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <g class="bz-swap">
          <path class="bz-s" d="M13 31 A19 19 0 0 1 46 17" stroke="#6cc0f5" stroke-width="4.5"/>
          <path class="bz-s" d="M47 6 L47.5 18.5 L35 19" stroke="#6cc0f5" stroke-width="4.5"/>
          <path class="bz-s" d="M51 33 A19 19 0 0 1 18 47" stroke="#ff8fb0" stroke-width="4.5"/>
          <path class="bz-s" d="M17 58 L16.5 45.5 L29 45" stroke="#ff8fb0" stroke-width="4.5"/>
        </g>
        <g class="bz-swap-face">
          <circle class="bz-s" cx="32" cy="32" r="8.5" fill="var(--bz-yellow)"/>
          <circle cx="29" cy="31" r="1.2" fill="var(--bz-ink)"/>
          <circle cx="35" cy="31" r="1.2" fill="var(--bz-ink)"/>
          <path class="bz-s" d="M29.6 34.2 Q32 36.4 34.4 34.2" stroke-width="1.8"/>
        </g>
      </svg>

    {%- when 5 -%}
      <svg class="bz-svg" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <defs>
