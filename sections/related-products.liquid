
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #RelatedProducts-{{ section.id }} {
    --buzzko-pink: #F8B5D1;
    --buzzko-blue: #BEE3F8;
    --buzzko-yellow: #FFECB3;
    --buzzko-mint: #D0F4DE;
    --buzzko-ink: #1A1A1A;
  }

  #RelatedProducts-{{ section.id }} .related-products__heading {
    font-weight: 900;
    letter-spacing: -0.04em;
    margin-bottom: 3rem;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: #faf8f6;
    border: 3px solid var(--buzzko-card-border);
    border-radius: 18px;
    padding: 11px;
    color: inherit;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, .06);
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__image {
    display: block;
    width: 100%;
    aspect-ratio: 1.65 / 1;
    overflow: hidden;
    border-radius: 11px;
    background: #eee;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s ease;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card:hover
  .buzzko-related-card__image img {
    transform: scale(1.025);
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__content {
    padding: 15px 6px 8px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__title {
    margin: 0;
    color: #111;
    font-size: 15px;
    line-height: 1.3;
    font-weight: 800;
    letter-spacing: -.2px;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__title a {
    color: inherit;
    text-decoration: none;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__title a:hover {
    text-decoration: underline;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 17px;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__price {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    min-width: 0;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__price-current {
    color: #111;
    font-size: 15px;
    line-height: 1;
    font-weight: 800;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__price-compare {
    color: #999;
    font-size: 12px;
    text-decoration: line-through;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__form {
    margin: 0;
    flex-shrink: 0;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__atc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 7px 14px;
    background: #FF60B9;
    color: #201e1e;
    border: 0;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .3px;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition: background .2s ease, transform .2s ease;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__atc:hover:not(:disabled) {
    background: #e469af;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__atc:disabled {
    background: #ccc;
    cursor: not-allowed;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__atc[data-state="loading"] {
    opacity: .7;
    cursor: wait;
  }

  #RelatedProducts-{{ section.id }} .buzzko-related-card__atc[data-state="success"] {
    background: #B9E404;
  }

  @media screen and (max-width: 749px) {
    #RelatedProducts-{{ section.id }} .related-products__heading {
      margin-bottom: 2rem;
    }

    #RelatedProducts-{{ section.id }} .buzzko-related-card {
      padding: 7px;
      border-width: 2px;
      border-radius: 13px;
    }

    #RelatedProducts-{{ section.id }} .buzzko-related-card__image {
      border-radius: 8px;
    }

    #RelatedProducts-{{ section.id }} .buzzko-related-card__content {
      padding: 10px 3px 5px;
    }

    #RelatedProducts-{{ section.id }} .buzzko-related-card__title {
      font-size: 13px;
    }

    #RelatedProducts-{{ section.id }} .buzzko-related-card__footer {
      padding-top: 12px;
      gap: 6px;
    }

    #RelatedProducts-{{ section.id }} .buzzko-related-card__price-current {
      font-size: 13px;
    }

    #RelatedProducts-{{ section.id }} .buzzko-related-card__atc {
      padding: 6px 10px;
      font-size: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #RelatedProducts-{{ section.id }} .buzzko-related-card,
    #RelatedProducts-{{ section.id }} .buzzko-related-card__image img,
    #RelatedProducts-{{ section.id }} .buzzko-related-card__atc {
      transition: none;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <product-recommendations
    id="RelatedProducts-{{ section.id }}"
    class="related-products page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {% if recommendations.performed and recommendations.products_count > 0 %}
      <h2 class="related-products__heading inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>

      <ul
        class="grid product-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
        role="list"
      >
        {% for recommendation in recommendations.products %}
          {% assign variant = recommendation.selected_or_first_available_variant %}
          {% assign border_index = forloop.index0 | modulo: 6 %}

          {% case border_index %}
            {% when 0 %}
              {% assign card_border = '#F7CFCF' %}
            {% when 1 %}
              {% assign card_border = '#B9E404' %}
            {% when 2 %}
              {% assign card_border = '#9DDCF7' %}
            {% when 3 %}
              {% assign card_border = '#FFD96A' %}
            {% when 4 %}
              {% assign card_border = '#CDB8F5' %}
            {% else %}
              {% assign card_border = '#FF9FC8' %}
          {% endcase %}

          <li class="grid__item">
            <div
              class="buzzko-related-card"
              style="--buzzko-card-border: {{ card_border }};"
            >
              <a
                href="{{ recommendation.url }}"
                class="buzzko-related-card__image"
                aria-label="{{ recommendation.title | escape }}"
              >
                {% if recommendation.featured_image != blank %}
                  {{
                    recommendation.featured_image
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 700',
                      sizes: '(min-width: 990px) 22vw, (min-width: 750px) 45vw, 90vw',
                      alt: recommendation.featured_image.alt | default: recommendation.title
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag }}
                {% endif %}
              </a>

              <div class="buzzko-related-card__content">
                <h3 class="buzzko-related-card__title">
                  <a href="{{ recommendation.url }}">
                    {{ recommendation.title }}
                  </a>
                </h3>

                <div class="buzzko-related-card__footer">
                  <div class="buzzko-related-card__price">
                    {% if recommendation.compare_at_price > recommendation.price %}
                      <span class="buzzko-related-card__price-current">
                        {{ recommendation.price | money }}
                      </span>
                      <span class="buzzko-related-card__price-compare">
                        {{ recommendation.compare_at_price | money }}
                      </span>
                    {% else %}
                      <span class="buzzko-related-card__price-current">
                        {{ recommendation.price | money }}
                      </span>
                    {% endif %}
                  </div>

                  <form
                    action="/cart/add"
                    method="post"
                    class="buzzko-related-card__form"
                    data-buzzko-atc
                  >
                    <input type="hidden" name="id" value="{{ variant.id }}">

                    <button
                      type="submit"
                      name="add"
                      class="buzzko-related-card__atc"
                      data-label-default="Add to Cart"
                      data-label-loading="Adding…"
                      data-label-success="Added ✓"
                      {% unless variant.available %}disabled{% endunless %}
                    >
                      {% if variant.available %}
                        Add to Cart
                      {% else %}
                        Sold Out
                      {% endif %}
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </product-recommendations>
</div>

<script>
(function () {
  var root = document.getElementById('RelatedProducts-{{ section.id }}');
  if (!root || root.dataset.buzzkoAtcInit === 'true') return;
  root.dataset.buzzkoAtcInit = 'true';

  // Respect locale/market subfolders (e.g. /en/cart/add.js)
  var ROOT = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

  /* ---------- helpers ---------- */

  function state(button, value, label) {
    if (value) button.setAttribute('data-state', value);
    else button.removeAttribute('data-state');
    if (typeof label === 'string') button.textContent = label;
  }

  // Parse an HTML string and pull a specific element out of it.
  function pick(html, selector) {
    if (!html) return null;
    return new DOMParser().parseFromString(html, 'text/html').querySelector(selector);
  }

  /**
   * Render the section HTML that /cart/add.js returns when you pass
   * `sections=cart-drawer,cart-icon-bubble`. This is what actually creates
   * the cart-count bubble on the very first add of a session — the bubble
   * simply isn't in the DOM while the cart is empty.
   */
  function renderSections(sections) {
    if (!sections) return;

    // 1. Cart drawer (Dawn-style)
    var drawer = document.querySelector('cart-drawer');
    if (drawer && sections['cart-drawer']) {
      var currentInner = drawer.querySelector('.drawer__inner');
      var freshInner = pick(sections['cart-drawer'], '.drawer__inner');
      if (currentInner && freshInner) {
        currentInner.innerHTML = freshInner.innerHTML;
      }
    }

    // 2. Cart count bubble — creates it on the first add of the session
    if (sections['cart-icon-bubble']) {
      var oldBubble = document.querySelector('.cart-count-bubble');
      var host =
        document.getElementById('cart-icon-bubble') ||
        (oldBubble && oldBubble.parentElement);

      if (host) {
        var newBubble = pick(sections['cart-icon-bubble'], '.cart-count-bubble');
        if (newBubble) {
          if (oldBubble) oldBubble.replaceWith(newBubble);
          else host.appendChild(newBubble);   // <-- first-add case
        } else if (oldBubble) {
          oldBubble.remove();                 // cart emptied
        }
      }
    }
  }

  // Fallback: patch any count nodes already in the DOM.
  function updateCounts(cart) {
    if (!cart || typeof cart.item_count !== 'number') return;
    document.querySelectorAll('[data-cart-count], .cart-count').forEach(function (el) {
      var next = String(cart.item_count);
      if (el.textContent !== next) el.textContent = next;
    });
  }

  function openDrawer() {
    var drawer = document.querySelector('cart-drawer');
    if (drawer && typeof drawer.open === 'function') {
      try { drawer.open(); } catch (e) { /* noop */ }
    }
  }

  /* ---------- main handler (delegated on product-recommendations root) ---------- */

  root.addEventListener('submit', function (event) {
    var form = event.target;

    if (!form.matches('[data-buzzko-atc]')) return;

    event.preventDefault();

    var button = form.querySelector('.buzzko-related-card__atc');

    if (!button || button.disabled || button.dataset.state === 'loading') {
      return;
    }

    var normal = button.dataset.labelDefault || 'Add to Cart';

    state(button, 'loading', button.dataset.labelLoading || 'Adding…');
    button.disabled = true;

    var data = new FormData(form);
    data.append('sections', 'cart-drawer,cart-icon-bubble');
    data.append('sections_url', window.location.pathname);

    fetch(ROOT + 'cart/add.js', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: data
    })
      .then(function (res) {
        return res.json().then(function (json) {
          if (!res.ok) throw json;
          return json;
        });
      })
      .then(function (added) {
        // 1) Inject server-rendered sections — creates the count bubble
        //    on the first add of the session.
        renderSections(added.sections);

        // 2) Fetch fresh cart state and patch any remaining count nodes.
        return fetch(ROOT + 'cart.js', {
          headers: { 'Accept': 'application/json' }
        })
          .then(function (res) { return res.json(); })
          .then(function (cart) {
            updateCounts(cart);
            openDrawer();
          });
      })
      .then(function () {
        state(button, 'success', button.dataset.labelSuccess || 'Added ✓');

        setTimeout(function () {
          state(button, '', normal);
          button.disabled = false;
        }, 1400);
      })
      .catch(function (error) {
        console.error('[BuzzKo ATC]', error);
        state(button, '', 'Try again');
        button.disabled = false;

        setTimeout(function () {
          state(button, '', normal);
        }, 1600);
      });
  });
})();
</script>

{% schema %}
{
  "name": "t:sections.related-products.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.related-products.settings.paragraph__1.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.related-products.settings.paragraph__1.default",
      "label": "t:sections.related-products.settings.heading.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "t:sections.related-products.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.related-products.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.related-products.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.related-products.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.related-products.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.related-products.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.related-products.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.related-products.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.related-products.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.related-products.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.all.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.all.image_shape.options__3.label"
        },
        {
          "value": "chevronleft",
          "label": "t:sections.all.image_shape.options__4.label"
        },
        {
          "value": "chevronright",
          "label": "t:sections.all.image_shape.options__5.label"
        },
        {
          "value": "diamond",
          "label": "t:sections.all.image_shape.options__6.label"
        },
        {
          "value": "parallelogram",
          "label": "t:sections.all.image_shape.options__7.label"
        },
        {
          "value": "round",
          "label": "t:sections.all.image_shape.options__8.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.related-products.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.related-products.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.related-products.settings.show_rating.label",
      "info": "t:sections.related-products.settings.show_rating.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
