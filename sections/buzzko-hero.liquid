{% style %}
  #BuzzkoHero-{{ section.id }} {
    --buzzko-pink: #ff5ca8;
    --buzzko-bg: #fffaf5;
    --buzzko-radius: 30px;
  }

  #BuzzkoHero-{{ section.id }} {
    width: 100%;
    background: var(--buzzko-bg);
    overflow: hidden;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__container {
    width: min(1400px, calc(100% - 64px));
    margin: 0 auto;
    padding: 32px 0 40px;
  }

  /* SLIDESHOW */

  #BuzzkoHero-{{ section.id }} .buzzko-hero__slideshow {
    width: 100%;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__slides {
    position: relative;

    width: 100%;
    aspect-ratio: 2.4 / 1;
    max-height: 580px;

    overflow: hidden;

    border-radius: var(--buzzko-radius);
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__slide {
    position: absolute;
    inset: 0;

    opacity: 0;
    visibility: hidden;

    transition:
      opacity 500ms ease,
      visibility 500ms ease;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__slide img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
  }

  /* FLOATING CTA — always bottom-left, small + translucent */

  #BuzzkoHero-{{ section.id }} .buzzko-hero__cta {
    position: absolute;
    z-index: 2;

    left: 28px;
    bottom: 28px;

    display: flex;

    pointer-events: none;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__cta-btn {
    pointer-events: auto;

    position: relative;
    isolation: isolate;
    overflow: hidden;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 40px;
    padding: 0 20px;

    border-radius: 999px;

    text-decoration: none;

    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1;

    color: var(--btn-text, #111);

    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);

    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  /* Translucent colour layer — text stays crisp, background fades */
  #BuzzkoHero-{{ section.id }} .buzzko-hero__cta-btn::before {
    content: "";
    position: absolute;
    inset: 0;

    border-radius: inherit;

    background: var(--btn-bg, var(--buzzko-pink));
    opacity: 0.82;

    transition: opacity 180ms ease, background 180ms ease;

    z-index: -1;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__cta-btn:hover::before {
    opacity: 1;
    background: var(--btn-hover, var(--btn-bg, #e94a96));
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__cta-btn:active {
    transform: translateY(0);
  }

  /* CONTROLS */

  #BuzzkoHero-{{ section.id }} .buzzko-hero__controls {
    margin-top: 14px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__control {
    width: 36px;
    height: 36px;

    border: 1px solid #222;
    border-radius: 50%;

    background: transparent;
    color: #111;

    cursor: pointer;

    transition: background 180ms ease, color 180ms ease;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__control:hover {
    background: #111;
    color: #fff;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__dots {
    display: flex;
    gap: 7px;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__dot {
    width: 8px;
    height: 8px;

    padding: 0;

    border: 0;
    border-radius: 50%;

    background: #ccc;

    cursor: pointer;

    transition: background 180ms ease, width 180ms ease;
  }

  #BuzzkoHero-{{ section.id }} .buzzko-hero__dot.is-active {
    background: #111;
    width: 22px;
    border-radius: 999px;
  }

  /* EMPTY STATE */

  #BuzzkoHero-{{ section.id }} .buzzko-hero__empty {
    min-height: 400px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: var(--buzzko-radius);

    background: #eee;
    color: #666;
  }

  /* TABLET */

  @media screen and (max-width: 989px) {
    #BuzzkoHero-{{ section.id }} .buzzko-hero__container {
      width: min(100% - 40px, 700px);
      padding: 24px 0 36px;
    }

    #BuzzkoHero-{{ section.id }} .buzzko-hero__slides {
      aspect-ratio: 3 / 2;
      max-height: none;
      border-radius: 24px;
    }

    #BuzzkoHero-{{ section.id }} .buzzko-hero__cta {
      left: 22px;
      bottom: 22px;
    }
  }

  /* MOBILE — still bottom-left, just smaller */

  @media screen and (max-width: 749px) {
    #BuzzkoHero-{{ section.id }} .buzzko-hero__container {
      width: calc(100% - 28px);
      padding: 16px 0 32px;
    }

    #BuzzkoHero-{{ section.id }} .buzzko-hero__slides {
      aspect-ratio: 4 / 5;
      border-radius: 20px;
    }

    #BuzzkoHero-{{ section.id }} .buzzko-hero__cta {
      left: 16px;
      bottom: 16px;
    }

    #BuzzkoHero-{{ section.id }} .buzzko-hero__cta-btn {
      min-height: 38px;
      padding: 0 18px;
      font-size: 12px;
    }

    #BuzzkoHero-{{ section.id }} .buzzko-hero__control {
      display: none;
    }

    #BuzzkoHero-{{ section.id }} .buzzko-hero__controls {
      margin-top: 12px;
    }
  }
{% endstyle %}

<section
  id="BuzzkoHero-{{ section.id }}"
  class="buzzko-hero"
>
  <div class="buzzko-hero__container">
    <div
      class="buzzko-hero__slideshow"
      data-buzzko-slideshow
      data-autoplay="{{ section.settings.autoplay }}"
      data-interval="{{ section.settings.interval | times: 1000 }}"
    >
      {% if section.blocks.size > 0 %}

        <div class="buzzko-hero__slides">

          {% for block in section.blocks %}

            {% if block.settings.image != blank %}

              {% liquid
                assign slide_loading = 'lazy'
                if forloop.first
                  assign slide_loading = 'eager'
                endif
              %}

              <div
                class="buzzko-hero__slide{% if forloop.first %} is-active{% endif %}"
                data-slide
                {{ block.shopify_attributes }}
              >
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    loading: slide_loading,
                    widths: '600,800,1000,1200,1400,1600,1800,2000,2400',
                    sizes: '(min-width: 990px) 90vw, 100vw',
                    alt: block.settings.alt_text
                }}

                {% if block.settings.button_label != blank %}
                  <div class="buzzko-hero__cta">
                    <a
                      href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
                      class="buzzko-hero__cta-btn"
                      style="
                        --btn-bg: {{ block.settings.button_color }};
                        --btn-text: {{ block.settings.button_text_color }};
                        --btn-hover: {{ block.settings.button_hover_color }};
                      "
                    >
                      {{ block.settings.button_label }}
                    </a>
                  </div>
                {% endif %}
              </div>

            {% endif %}

          {% endfor %}

        </div>

        {% if section.settings.show_slide_controls and section.blocks.size > 1 %}
          <div class="buzzko-hero__controls">

            <button
              type="button"
              class="buzzko-hero__control buzzko-hero__control--prev"
              data-slide-prev
              aria-label="Previous slide"
            >
              ←
            </button>

            <div class="buzzko-hero__dots">
              {% for block in section.blocks %}
                {% if block.settings.image != blank %}
                  <button
                    type="button"
                    class="buzzko-hero__dot{% if forloop.first %} is-active{% endif %}"
                    data-slide-dot="{{ forloop.index0 }}"
                    aria-label="Go to slide {{ forloop.index }}"
                  ></button>
                {% endif %}
              {% endfor %}
            </div>

            <button
              type="button"
              class="buzzko-hero__control buzzko-hero__control--next"
              data-slide-next
              aria-label="Next slide"
            >
              →
            </button>

          </div>
        {% endif %}

      {% else %}

        <div class="buzzko-hero__empty">
          Add a hero slide from the theme editor.
        </div>

      {% endif %}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.querySelector('#BuzzkoHero-{{ section.id }}');
    if (!section) return;

    const slideshow = section.querySelector('[data-buzzko-slideshow]');
    if (!slideshow) return;

    const slides = Array.from(slideshow.querySelectorAll('[data-slide]'));
    if (slides.length <= 1) return;

    const dots = Array.from(slideshow.querySelectorAll('[data-slide-dot]'));
    const nextButton = slideshow.querySelector('[data-slide-next]');
    const prevButton = slideshow.querySelector('[data-slide-prev]');

    let currentIndex = 0;
    let timer = null;

    const showSlide = (index) => {
      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === currentIndex);
      });

      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === currentIndex);
      });
    };

    const nextSlide = () => showSlide(currentIndex + 1);
    const prevSlide = () => showSlide(currentIndex - 1);

    const startAutoplay = () => {
      if (slideshow.dataset.autoplay !== 'true') return;
      const interval = Number(slideshow.dataset.interval) || 5000;
      clearInterval(timer);
      timer = setInterval(nextSlide, interval);
    };

    nextButton?.addEventListener('click', () => { nextSlide(); startAutoplay(); });
    prevButton?.addEventListener('click', () => { prevSlide(); startAutoplay(); });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        showSlide(Number(dot.dataset.slideDot));
        startAutoplay();
      });
    });

    showSlide(0);
    startAutoplay();

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.detail.sectionId === '{{ section.id }}') {
        clearInterval(timer);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "BuzzKo Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slideshow",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Slide duration",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_slide_controls",
      "label": "Show arrows and dots",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop New Collection",
          "info": "Leave empty to hide the button on this slide"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "Button background",
          "default": "#ff5ca8"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "button_hover_color",
          "label": "Button background on hover",
          "default": "#e94a96"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BuzzKo Hero",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}