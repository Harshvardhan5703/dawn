{% comment %}
  BuzzKo FAQ Page
  Add questions as blocks in the Shopify theme editor.
{% endcomment %}

<section id="buzzko-faq-{{ section.id }}" class="buzzko-faq">
  <div class="buzzko-faq__container page-width">
    <header class="buzzko-faq__header">
      {% if section.settings.eyebrow != blank %}
        <p class="buzzko-faq__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      <h1 class="buzzko-faq__title">
        {{ section.settings.heading | escape }}
      </h1>

      {% if section.settings.description != blank %}
        <p class="buzzko-faq__description">
          {{ section.settings.description | escape }}
        </p>
      {% endif %}

      <span class="buzzko-faq__underline" aria-hidden="true"></span>
    </header>

    <div class="buzzko-faq__list">
      {% for block in section.blocks %}
        <details
          class="buzzko-faq__item"
          {{ block.shopify_attributes }}
        >
          <summary class="buzzko-faq__question">
            <span>{{ block.settings.question | escape }}</span>
            <span class="buzzko-faq__toggle" aria-hidden="true"></span>
          </summary>

          <div class="buzzko-faq__answer">
            {{ block.settings.answer }}
          </div>
        </details>
      {% endfor %}
    </div>

    {% if section.settings.contact_text != blank %}
      <div class="buzzko-faq__contact">
        <div class="buzzko-faq__contact-icon" aria-hidden="true">♡</div>
        <div class="buzzko-faq__contact-copy">
          <h2>{{ section.settings.contact_heading | escape }}</h2>
          <p>{{ section.settings.contact_text | escape }}</p>
        </div>
        {% if section.settings.contact_link != blank %}
          <a
            href="{{ section.settings.contact_link }}"
            class="buzzko-faq__contact-button"
          >
            {{ section.settings.contact_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #buzzko-faq-{{ section.id }} {
    --faq-cream: #FFFAF5;
    --faq-pink: #f06c91;
    --faq-ink: #1a1a1a;
    --faq-muted: #625e59;
    --faq-border: #e9e2db;

    background: var(--faq-cream);
    color: var(--faq-ink);
    padding: 64px 0 76px;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__container {
    width: min(100% - 48px, 900px);
    margin-inline: auto;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__header {
    max-width: 650px;
    margin: 0 auto 42px;
    text-align: center;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__eyebrow {
    margin: 0 0 12px;
    color: var(--faq-pink);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__title {
    margin: 0;
    color: var(--faq-ink);
    font-size: clamp(38px, 5vw, 58px);
    font-weight: 800;
    letter-spacing: -.045em;
    line-height: 1.08;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__description {
    max-width: 540px;
    margin: 16px auto 0;
    color: var(--faq-muted);
    font-size: 15px;
    line-height: 1.65;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__underline {
    display: block;
    width: 72px;
    height: 5px;
    margin: 22px auto 0;
    border-radius: 50%;
    background: var(--faq-pink);
    transform: rotate(-2deg);
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__item {
    overflow: hidden;
    border: 1px solid var(--faq-border);
    border-radius: 14px;
    background: #fffdfa;
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__item[open] {
    border-color: #f3b7c7;
    box-shadow: 0 5px 18px rgba(26, 26, 26, .045);
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 68px;
    padding: 18px 22px;
    color: var(--faq-ink);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__question::-webkit-details-marker {
    display: none;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__toggle {
    position: relative;
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fae9e9;
    transition: background .2s ease, transform .2s ease;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__toggle::before,
  #buzzko-faq-{{ section.id }} .buzzko-faq__toggle::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 11px;
    height: 2px;
    border-radius: 2px;
    background: var(--faq-ink);
    transform: translate(-50%, -50%);
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform .2s ease;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__item[open] .buzzko-faq__toggle {
    background: var(--faq-pink);
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__item[open] .buzzko-faq__toggle::after {
    transform: translate(-50%, -50%) rotate(0);
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__answer {
    padding: 0 22px 22px;
    color: var(--faq-muted);
    font-size: 14px;
    line-height: 1.7;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__answer p {
    margin: 0 0 10px;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__answer p:last-child {
    margin-bottom: 0;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__answer a {
    color: var(--faq-pink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__contact {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 36px;
    padding: 24px 28px;
    border-radius: 16px;
    background: #fae9e9;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__contact-icon {
    display: grid;
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 50%;
    background: #fffdfa;
    color: var(--faq-pink);
    font-size: 30px;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__contact-copy {
    flex: 1;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__contact-copy h2 {
    margin: 0 0 4px;
    color: var(--faq-ink);
    font-size: 18px;
    font-weight: 800;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__contact-copy p {
    margin: 0;
    color: var(--faq-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__contact-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 12px 19px;
    border-radius: 999px;
    background: var(--faq-ink);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background .2s ease, transform .2s ease;
  }

  #buzzko-faq-{{ section.id }} .buzzko-faq__contact-button:hover {
    background: var(--faq-pink);
    transform: translateY(-1px);
  }

  @media screen and (max-width: 749px) {
    #buzzko-faq-{{ section.id }} {
      padding: 42px 0 48px;
    }

    #buzzko-faq-{{ section.id }} .buzzko-faq__container {
      width: min(100% - 36px, 600px);
    }

    #buzzko-faq-{{ section.id }} .buzzko-faq__header {
      margin-bottom: 28px;
    }

    #buzzko-faq-{{ section.id }} .buzzko-faq__question {
      min-height: 62px;
      padding: 16px;
      font-size: 14px;
    }

    #buzzko-faq-{{ section.id }} .buzzko-faq__answer {
      padding: 0 16px 18px;
      font-size: 13px;
    }

    #buzzko-faq-{{ section.id }} .buzzko-faq__contact {
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
      padding: 20px;
    }

    #buzzko-faq-{{ section.id }} .buzzko-faq__contact-icon {
      flex-basis: 42px;
      width: 42px;
      height: 42px;
    }

    #buzzko-faq-{{ section.id }} .buzzko-faq__contact-copy {
      flex: 1 1 calc(100% - 60px);
    }

    #buzzko-faq-{{ section.id }} .buzzko-faq__contact-button {
      width: 100%;
      margin-top: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #buzzko-faq-{{ section.id }} *,
    #buzzko-faq-{{ section.id }} *::before,
    #buzzko-faq-{{ section.id }} *::after {
      transition: none !important;
    }
  }
</style>

{% schema %}
