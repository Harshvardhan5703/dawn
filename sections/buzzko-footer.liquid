<footer
  id="buzzko-footer-{{ section.id }}"
  class="buzzko-footer"
>

  <!-- =========================================
       SPLASH WAVE
  ========================================== -->

  <div class="buzzko-footer__splash" aria-hidden="true">

    <svg
      viewBox="0 0 1440 180"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Soft, organic wave -->
      <path
        class="buzzko-footer__splash-front"
        d="M0,180 L0,100 
           C50,100 80,30 150,40 
           C220,50 260,110 330,100 
           C400,90 440,20 510,30 
           C580,40 620,100 690,90 
           C760,80 800,30 870,40 
           C940,50 980,110 1050,100 
           C1120,90 1160,40 1230,50 
           C1300,60 1340,110 1410,100 
           C1430,97 1440,90 1440,90 
           L1440,180 Z"
        fill="{{ section.settings.background_color }}"
      />
    </svg>

  </div>


  <div class="buzzko-footer__body">

    <div class="buzzko-footer__main">

      <div class="buzzko-footer__container">

        <!-- =========================================
             LOGO
        ========================================== -->

        <div class="buzzko-footer__brand">
          {% if section.settings.logo != blank %}
            <a href="{{ routes.root_url }}" class="buzzko-footer__logo-link" aria-label="{{ shop.name }}">
              {{
                section.settings.logo
                | image_url: width: 700
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 500, 700',
                  sizes: '(min-width: 990px) 300px, 70vw',
                  alt: section.settings.logo_alt,
                  class: 'buzzko-footer__logo'
              }}
            </a>
          {% else %}
            <a href="{{ routes.root_url }}" class="buzzko-footer__text-logo">
              {{ shop.name }}
            </a>
          {% endif %}
        </div>


        <!-- =========================================
             FOOTER MENUS
        ========================================== -->

        <div class="buzzko-footer__menus">
          {% for block in section.blocks %}
            {% if block.type == 'menu' %}
              <div class="buzzko-footer__menu" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h3 class="buzzko-footer__menu-heading">{{ block.settings.heading }}</h3>
                {% endif %}

                {% if block.settings.menu != blank %}
                  <ul class="buzzko-footer__menu-list">
                    {% for link in block.settings.menu.links %}
                      <li class="buzzko-footer__menu-item">
                        <a href="{{ link.url }}" class="buzzko-footer__menu-link">
                          {{ link.title }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {% else %}
                  <ul class="buzzko-footer__menu-list">
                    <li class="buzzko-footer__menu-item">
                      <span class="buzzko-footer__menu-link" style="opacity: 0.5;">
                        Select a menu in the theme editor
                      </span>
                    </li>
                  </ul>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>


        <!-- =========================================
             JOIN CLUB (No Link) + SOCIAL
        ========================================== -->

        <div class="buzzko-footer__social">
          {% if section.settings.club_text != blank %}
            <!-- Changed from <a> to <div> -->
            <div class="buzzko-footer__club">
              {{ section.settings.club_text }}
            </div>
          {% endif %}

          <div class="buzzko-footer__social-icons">
            <!-- Instagram -->
            {% if section.settings.instagram_url != blank %}
              <a href="{{ section.settings.instagram_url }}" class="buzzko-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                {% if section.settings.instagram_icon != blank %}
                  {{ section.settings.instagram_icon | image_url: width: 80 | image_tag: loading: 'lazy', width: 25, height: 25, alt: 'Instagram' }}
                {% else %}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.4" cy="6.6" r="1" class="buzzko-footer__icon-fill" />
                  </svg>
                {% endif %}
              </a>
            {% endif %}

            <!-- Pinterest (FIXED) -->
            {% if section.settings.pinterest_url != blank %}
              <a href="{{ section.settings.pinterest_url }}" class="buzzko-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
                {% if section.settings.pinterest_icon != blank %}
                  {{ section.settings.pinterest_icon | image_url: width: 80 | image_tag: loading: 'lazy', width: 25, height: 25, alt: 'Pinterest' }}
                {% else %}
                  <svg viewBox="0 0 496 512" aria-hidden="true">
                    <path fill="currentColor" stroke="none" d="M496 256c0 137-111 248-248 248-25.6 0-50.2-3.9-73.4-11.1 10.1-16.5 25.2-43.5 30.8-65 3-11.6 15.4-59 15.4-59 8.1 15.4 31.7 28.5 56.8 28.5 74.8 0 128.7-68.8 128.7-154.3 0-81.9-66.9-143.2-152.9-143.2-107 0-163.9 71.8-163.9 150.1 0 36.4 19.4 81.7 50.3 96.1 4.7 2.2 7.2 1.2 8.3-3.3.8-3.4 5-20.3 6.9-28.1.6-2.5.3-4.7-1.7-7.1-10.1-12.5-18.3-35.3-18.3-56.6 0-54.7 41.4-107.6 112-107.6 60.9 0 103.6 41.5 103.6 100.9 0 67.1-33.9 113.6-78 113.6-24.3 0-42.6-20.1-36.7-44.8 7-29.5 20.5-61.3 20.5-82.6 0-19-10.2-34.9-31.4-34.9-24.9 0-44.9 25.7-44.9 60.2 0 22 7.4 36.8 7.4 36.8s-24.5 103.8-29 123.2c-5 21.4-3 51.6-.9 71.2C65.4 450.9 0 361.1 0 256 0 119 111 8 248 8s248 111 248 248z"/>
                  </svg>
                {% endif %}
              </a>
            {% endif %}

            <!-- YouTube -->
            {% if section.settings.youtube_url != blank %}
              <a href="{{ section.settings.youtube_url }}" class="buzzko-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                {% if section.settings.youtube_icon != blank %}
                  {{ section.settings.youtube_icon | image_url: width: 80 | image_tag: loading: 'lazy', width: 25, height: 25, alt: 'YouTube' }}
                {% else %}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21.6 7.2a2.8 2.8 0 0 0-2-2C17.8 4.7 12 4.7 12 4.7s-5.8 0-7.6.5a2.8 2.8 0 0 0-2 2C2 9 2 12 2 12s0 3 .4 4.8a2.8 2.8 0 0 0 2 2c1.8.5 7.6.5 7.6.5s5.8 0 7.6-.5a2.8 2.8 0 0 0 2-2C22 15 22 12 22 12s0-3-.4-4.8Z" />
                    <path d="m10 15.5 5-3.5-5-3.5v7Z" fill="{{ section.settings.background_color }}" stroke="none" />
                  </svg>
                {% endif %}
              </a>
            {% endif %}
          </div>
        </div>

      </div>

    </div>


    <!-- =========================================
         BOTTOM BAR
    ========================================== -->

    <div class="buzzko-footer__bottom">
      <div class="buzzko-footer__bottom-inner">
        <p class="buzzko-footer__copyright">
          © {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text }}
        </p>

        {% if section.settings.made_with_text != blank %}
          <a
            href="{{ section.settings.made_with_link }}"
            class="buzzko-footer__made-with"
            {% if section.settings.made_with_link contains 'http' %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            {{ section.settings.made_with_text }}
            <span>{{ section.settings.made_with_emoji }}</span>
          </a>
        {% endif %}
      </div>
    </div>

  </div>

</footer>


<style>

  /* ==================================================
     FOOTER ROOT
  ================================================== */

  #buzzko-footer-{{ section.id }} {
    --buzzko-splash-h: 130px;
    position: relative;
    overflow: hidden;
    background: transparent;
    color: #111;
    padding-top: var(--buzzko-splash-h);
  }

  /* ==================================================
     SPLASH WAVE
  ================================================== */

  #buzzko-footer-{{ section.id }} .buzzko-footer__splash {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(var(--buzzko-splash-h) + 2px);
    z-index: 1;
    pointer-events: none;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__splash svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ==================================================
     BODY
  ================================================== */

  #buzzko-footer-{{ section.id }} .buzzko-footer__body {
    position: relative;
    z-index: 2;
    background: {{ section.settings.background_color }};
    pointer-events: auto;
  }

  /* ==================================================
     MAIN FOOTER
  ================================================== */

  #buzzko-footer-{{ section.id }} .buzzko-footer__main {
    position: relative;
    padding-top: 55px;
    padding-bottom: 55px;
    z-index: 5;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__container {
    width: min(1380px, calc(100% - 108px));
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.25fr 2.2fr 0.8fr;
    align-items: center;
    gap: 70px;
  }

  /* ==================================================
     LOGO
  ================================================== */

  #buzzko-footer-{{ section.id }} .buzzko-footer__brand {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__logo-link {
    display: block;
    text-decoration: none;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__logo {
    display: block;
    width: min(290px, 100%);
    height: auto;
    object-fit: contain;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__text-logo {
    color: #111;
    font-size: 40px;
    font-weight: 900;
    text-decoration: none;
  }

  /* ==================================================
     MENUS
  ================================================== */

  #buzzko-footer-{{ section.id }} .buzzko-footer__menus {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 45px;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__menu-heading {
    margin: 0 0 17px;
    color: #111;
    font-size: 12px;
    line-height: 1;
    font-weight: 800;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__menu-item {
    margin: 0 0 10px;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__menu-link {
    display: block;
    position: relative;
    z-index: 10;
    color: #333;
    font-size: 10px;
    line-height: 1.35;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__menu-link:hover {
    color: #F45F9B;
  }

  /* ==================================================
     JOIN CLUB (SPLASH EFFECT)
  ================================================== */

  #buzzko-footer-{{ section.id }} .buzzko-footer__social {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__club {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 150px;
    min-height: 85px;
    padding: 20px 25px;
    text-align: center;
    color: #fff;
    background: #F45F8F;
    font-size: 14px;
    line-height: 1.05;
    font-weight: 800;
    text-decoration: none;
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    transform: rotate(-3deg);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    z-index: 10;
    
    /* Font Selector Variables */
    font-family: {{ section.settings.club_font.family }}, {{ section.settings.club_font.fallback_families }};
    font-weight: {{ section.settings.club_font.weight }};
    font-style: {{ section.settings.club_font.style }};
  }

  /* Splash layer behind the button */
  #buzzko-footer-{{ section.id }} .buzzko-footer__club::before {
    content: '';
    position: absolute;
    top: -10px;
    left: -10px;
    right: -10px;
    bottom: -10px;
    background: #F45F8F;
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    z-index: -1;
    opacity: 0.6;
    transform: rotate(8deg);
    transition: transform 0.3s ease;
  }

  /* Small droplet splash */
  #buzzko-footer-{{ section.id }} .buzzko-footer__club::after {
    content: '';
    position: absolute;
    top: -18px;
    right: -15px;
    width: 18px;
    height: 18px;
    background: #F45F8F;
    border-radius: 50%;
    z-index: -1;
    opacity: 0.8;
  }

  /* Removed hover effects that imply it's a link, keeping only the visual shape */

  /* ==================================================
     SOCIAL ICONS
  ================================================== */

  #buzzko-footer-{{ section.id }} .buzzko-footer__social-icons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 25px;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__social-link {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #111;
    text-decoration: none;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__social-link:hover {
    color: #F45F9B;
    transform: translateY(-2px);
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__social-link svg {
    width: 22px;
    height: 22px;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__social-link svg path {
    stroke: currentColor;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__social-link svg .buzzko-footer__icon-fill {
    fill: currentColor;
    stroke: none;
  }

  /* ==================================================
     BOTTOM BAR
  ================================================== */

  #buzzko-footer-{{ section.id }} .buzzko-footer__bottom {
    position: relative;
    z-index: 3;
    border-top: 1px solid rgba(17, 17, 17, 0.7);
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__bottom-inner {
    width: min(100%, 1380px);
    min-height: 45px;
    margin: 0 auto;
    padding: 0 54px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__copyright,
  #buzzko-footer-{{ section.id }} .buzzko-footer__made-with {
    margin: 0;
    color: #222;
    font-size: 9px;
    line-height: 1.3;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__made-with {
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__made-with:hover {
    color: #F45F9B;
  }

  #buzzko-footer-{{ section.id }} .buzzko-footer__made-with span {
    margin-left: 2px;
  }

  /* ==================================================
     TABLET
  ================================================== */

  @media screen and (max-width: 989px) {
    #buzzko-footer-{{ section.id }} {
      --buzzko-splash-h: 100px;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__container {
      width: calc(100% - 48px);
      grid-template-columns: 1fr 1.7fr;
      gap: 45px;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__social {
      grid-column: 2;
      align-items: flex-start;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__social-icons {
      justify-content: flex-start;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__main {
      padding-top: 48px;
    }
  }

  /* ==================================================
     MOBILE
  ================================================== */

  @media screen and (max-width: 749px) {
    #buzzko-footer-{{ section.id }} {
      --buzzko-splash-h: 72px;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__main {
      padding-top: 38px;
      padding-bottom: 40px;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__container {
      width: calc(100% - 32px);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 38px;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__brand {
      justify-content: center;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__logo {
      width: 230px;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__menus {
      width: 100%;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 15px;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__menu-heading {
      font-size: 11px;
      margin-bottom: 13px;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__menu-item {
      margin-bottom: 8px;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__menu-link {
      font-size: 9px;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__social {
      align-items: center;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__social-icons {
      justify-content: center;
    }

    #buzzko-footer-{{ section.id }} .buzzko-footer__bottom-inner {
      min-height: 55px;
      padding: 10px 16px;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      text-align: center;
    }
  }

</style>


{% schema %}
{
  "name": "BuzzKo Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alt text",
      "default": "BuzzKo"
    },
    {
      "type": "text",
      "id": "club_text",
      "label": "Club button text",
      "default": "JOIN THE CLUB"
    },
    {
      "type": "font_picker",
      "id": "club_font",
      "label": "Club text font",
      "default": "sans-serif"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "image_picker",
      "id": "instagram_icon",
      "label": "Instagram icon"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "image_picker",
      "id": "pinterest_icon",
      "label": "Pinterest icon"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "image_picker",
      "id": "youtube_icon",
      "label": "YouTube icon"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "Buzzko. All rights reserved."
    },
    {
      "type": "text",
      "id": "made_with_text",
      "label": "Made with text",
      "default": "Made with love in India"
    },
    {
      "type": "text",
      "id": "made_with_emoji",
      "label": "Made with emoji",
      "default": "♡"
    },
    {
      "type": "url",
      "id": "made_with_link",
      "label": "Made with link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Footer background",
      "default": "#FDE9F1"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Footer menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "BuzzKo Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "Shop"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "About"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Help"
          }
        }
      ]
    }
  ]
}
{% endschema %}