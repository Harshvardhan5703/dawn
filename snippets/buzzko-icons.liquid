        </g>
        <g transform="translate(56 14)"><path class="bz-spark bz-spark-2" d="M0 -5 Q0 0 5 0 Q0 0 0 5 Q0 0 -5 0 Q0 0 0 -5Z" fill="#ffe08a" stroke="var(--bz-ink)" stroke-width="1.5" stroke-linejoin="round"/></g>
      </svg>

    {%- when 9 -%}
      <svg class="bz-svg" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <g class="bz-rays" stroke="#ffb04a" stroke-width="3" stroke-linecap="round">
          <path class="bz-ray" d="M32 6 V1.5"/>
          <path class="bz-ray" d="M16.5 11.5 L13.3 8.3"/>
          <path class="bz-ray" d="M47.5 11.5 L50.7 8.3"/>
          <path class="bz-ray" d="M10 26 H5.5"/>
          <path class="bz-ray" d="M54 26 H58.5"/>
        </g>
        <g class="bz-bulb">
          <path class="bz-s" d="M32 9 C42.5 9 49 16 49 25 C49 31 45.5 34.5 43 38 C41.8 39.7 41.5 41 41.5 43 H22.5 C22.5 41 22.2 39.7 21 38 C18.5 34.5 15 31 15 25 C15 16 21.5 9 32 9 Z" fill="var(--bz-yellow)"/>
