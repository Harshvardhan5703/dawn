{%- comment -%}
  Buzzko cute animated icons
  Usage: {% render 'buzzko-icons', n: 1 %}   (n = 1..5, one per card)
    1 = Return window (alarm clock)
    2 = Refund process (flipping heart coin)
    3 = Non-returnable (sad box + no badge)
    4 = Exchanges (swap arrows)
    5 = Initiate return (envelope + love letter)
  Care guide:
    6 = Charms & Keychains (swinging heart charm)
    7 = Lighters (flickering flame)
    8 = Posters & Frames (tilting frame)
    9 = General tips (glowing light bulb)

  Desktop (hover + fine pointer): animates when the card is hovered.
  Mobile / tablet: animates when the card scrolls into view.
{%- endcomment -%}

<span class="bz-icon" data-bz-icon aria-hidden="true">
  {%- case n -%}

    {%- when 1 -%}
      <svg class="bz-svg" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <g class="bz-clock">
          <g class="bz-bell bz-bell-l">
            <path class="bz-s" d="M6 22 Q6 8 20 9 Q16 14 17 22 Z" fill="var(--bz-pink)"/>
          </g>
          <g class="bz-bell bz-bell-r">
            <path class="bz-s" d="M58 22 Q58 8 44 9 Q48 14 47 22 Z" fill="var(--bz-pink)"/>
          </g>
          <path class="bz-s" d="M22 54 L18 60 M42 54 L46 60"/>
          <circle class="bz-s" cx="32" cy="35" r="20" fill="var(--bz-yellow)"/>
          <circle cx="32" cy="35" r="14.5" fill="#fffdf6"/>
          <circle cx="32" cy="23" r="1.3" fill="var(--bz-ink)"/>
          <circle cx="32" cy="47" r="1.3" fill="var(--bz-ink)"/>
          <circle cx="20" cy="35" r="1.3" fill="var(--bz-ink)"/>
          <circle cx="44" cy="35" r="1.3" fill="var(--bz-ink)"/>
          <ellipse cx="23" cy="42" rx="3" ry="2" fill="var(--bz-pink)" opacity=".8"/>
          <ellipse cx="41" cy="42" rx="3" ry="2" fill="var(--bz-pink)" opacity=".8"/>
          <path class="bz-s" d="M29.5 43 Q32 45.5 34.5 43" stroke-width="2"/>
          <path class="bz-s bz-hand-h" d="M32 35 L39 35" stroke-width="3"/>
          <path class="bz-s bz-hand-m" d="M32 35 L32 24" stroke-width="3"/>
          <circle cx="32" cy="35" r="2" fill="var(--bz-ink)"/>
        </g>
      </svg>

    {%- when 2 -%}
      <svg class="bz-svg" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <ellipse class="bz-s" cx="32" cy="54" rx="15" ry="5.5" fill="#ffd25e"/>
        <ellipse class="bz-s" cx="32" cy="49.5" rx="15" ry="5.5" fill="var(--bz-yellow)"/>
        <g class="bz-coin">
          <circle class="bz-s" cx="32" cy="29" r="15" fill="var(--bz-yellow)"/>
          <circle cx="32" cy="29" r="10.5" fill="none" stroke="#e8b93c" stroke-width="1.8" stroke-dasharray="2.5 3" stroke-linecap="round"/>
          <path class="bz-s" d="M32 36 C25.5 31.8 24.6 26.4 28.4 24.8 C30.4 24 31.6 25.2 32 26.4 C32.4 25.2 33.6 24 35.6 24.8 C39.4 26.4 38.5 31.8 32 36 Z" fill="var(--bz-pink)" stroke-width="2"/>
        </g>
        <g transform="translate(10 15)"><path class="bz-spark bz-spark-1" d="M0 -5 Q0 0 5 0 Q0 0 0 5 Q0 0 -5 0 Q0 0 0 -5Z" fill="#ffb3cd" stroke="var(--bz-ink)" stroke-width="1.6" stroke-linejoin="round"/></g>
        <g transform="translate(54 12)"><path class="bz-spark bz-spark-2" d="M0 -4 Q0 0 4 0 Q0 0 0 4 Q0 0 -4 0 Q0 0 0 -4Z" fill="#b8e2ff" stroke="var(--bz-ink)" stroke-width="1.6" stroke-linejoin="round"/></g>
        <g transform="translate(56 34)"><path class="bz-spark bz-spark-3" d="M0 -3 Q0 0 3 0 Q0 0 0 3 Q0 0 -3 0 Q0 0 0 -3Z" fill="#ffe08a" stroke="var(--bz-ink)" stroke-width="1.4" stroke-linejoin="round"/></g>
      </svg>

    {%- when 3 -%}
      <svg class="bz-svg" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <g class="bz-box">
          <rect class="bz-s" x="10" y="26" width="40" height="28" rx="5" fill="var(--bz-peach)"/>
          <rect class="bz-s" x="7" y="18" width="46" height="11" rx="4" fill="#ffbf8e"/>
          <rect x="26" y="18" width="8" height="11" fill="var(--bz-pink)" stroke="var(--bz-ink)" stroke-width="2.5" stroke-linejoin="round"/>
          <circle cx="21" cy="40" r="2.2" fill="var(--bz-ink)"/>
          <circle cx="39" cy="40" r="2.2" fill="var(--bz-ink)"/>
          <circle cx="16.5" cy="45" r="2.6" fill="var(--bz-pink)" opacity=".85"/>
