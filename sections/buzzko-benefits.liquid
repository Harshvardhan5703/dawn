<section
  id="buzzko-benefits-{{ section.id }}"
  class="buzzko-benefits"
>
  <div class="buzzko-benefits__container">

    <div class="buzzko-benefits__grid">

      {% for block in section.blocks %}

        <div
          class="buzzko-benefit"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.icon != blank %}
            <div class="buzzko-benefit__icon">
              {{
                block.settings.icon
                | image_url: width: 160
                | image_tag:
                  loading: 'lazy',
                  widths: '80, 120, 160',
                  alt: block.settings.title
              }}
            </div>
          {% endif %}

          <div class="buzzko-benefit__content">

            {% if block.settings.title != blank %}
              <h3 class="buzzko-benefit__title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="buzzko-benefit__description">
                {{ block.settings.description }}
              </p>
            {% endif %}

          </div>

        </div>

      {% endfor %}

    </div>

  </div>
</section>


<style>

  /* =========================
     SECTION
  ========================= */

  #buzzko-benefits-{{ section.id }} {
    background: {{ section.settings.background_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  #buzzko-benefits-{{ section.id }} .buzzko-benefits__container {
    width: min(1380px, calc(100% - 108px));
    margin: 0 auto;
  }


  /* =========================
     GRID
  ========================= */

  #buzzko-benefits-{{ section.id }} .buzzko-benefits__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }


  /* =========================
     BENEFIT
  ========================= */

  #buzzko-benefits-{{ section.id }} .buzzko-benefit {
    display: flex;
    align-items: center;
    gap: 16px;

    min-width: 0;
  }


  /* =========================
     ICON
  ========================= */

  #buzzko-benefits-{{ section.id }} .buzzko-benefit__icon {
    width: 58px;
    height: 58px;

    flex: 0 0 58px;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  #buzzko-benefits-{{ section.id }} .buzzko-benefit__icon img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: contain;
  }


  /* =========================
     CONTENT
  ========================= */

  #buzzko-benefits-{{ section.id }} .buzzko-benefit__content {
    min-width: 0;
  }

  #buzzko-benefits-{{ section.id }} .buzzko-benefit__title {
    margin: 0;

    color: {{ section.settings.text_color }};

    font-size: 15px;
    line-height: 1.25;
    font-weight: 800;

    letter-spacing: -0.2px;
  }

  #buzzko-benefits-{{ section.id }} .buzzko-benefit__description {
    margin: 5px 0 0;

    color: {{ section.settings.description_color }};

    font-size: 12px;
    line-height: 1.45;
    font-weight: 400;
  }


  /* =========================
     TABLET
  ========================= */

  @media screen and (max-width: 989px) {

    #buzzko-benefits-{{ section.id }} .buzzko-benefits__container {
      width: min(100% - 48px, 720px);
    }

    #buzzko-benefits-{{ section.id }} .buzzko-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 30px;
    }

  }


  /* =========================
     MOBILE
  ========================= */

  @media screen and (max-width: 749px) {

    #buzzko-benefits-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #buzzko-benefits-{{ section.id }} .buzzko-benefits__container {
      width: calc(100% - 32px);
    }

    #buzzko-benefits-{{ section.id }} .buzzko-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 18px;
      row-gap: 28px;
    }

    #buzzko-benefits-{{ section.id }} .buzzko-benefit {
      gap: 10px;
      align-items: flex-start;
    }

    #buzzko-benefits-{{ section.id }} .buzzko-benefit__icon {
      width: 42px;
      height: 42px;
      flex-basis: 42px;
    }

    #buzzko-benefits-{{ section.id }} .buzzko-benefit__title {
      font-size: 13px;
    }

    #buzzko-benefits-{{ section.id }} .buzzko-benefit__description {
      font-size: 10px;
      margin-top: 3px;
    }

  }

</style>


{% schema %}

{
  "name": "BuzzKo Benefits",
  "tag": "section",

  "settings": [

    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FAF8F6"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Title color",
      "default": "#111111"
    },

    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#777777"
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 32,
      "unit": "px"
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 32,
      "unit": "px"
    }

  ],

  "blocks": [

    {
      "type": "benefit",
      "name": "Benefit",

      "settings": [

        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast Shipping"
        },

        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Quick and reliable delivery"
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "BuzzKo Benefits",

      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Fast Shipping",
            "description": "Quick and reliable delivery"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Premium Quality",
            "description": "Made to look good and last"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Secure Payments",
            "description": "Safe and secure checkout"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Made With Love",
            "description": "Products you'll love to carry"
          }
        }
      ]

    }

  ]

}

{% endschema %}