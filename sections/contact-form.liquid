{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .buzzko-contact {
    background: #FFFAF5;
    color: #1A1A1A;
  }

  .buzzko-contact__inner {
    max-width: 1160px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  .buzzko-contact__layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 64px;
    align-items: start;
  }

  .buzzko-contact__intro {
    padding-top: 18px;
  }

  .buzzko-contact__eyebrow {
    display: inline-block;
    margin-bottom: 18px;
    padding: 8px 14px;
    border: 1px solid #F2B8C6;
    border-radius: 30px;
    background: #FDE9F1;
    color: #1A1A1A;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  .buzzko-contact__heading {
    margin: 0 0 18px;
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1.04;
    letter-spacing: -2.5px;
    font-weight: 800;
    color: #1A1A1A;
  }

  .buzzko-contact__heading em {
    color: #E66C8C;
    font-style: normal;
  }

  .buzzko-contact__description {
    max-width: 390px;
    color: #66615F;
    font-size: 16px;
    line-height: 1.75;
  }

  .buzzko-contact__note {
    margin-top: 36px;
    padding: 20px;
    border: 1px solid #F1D5DC;
    border-radius: 16px;
    background: #FFFAF5;
  }

  .buzzko-contact__note-title {
    margin: 0 0 6px;
    font-size: 15px;
    font-weight: 700;
  }

  .buzzko-contact__note-text {
    margin: 0;
    color: #716B68;
    font-size: 13px;
    line-height: 1.6;
  }

  /* --- WhatsApp & Instagram contact cards --- */
  .buzzko-contact__channels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 16px;
  }

  .buzzko-contact__channel-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border: 1px solid #F1D5DC;
    border-radius: 14px;
    background: #FFFAF5;
    text-decoration: none;
    color: #1A1A1A;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .buzzko-contact__channel-card:hover {
    border-color: #E66C8C;
    transform: translateY(-2px);
  }

  .buzzko-contact__channel-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #FDE9F1;
    color: #E66C8C;
  }

  .buzzko-contact__channel-icon svg {
    width: 20px;
    height: 20px;
    display: block;
    fill: currentColor;
  }

  .buzzko-contact__channel-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .buzzko-contact__channel-title {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }

  .buzzko-contact__channel-text {
    font-size: 12px;
    color: #716B68;
    line-height: 1.4;
  }

  .buzzko-contact__form-card {
    padding: 36px;
    border: 1px solid #F0E5E0;
    border-radius: 22px;
    background: #FFFAF5;
    box-shadow: 0 12px 36px rgba(26, 26, 26, 0.045);
  }

  .buzzko-contact__form-title {
    margin: 0 0 8px;
    font-size: 24px;
    font-weight: 750;
    letter-spacing: -0.6px;
  }

  .buzzko-contact__form-subtitle {
    margin: 0 0 28px;
    color: #77716D;
    font-size: 14px;
    line-height: 1.6;
  }

  .buzzko-contact .contact__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .buzzko-contact .field {
    margin-bottom: 18px;
  }

  .buzzko-contact .field:before,
  .buzzko-contact .field:after {
    display: none;
  }

  .buzzko-contact .field__input,
  .buzzko-contact .text-area {
    min-height: 52px;
    padding: 16px;
    border: 1px solid #E8DDD8;
    border-radius: 10px;
    background: #FFFAF5;
    color: #1A1A1A;
    box-shadow: none;
    font-size: 14px;
  }

  .buzzko-contact .field__input:focus,
  .buzzko-contact .text-area:focus {
    border-color: #E66C8C;
    outline: 2px solid rgba(230, 108, 140, 0.16);
    outline-offset: 1px;
    box-shadow: none;
  }

  .buzzko-contact .field__label {
    color: #77716D;
    font-size: 13px;
  }

  .buzzko-contact .text-area {
    min-height: 150px;
    resize: vertical;
  }

  .buzzko-contact .contact__button {
    margin-top: 8px;
  }

  .buzzko-contact .contact__button .button {
    min-height: 52px;
    padding: 0 30px;
    border: 0;
    border-radius: 10px;
    background: #1A1A1A;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    transition: background 0.2s ease, transform 0.2s ease;
    box-shadow: none !important;
  }

  .buzzko-contact .contact__button .button:hover {
    background: #E66C8C;
    color: #1A1A1A;
    transform: translateY(-2px);
    box-shadow: none !important;
  }

  .buzzko-contact .form__message {
    margin-bottom: 20px;
  }

  .buzzko-contact .form-status {
    color: #1A1A1A;
  }

  .buzzko-contact .form__message {
    padding: 14px 18px;
    border: 1px solid #F1D5DC;
    border-radius: 14px;
    background: #FDE9F1;
    margin-bottom: 20px;
    outline: none !important;
    box-shadow: none !important;
  }

  .buzzko-contact .form__message:focus,
  .buzzko-contact .form__message:focus-visible {
    outline: none !important;
    box-shadow: none !important;
  }

  @media screen and (max-width: 749px) {
    .buzzko-contact__layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .buzzko-contact__intro {
      padding-top: 0;
    }

    .buzzko-contact__heading {
      font-size: 42px;
      letter-spacing: -1.5px;
    }

    .buzzko-contact__description {
      font-size: 14px;
    }

    .buzzko-contact__note {
      margin-top: 22px;
    }

    .buzzko-contact__channels {
      grid-template-columns: 1fr;
    }

    .buzzko-contact__form-card {
      padding: 24px 18px;
      border-radius: 16px;
    }

    .buzzko-contact .contact__fields {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .buzzko-contact .contact__button .button {
      width: 100%;
    }
  }
{%- endstyle -%}

<div class="buzzko-contact">
  <div class="buzzko-contact__inner section-{{ section.id }}-padding">
    <div class="buzzko-contact__layout">
      <div class="buzzko-contact__intro">
        <span class="buzzko-contact__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </span>

        <h1 class="buzzko-contact__heading">
          {{ section.settings.heading }}
        </h1>

        <div class="buzzko-contact__description">
          {{ section.settings.description }}
        </div>

        <div class="buzzko-contact__note">
          <h3 class="buzzko-contact__note-title">
            {{ section.settings.note_title | escape }}
          </h3>
          <p class="buzzko-contact__note-text">
            {{ section.settings.note_text | escape }}
          </p>
        </div>

        <!-- WhatsApp & Instagram contact cards -->
        <div class="buzzko-contact__channels">
          <a
            class="buzzko-contact__channel-card"
            href="{{ section.settings.whatsapp_url }}"
            target="_blank"
            rel="noopener"
          >
            <span class="buzzko-contact__channel-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
            </span>
            <span class="buzzko-contact__channel-body">
              <span class="buzzko-contact__channel-title">
                {{ section.settings.whatsapp_title | escape }}
              </span>
              <span class="buzzko-contact__channel-text">
                {{ section.settings.channel_hours | escape }}
              </span>
            </span>
          </a>

          <a
            class="buzzko-contact__channel-card"
            href="{{ section.settings.instagram_url }}"
            target="_blank"
            rel="noopener"
          >
            <span class="buzzko-contact__channel-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/>
              </svg>
            </span>
            <span class="buzzko-contact__channel-body">
              <span class="buzzko-contact__channel-title">
                {{ section.settings.instagram_title | escape }}
              </span>
              <span class="buzzko-contact__channel-text">
                {{ section.settings.channel_hours | escape }}
              </span>
            </span>
          </a>
        </div>
      </div>

      <div class="buzzko-contact__form-card">
        <h2 class="buzzko-contact__form-title">
          {{ section.settings.form_title | escape }}
        </h2>
        <p class="buzzko-contact__form-subtitle">
          {{ section.settings.form_subtitle | escape }}
        </p>

        {%- liquid
          assign contact_form_class = 'isolate'
          if settings.animations_reveal_on_scroll
            assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
          endif
        -%}

        {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
          {%- if form.posted_successfully? -%}
            <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.post_success' | t }}
            </h2>
          {%- elsif form.errors -%}
            <div class="form__message">
              <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                {{- 'icon-error.svg' | inline_asset_content -}}
                {{ 'templates.contact.form.error_heading' | t }}
              </h2>
            </div>
            <ul class="form-status-list caption-large" role="list">
              <li>
                <a href="#ContactForm-email" class="link">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </a>
              </li>
            </ul>
          {%- endif -%}

          <div class="contact__fields">
            <div class="field">
              <input
                class="field__input"
                autocomplete="name"
                type="text"
                id="ContactForm-name"
                name="contact[{{ 'templates.contact.form.name' | t }}]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="{{ 'templates.contact.form.name' | t }}"
              >
              <label class="field__label" for="ContactForm-name">
                {{ 'templates.contact.form.name' | t }}
              </label>
            </div>

            <div class="field field--with-error">
              <input
                autocomplete="email"
                type="email"
                id="ContactForm-email"
                class="field__input"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="ContactForm-email-error"
                {% endif %}
                placeholder="{{ 'templates.contact.form.email' | t }}"
              >
              <label class="field__label" for="ContactForm-email">
                {{- 'templates.contact.form.email' | t }}
                <span aria-hidden="true">*</span>
              </label>

              {%- if form.errors contains 'email' -%}
                <small class="contact__field-error" id="ContactForm-email-error">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                  <span class="form__message">
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </span>
                </small>
              {%- endif -%}
            </div>
          </div>

          <div class="field">
            <input
              type="tel"
              id="ContactForm-phone"
              class="field__input"
              autocomplete="tel"
              name="contact[{{ 'templates.contact.form.phone' | t }}]"
              pattern="[0-9\-]*"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="{{ 'templates.contact.form.phone' | t }}"
            >
            <label class="field__label" for="ContactForm-phone">
              {{ 'templates.contact.form.phone' | t }}
            </label>
          </div>

          <div class="field">
            <textarea
              rows="6"
              id="ContactForm-body"
              class="text-area field__input"
              name="contact[{{ 'templates.contact.form.comment' | t }}]"
              placeholder="{{ 'templates.contact.form.comment' | t }}"
            >{{- form.body -}}</textarea>
            <label class="form__label field__label" for="ContactForm-body">
              {{ 'templates.contact.form.comment' | t }}
            </label>
          </div>

          <div class="contact__button">
            <button type="submit" class="button">
              {{ 'templates.contact.form.send' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BuzzKo Contact",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "WE'RE ALL EARS"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Let's talk <em>charms.</em>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Got a question, an idea, or just want to say hi? Drop us a message. We'd love to hear from you.</p>"
    },
    {
      "type": "text",
      "id": "note_title",
      "label": "Note heading",
      "default": "Need help with an order?"
    },
    {
      "type": "textarea",
      "id": "note_text",
      "label": "Note text",
      "default": "Include your order number in your message so we can help you faster."
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form heading",
      "default": "Send us a message"
    },
    {
      "type": "text",
      "id": "form_subtitle",
      "label": "Form subheading",
      "default": "Fill in the details below and we'll get back to you."
    },
    {
      "type": "header",
      "content": "Contact channels"
    },
    {
      "type": "text",
      "id": "channel_hours",
      "label": "Availability text (used on both cards)",
      "default": "Reach out to us 9am – 6pm"
    },
    {
      "type": "text",
      "id": "whatsapp_title",
      "label": "WhatsApp card title",
      "default": "Chat on WhatsApp"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "WhatsApp link"
    },
    {
      "type": "text",
      "id": "instagram_title",
      "label": "Instagram card title",
      "default": "DM us on Instagram"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "BuzzKo Contact"
    }
  ]
}
{% endschema %}