{% comment %}
  BuzzKo — Instagram
  Left: text + CTA. Right: vertical photo marquee (bottom → top),
  pauses on hover.
{% endcomment %}

<section id="buzzko-instagram-{{ section.id }}" class="buzzko-ig">
  <div class="buzzko-ig__panel">

    {%- comment -%} ========== LEFT: TEXT + CTA ========== {%- endcomment -%}
    <div class="buzzko-ig__text">

      {% if section.settings.eyebrow != blank %}
        <span class="buzzko-ig__eyebrow">
          <span class="buzzko-ig__eyebrow-dot"></span>
          {{ section.settings.eyebrow }}
        </span>
      {% endif %}

      <h2 class="buzzko-ig__heading">
        <span
          class="buzzko-ig__line buzzko-ig__line--one"
          style="color: {{ section.settings.first_line_color }};"
        >{{ section.settings.first_line }}</span>
        <span
          class="buzzko-ig__line buzzko-ig__line--two"
          style="color: {{ section.settings.second_line_color }};"
        >
          {{ section.settings.second_line }}
          <span class="buzzko-ig__sparkle" aria-hidden="true">✦</span>
        </span>
      </h2>

      {% if section.settings.subtext != blank %}
        <p class="buzzko-ig__subtext">
          {{ section.settings.subtext }}
        </p>
      {% endif %}

      {% if section.settings.instagram_url != blank %}
        <a
          href="{{ section.settings.instagram_url }}"
          class="buzzko-ig__cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="buzzko-ig__cta-icon">
            <defs>
              <linearGradient id="ig-grad-{{ section.id }}" x1="0" y1="1" x2="1" y2="0">
                <stop offset="0%" stop-color="#FEDA75"/>
                <stop offset="40%" stop-color="#FA7E1E"/>
                <stop offset="70%" stop-color="#D62976"/>
                <stop offset="100%" stop-color="#962FBF"/>
              </linearGradient>
            </defs>
            <rect x="2" y="2" width="20" height="20" rx="6" stroke="url(#ig-grad-{{ section.id }})" stroke-width="2"/>
            <circle cx="12" cy="12" r="4.2" stroke="url(#ig-grad-{{ section.id }})" stroke-width="2"/>
            <circle cx="17.5" cy="6.5" r="1.3" fill="#D62976"/>
          </svg>
          <span>{{ section.settings.cta_text | default: 'Follow us' }}</span>
        </a>
      {% endif %}

      {% if section.settings.social_proof != blank %}
        <div class="buzzko-ig__proof">
          <div class="buzzko-ig__proof-avatars">
            {% for i in (1..3) %}
              {%- assign key = 'avatar_' | append: i -%}
              {%- assign avatar = section.settings[key] -%}
              {% if avatar != blank %}
                <div class="buzzko-ig__proof-avatar">
                  {{ avatar | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
                </div>
              {% endif %}
            {% endfor %}
          </div>
          <span class="buzzko-ig__proof-text">{{ section.settings.social_proof }}</span>
        </div>
      {% endif %}

    </div>

    {%- comment -%} ========== RIGHT: VERTICAL MARQUEE ========== {%- endcomment -%}
    <div class="buzzko-ig__carousel" data-buzzko-ig-carousel>

      <div class="buzzko-ig__track" data-buzzko-ig-track>

        {%- comment -%}
          Two passes of the same set of blocks = seamless loop.
          Animation translates -50% (one full pass), then jumps back.
        {%- endcomment -%}
        {% for pass in (1..2) %}
          <div class="buzzko-ig__column" {% if pass == 2 %}aria-hidden="true"{% endif %}>
            {% for block in section.blocks %}
              <div class="buzzko-ig__media" {{ block.shopify_attributes }}>
                {% if block.settings.video != blank %}
                  {{
                    block.settings.video
                    | video_tag:
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      image_size: '600x'
                  }}
                {% elsif block.settings.image != blank %}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300,450,600,800',
                      sizes: '(min-width: 990px) 260px, 40vw',
                      class: 'buzzko-ig__img'
                  }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'buzzko-ig__placeholder' }}
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endfor %}

      </div>

    </div>

  </div>
</section>


<style>
  /* =====================================================
     BuzzKo Instagram — split panel with vertical marquee
  ===================================================== */

  #buzzko-instagram-{{ section.id }} {
    background: #FFFAF5;
    padding: 24px 0;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__panel {
    width: min(1400px, calc(100% - 64px));
    margin: 0 auto;

    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 56px;

    padding: 48px 56px;

    background: {{ section.settings.card_color | default: '#FFF0F8' }};
    border-radius: 28px;
    overflow: hidden;
  }


  /* =====================================================
     LEFT — text + CTA
  ===================================================== */

  #buzzko-instagram-{{ section.id }} .buzzko-ig__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;

    min-width: 0;
    padding-right: 16px;
  }


  /* Eyebrow badge */

  #buzzko-instagram-{{ section.id }} .buzzko-ig__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    margin-bottom: 22px;
    padding: 8px 16px 8px 12px;

    background: #fff;
    border: 1.5px solid rgba(26, 26, 26, 0.08);
    border-radius: 999px;

    color: #1A1A1A;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #FF60B9;
    box-shadow: 0 0 0 3px rgba(255, 96, 185, 0.2);
    animation: buzzkoIgPulse 2s ease-in-out infinite;
  }

  @keyframes buzzkoIgPulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(255, 96, 185, 0.2); }
    50%      { box-shadow: 0 0 0 6px rgba(255, 96, 185, 0); }
  }


  /* Heading */

  #buzzko-instagram-{{ section.id }} .buzzko-ig__heading {
    margin: 0;

    font-family: var(--font-heading-family);
    font-weight: 900;
    font-size: clamp(36px, 4.8vw, 64px);
    line-height: 1;
    letter-spacing: -0.035em;

    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__line {
    display: block;
  }

  /* Line 2 gets a slight italic + tighter kerning for personality */
  #buzzko-instagram-{{ section.id }} .buzzko-ig__line--two {
    font-style: italic;
    letter-spacing: -0.045em;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__sparkle {
    display: inline-block;
    margin-left: 8px;
    font-size: 0.55em;
    font-style: normal;
    font-weight: 400;
    vertical-align: top;
    transform: translateY(0.15em);
    color: #FF60B9;
    animation: buzzkoIgSpin 6s linear infinite;
  }

  @keyframes buzzkoIgSpin {
    from { transform: translateY(0.15em) rotate(0deg); }
    to   { transform: translateY(0.15em) rotate(360deg); }
  }


  /* Subtext — with a left accent bar */

  #buzzko-instagram-{{ section.id }} .buzzko-ig__subtext {
    position: relative;

    margin: 26px 0 0;
    padding-left: 18px;
    max-width: 460px;

    color: rgba(26, 26, 26, 0.68);
    font-size: 16px;
    line-height: 1.6;
    font-weight: 500;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__subtext::before {
    content: "";
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 3px;
    border-radius: 999px;
    background: #FF60B9;
  }


  /* CTA */

  #buzzko-instagram-{{ section.id }} .buzzko-ig__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    margin-top: 34px;
    padding: 16px 28px 16px 22px;

    background: #1A1A1A;
    color: #fff;
    text-decoration: none;

    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;

    box-shadow: 0 4px 0 rgba(26, 26, 26, 0.18);

    transition:
      background 220ms ease,
      transform 220ms cubic-bezier(0.34, 1.4, 0.5, 1),
      box-shadow 220ms ease;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__cta:hover {
    background: #333;
    transform: translateY(-3px);
    box-shadow: 0 7px 0 rgba(26, 26, 26, 0.18);
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__cta:active {
    transform: translateY(0);
    box-shadow: 0 2px 0 rgba(26, 26, 26, 0.18);
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__cta-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__cta-arrow {
    display: inline-block;
    font-size: 18px;
    line-height: 1;
    transition: transform 260ms cubic-bezier(0.34, 1.4, 0.5, 1);
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__cta:hover .buzzko-ig__cta-arrow {
    transform: translateX(4px);
  }


  /* Social proof — small avatars + text */

  #buzzko-instagram-{{ section.id }} .buzzko-ig__proof {
    display: flex;
    align-items: center;
    gap: 12px;

    margin-top: 26px;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__proof-avatars {
    display: flex;
    align-items: center;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__proof-avatar {
    width: 34px;
    height: 34px;

    margin-left: -10px;

    border-radius: 50%;
    border: 2.5px solid {{ section.settings.card_color | default: '#FFF0F8' }};
    background: #F0E6DF;

    overflow: hidden;
    flex-shrink: 0;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__proof-avatar:first-child {
    margin-left: 0;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__proof-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__proof-text {
    color: rgba(26, 26, 26, 0.68);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }


  /* =====================================================
     RIGHT — vertical marquee
  ===================================================== */

  #buzzko-instagram-{{ section.id }} .buzzko-ig__carousel {
    position: relative;

    width: 100%;
    height: 520px;

    overflow: hidden;

    border-radius: 20px;

    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 12%,
      #000 88%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      #000 12%,
      #000 88%,
      transparent 100%
    );
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__track {
    display: flex;
    flex-direction: column;
    gap: 16px;

    animation: buzzkoIgScrollUp 32s linear infinite;
    will-change: transform;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Pause on hover */
  #buzzko-instagram-{{ section.id }} .buzzko-ig__carousel:hover .buzzko-ig__track {
    animation-play-state: paused;
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__media {
    width: 100%;
    aspect-ratio: 4 / 5;

    overflow: hidden;
    border-radius: 14px;

    background: #F0E6DF;

    flex-shrink: 0;

    transition: transform 320ms cubic-bezier(0.34, 1.4, 0.5, 1);
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__media:hover {
    transform: scale(1.02);
  }

  #buzzko-instagram-{{ section.id }} .buzzko-ig__media img,
  #buzzko-instagram-{{ section.id }} .buzzko-ig__media video,
  #buzzko-instagram-{{ section.id }} .buzzko-ig__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes buzzkoIgScrollUp {
    from { transform: translateY(0); }
    to   { transform: translateY(calc(-50% - 8px)); }
  }


  /* =====================================================
     Reduced motion
  ===================================================== */

  @media (prefers-reduced-motion: reduce) {
    #buzzko-instagram-{{ section.id }} .buzzko-ig__track,
    #buzzko-instagram-{{ section.id }} .buzzko-ig__eyebrow-dot,
    #buzzko-instagram-{{ section.id }} .buzzko-ig__sparkle {
      animation: none;
    }
  }


  /* =====================================================
     TABLET
  ===================================================== */

  @media screen and (max-width: 989px) {
    #buzzko-instagram-{{ section.id }} .buzzko-ig__panel {
      width: min(100% - 40px, 700px);
      grid-template-columns: minmax(0, 1fr) 220px;
      gap: 32px;
      padding: 36px 32px;
      border-radius: 24px;
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__carousel {
      height: 420px;
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__heading {
      font-size: clamp(28px, 4vw, 42px);
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__subtext {
      font-size: 15px;
      margin-top: 20px;
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__cta {
      margin-top: 26px;
      padding: 14px 24px 14px 20px;
      font-size: 14px;
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__proof {
      margin-top: 20px;
    }
  }


  /* =====================================================
     MOBILE — stack: text on top, marquee below
  ===================================================== */

  @media screen and (max-width: 749px) {
    #buzzko-instagram-{{ section.id }} {
      padding: 16px 0;
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__panel {
      width: calc(100% - 24px);

      grid-template-columns: 1fr;
      gap: 28px;

      padding: 28px 22px 24px;
      border-radius: 20px;
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__text {
      padding-right: 0;
      align-items: flex-start;
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__eyebrow {
      margin-bottom: 18px;
      font-size: 11px;
      padding: 7px 14px 7px 10px;
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__heading {
      font-size: 34px;
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__subtext {
      font-size: 14px;
      margin-top: 18px;
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__cta {
      margin-top: 22px;
      padding: 14px 24px 14px 20px;
      font-size: 14px;
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__proof {
      margin-top: 22px;
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__carousel {
      height: 300px;
      border-radius: 16px;
    }

    #buzzko-instagram-{{ section.id }} .buzzko-ig__media {
      border-radius: 12px;
    }
  }
</style>


{% schema %}
{
  "name": "BuzzKo Instagram",
  "tag": "section",
  "class": "section",

  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Follow Along",
      "info": "Small label above the heading. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "first_line",
      "label": "Heading line 1",
      "default": "Real People"
    },
    {
      "type": "color",
      "id": "first_line_color",
      "label": "Line 1 color",
      "default": "#1A1A1A"
    },
    {
      "type": "text",
      "id": "second_line",
      "label": "Heading line 2",
      "default": "Cuter Lives."
    },
    {
      "type": "color",
      "id": "second_line_color",
      "label": "Line 2 color",
      "default": "#59C8F5"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Tag @buzzko.in in your photos — we'll reshare our favourites."
    },

    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Follow @buzzko.in"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },

    {
      "type": "header",
      "content": "Social proof"
    },
    {
      "type": "text",
      "id": "social_proof",
      "label": "Social proof text",
      "default": "Joined by 5,000+ happy customers",
      "info": "Small text next to avatars. Leave blank to hide."
    },
    {
      "type": "image_picker",
      "id": "avatar_1",
      "label": "Avatar 1"
    },
    {
      "type": "image_picker",
      "id": "avatar_2",
      "label": "Avatar 2"
    },
    {
      "type": "image_picker",
      "id": "avatar_3",
      "label": "Avatar 3"
    },

    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Panel background",
      "default": "#FFF0F8"
    }
  ],

  "blocks": [
    {
      "type": "media",
      "name": "Image or video",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Optional. Takes priority over the image."
        }
      ]
    }
  ],

  "max_blocks": 10,

  "presets": [
    {
      "name": "BuzzKo Instagram",
      "blocks": [
        { "type": "media" },
        { "type": "media" },
        { "type": "media" },
        { "type": "media" },
        { "type": "media" }
      ]
    }
  ]
}
{% endschema %}