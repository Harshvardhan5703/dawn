{% stylesheet %}
.bz-icon {
  --bz-ink: #3d2c4d;
  --bz-pink: #ffb3cd;
  --bz-yellow: #ffe08a;
  --bz-blue: #b8e2ff;
  --bz-mint: #c4f0d0;
  --bz-peach: #ffd2b0;
  display: inline-flex;
  width: 64px;
  height: 64px;
  flex: none;
  line-height: 0;
  filter: drop-shadow(0 4px 6px rgba(61, 44, 77, 0.12));
}
.bz-svg { width: 100%; height: 100%; overflow: visible; }
.bz-svg * { transform-box: view-box; }
.bz-s { stroke: var(--bz-ink); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }

/* ---------- 1. Clock ---------- */
.bz-clock { transform-origin: 32px 56px; }
.bz-bell-l { transform-origin: 14px 20px; }
.bz-bell-r { transform-origin: 50px 20px; }
.bz-hand-m { transform-origin: 32px 35px; }
.bz-hand-h { transform-origin: 32px 35px; }
.bz-icon.is-active .bz-clock { animation: bz-wiggle 1.1s ease-in-out both; }
.bz-icon.is-active .bz-bell-l { animation: bz-ring-l .18s ease-in-out 6 both; }
.bz-icon.is-active .bz-bell-r { animation: bz-ring-r .18s ease-in-out 6 both; }
.bz-icon.is-active .bz-hand-m { animation: bz-spin 1.1s cubic-bezier(.5, 0, .2, 1) both; }
.bz-icon.is-active .bz-hand-h { animation: bz-spin-slow 1.1s cubic-bezier(.5, 0, .2, 1) both; }
@keyframes bz-wiggle { 0%,100% { transform: rotate(0); } 15% { transform: rotate(-9deg); } 35% { transform: rotate(8deg); } 55% { transform: rotate(-6deg); } 75% { transform: rotate(4deg); } }
@keyframes bz-ring-l { 0%,100% { transform: rotate(0); } 50% { transform: rotate(-14deg); } }
@keyframes bz-ring-r { 0%,100% { transform: rotate(0); } 50% { transform: rotate(14deg); } }
@keyframes bz-spin { to { transform: rotate(360deg); } }
@keyframes bz-spin-slow { to { transform: rotate(60deg); } }

/* ---------- 2. Coin ---------- */
.bz-coin { transform-origin: 32px 29px; }
.bz-spark { transform-box: fill-box !important; transform-origin: center; transform: scale(0); }
.bz-icon.is-active .bz-coin { animation: bz-flip 1.2s cubic-bezier(.4, 0, .3, 1) both; }
.bz-icon.is-active .bz-spark-1 { animation: bz-pop .9s .35s ease-out both; }
.bz-icon.is-active .bz-spark-2 { animation: bz-pop .9s .5s ease-out both; }
.bz-icon.is-active .bz-spark-3 { animation: bz-pop .9s .65s ease-out both; }
@keyframes bz-flip {
  0% { transform: translateY(0) scaleX(1); }
  25% { transform: translateY(-7px) scaleX(.05); }
  50% { transform: translateY(-11px) scaleX(-1); }
  75% { transform: translateY(-5px) scaleX(-.05); }
  100% { transform: translateY(0) scaleX(1); }
}
@keyframes bz-pop { 0% { transform: scale(0) rotate(0); } 45% { transform: scale(1.3) rotate(45deg); } 100% { transform: scale(0) rotate(90deg); } }

/* ---------- 3. Box ---------- */
.bz-box { transform-origin: 30px 54px; }
.bz-badge { transform-origin: 48px 46px; }
.bz-icon.is-active .bz-box { animation: bz-shake .6s ease-in-out both; }
.bz-icon.is-active .bz-badge { animation: bz-badge .9s cubic-bezier(.3, 1.6, .5, 1) both; }
@keyframes bz-shake { 0%,100% { transform: translateX(0) rotate(0); } 20% { transform: translateX(-2.5px) rotate(-4deg); } 40% { transform: translateX(2.5px) rotate(4deg); } 60% { transform: translateX(-2px) rotate(-3deg); } 80% { transform: translateX(2px) rotate(2deg); } }
@keyframes bz-badge { 0% { transform: scale(1) rotate(0); } 35% { transform: scale(1.35) rotate(-18deg); } 70% { transform: scale(.92) rotate(10deg); } 100% { transform: scale(1) rotate(0); } }

/* ---------- 4. Swap ---------- */
.bz-swap { transform-origin: 32px 32px; }
.bz-swap-face { transform-origin: 32px 32px; }
.bz-icon.is-active .bz-swap { animation: bz-swap 1s cubic-bezier(.6, -.2, .3, 1.2) both; }
.bz-icon.is-active .bz-swap-face { animation: bz-bounce 1s ease-in-out both; }
@keyframes bz-swap { to { transform: rotate(180deg); } }
@keyframes bz-bounce { 0%,100% { transform: scale(1); } 40% { transform: scale(1.18) rotate(-8deg); } 70% { transform: scale(.94) rotate(6deg); } }

/* ---------- 5. Mail ---------- */
.bz-flap { transform-origin: 32px 21px; transition: transform .45s cubic-bezier(.3, 1.3, .5, 1); }
.bz-letter { transition: transform .6s .12s cubic-bezier(.34, 1.56, .64, 1); }
.bz-heart { transform-origin: 38px 53px; }
.bz-icon.is-active .bz-flap { transform: scaleY(-.6); }
.bz-icon.is-active .bz-letter { transform: translateY(-27px); }
.bz-icon.is-active .bz-heart { animation: bz-beat .7s .5s ease-in-out 2 both; }
@keyframes bz-beat { 0%,100% { transform: scale(1); } 50% { transform: scale(1.35); } }

/* ---------- 6. Keychain ---------- */
.bz-key-swing { transform-origin: 32px 19px; }
.bz-icon.is-active .bz-key-swing { animation: bz-swing 1.5s ease-in-out both; }
@keyframes bz-swing { 0%,100% { transform: rotate(0); } 15% { transform: rotate(16deg); } 35% { transform: rotate(-13deg); } 55% { transform: rotate(8deg); } 75% { transform: rotate(-4deg); } }

/* ---------- 7. Lighter ---------- */
.bz-flame { transform-origin: 32px 21px; transform: scale(.82); }
.bz-icon.is-active .bz-flame { animation: bz-flicker .45s ease-in-out 4 both; }
@keyframes bz-flicker {
  0%,100% { transform: scale(1, 1) skewX(0); }
  25% { transform: scale(.94, 1.14) skewX(-5deg); }
  50% { transform: scale(1.04, .96) skewX(4deg); }
  75% { transform: scale(.96, 1.1) skewX(-3deg); }
}

/* ---------- 8. Frame ---------- */
.bz-frame { transform-origin: 32px 6px; }
.bz-sun { transform-origin: 40px 31px; }
.bz-icon.is-active .bz-frame { animation: bz-tilt 1.3s ease-in-out both; }
.bz-icon.is-active .bz-sun { animation: bz-sun 1.3s ease-in-out both; }
@keyframes bz-tilt { 0%,100% { transform: rotate(0); } 20% { transform: rotate(-7deg); } 45% { transform: rotate(5deg); } 70% { transform: rotate(-3deg); } }
@keyframes bz-sun { 0%,100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-3px) rotate(180deg); } }

/* ---------- 9. Bulb ---------- */
.bz-bulb { transform-origin: 32px 57px; }
.bz-ray { transform-origin: 32px 26px; opacity: .35; }
.bz-icon.is-active .bz-bulb { animation: bz-hop .8s cubic-bezier(.3, 1.5, .5, 1) both; filter: drop-shadow(0 0 5px rgba(255, 200, 60, .85)); }
.bz-icon.is-active .bz-ray { animation: bz-ray .8s ease-out both; }
@keyframes bz-hop { 0%,100% { transform: scale(1); } 35% { transform: scale(1.1, .94); } 60% { transform: scale(.96, 1.08); } }
@keyframes bz-ray { 0% { opacity: .35; transform: scale(.75); } 50% { opacity: 1; transform: scale(1.18); } 100% { opacity: 1; transform: scale(1); } }

@media (prefers-reduced-motion: reduce) {
  .bz-icon *, .bz-icon.is-active * { animation: none !important; transition: none !important; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  if (window.__bzIconsInit) return;
  window.__bzIconsInit = true;

  var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  var io = null;

  function cardOf(icon) {
    return icon.closest('[data-bz-card]') || icon.parentElement;
  }

  function play(icon, ms) {
    icon.classList.remove('is-active');
    void icon.getBoundingClientRect(); // restart animations
    icon.classList.add('is-active');
    clearTimeout(icon.__bzT);
    icon.__bzT = setTimeout(function () { icon.classList.remove('is-active'); }, ms);
  }

  function setup(root) {
    (root || document).querySelectorAll('[data-bz-icon]:not([data-bz-ready])').forEach(function (icon) {
      icon.setAttribute('data-bz-ready', '');
      if (canHover) {
        var card = cardOf(icon);
        card.addEventListener('mouseenter', function () { play(icon, 1800); });
        card.addEventListener('focusin', function () { play(icon, 1800); });
      } else if ('IntersectionObserver' in window) {
        if (!io) {
          io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) play(e.target, 2200);
            });
          }, { threshold: 0.6 });
        }
        io.observe(icon);
      } else {
        icon.classList.add('is-active');
      }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { setup(); });
  else setup();
  document.addEventListener('shopify:section:load', function (e) { setup(e.target); });
})();
