{% comment %}
  Renders a header search modal. Should be used with 'header.liquid'

  Accepts:
  - input_id: {String} Id for the search input element (required)

  Usage:
  {% render 'header-search', input_id: 'My-Id'%}
{% endcomment %}

<style>
  /* BuzzKo header search modal */
  .header__search .search-modal {
    background: rgba(26, 26, 26, 0.28);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .header__search .search-modal__content {
    position: relative;
    padding: 22px max(24px, 5vw) 20px;
    background: #F9F7F2;
    border: 0;
    border-bottom: 1px solid rgba(26, 26, 26, 0.08);
    box-shadow: 0 12px 32px rgba(26, 26, 26, 0.10);
  }

  .header__search .search-modal__form {
    max-width: 760px;
    margin: 0 auto;
  }

  .header__search .search-modal__form .field {
    display: flex;
    align-items: center;
    min-height: 52px;
    overflow: hidden;
    background: #fff;
    border: 1.5px solid rgba(26, 26, 26, 0.16);
    border-radius: 12px;
    box-shadow: none;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .header__search .search-modal__form .field:focus-within {
    border-color: #D97C9D;
    box-shadow: 0 0 0 3px rgba(217, 124, 157, 0.12);
  }

  .header__search .search-modal__form .field::after,
  .header__search .search-modal__form .field::before {
    content: none;
    display: none;
  }

  .header__search .search-modal__form .search__input {
    min-width: 0;
    height: 52px;
    padding: 0 14px;
    color: #1A1A1A;
    background: transparent;
    border: 0;
    box-shadow: none;
    font-size: 14px;
    line-height: 1.4;
  }

  .header__search .search-modal__form .search__input:focus {
    outline: 0;
    box-shadow: none;
  }

  .header__search .search-modal__form .search__input::placeholder {
    color: rgba(26, 26, 26, 0.45);
    opacity: 1;
  }

  .header__search .search-modal__form .field__label {
    display: none;
  }

  .header__search .search-modal__form .field__button {
    position: static;
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    min-height: 42px;
    padding: 0;
    margin: 0 5px 0 0;
    color: rgba(26, 26, 26, 0.56);
    background: transparent;
    border: 0;
    border-radius: 9px;
    box-shadow: none;
    transition: color 140ms ease, background-color 140ms ease;
  }

  .header__search .search-modal__form .field__button:hover {
    color: #1A1A1A;
    background: rgba(217, 124, 157, 0.12);
  }

  .header__search .search-modal__form .field__button::before,
  .header__search .search-modal__form .field__button::after {
    content: none;
    display: none;
  }

  .header__search .search-modal__form .field__button .svg-wrapper,
  .header__search .search-modal__form .field__button svg {
    width: 17px;
    height: 17px;
  }

  .header__search .search-modal__close-button {
    top: 22px;
    right: max(16px, 2vw);
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    padding: 0;
    color: rgba(26, 26, 26, 0.58);
    background: rgba(26, 26, 26, 0.045);
    border-radius: 50%;
    transition: color 140ms ease, background-color 140ms ease;
  }

  .header__search .search-modal__close-button:hover {
    color: #1A1A1A;
    background: rgba(217, 124, 157, 0.14);
  }

  .header__search .search-modal__close-button .svg-wrapper,
  .header__search .search-modal__close-button svg {
    width: 15px;
    height: 15px;
  }

  .header__search .predictive-search--header {
    margin-top: 10px;
    background: transparent;
    border: 0;
    box-shadow: none;
  }

  @media screen and (max-width: 749px) {
    .header__search .search-modal__content {
      padding: 14px 14px 16px;
    }

    .header__search .search-modal__form {
      max-width: none;
      margin-right: 42px;
    }

    .header__search .search-modal__form .field,
    .header__search .search-modal__form .search__input {
      min-height: 46px;
      height: 46px;
    }

    .header__search .search-modal__form .search__input {
      padding: 0 11px;
      font-size: 13px;
    }

    .header__search .search-modal__form .field__button {
      flex-basis: 36px;
      width: 36px;
      height: 36px;
      min-height: 36px;
    }

    .header__search .search-modal__close-button {
      top: 19px;
      right: 10px;
      width: 32px;
      height: 32px;
      min-width: 32px;
      min-height: 32px;
    }
  }
</style>

<details-modal class="header__search">
  <details>
    <summary
      class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle"
      aria-haspopup="dialog"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <span>
        <span class="svg-wrapper">
          {{- 'icon-search.svg' | inline_asset_content -}}
        </span>
        <span class="svg-wrapper header__icon-close">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </span>
    </summary>
    <div
      class="search-modal modal__content gradient"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <div class="modal-overlay"></div>
      <div
        class="search-modal__content{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} search-modal__content-top{% else %} search-modal__content-bottom{% endif %}"
        tabindex="-1"
      >
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="search-modal__form">
        {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
          <div class="field">
            <input
              class="search__input field__input"
              id="{{ input_id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="Search charms, frames, and little favourites..."
              {%- if settings.predictive_search_enabled -%}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {%- endif -%}
            >
            <label class="field__label" for="{{ input_id }}">{{ 'general.search.search' | t }}</label>
            <input type="hidden" name="options[prefix]" value="last">
            <button
              type="reset"
              class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
              aria-label="{{ 'general.search.reset' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-reset.svg' | inline_asset_content -}}
              </span>
            </button>
            <button class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
              <span class="svg-wrapper">
                {{- 'icon-search.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
              {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
            </div>

            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
        </form>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}
        <button
          type="button"
          class="search-modal__close-button modal__close-button link link--text focus-inset"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
    </div>
  </details>
</details-modal>
