{% doc %}
  @prompt
    Create a visually rich and vibrant Track Order page section for a gift and accessories brand called Buzzko. The section should have a fun, modern aesthetic with colorful icons or emoji, a bold heading like "Where's My Order? 📦", a brief description, and a prominent order tracking input field where customers can enter their order number or tracking ID and submit. Style it with vibrant or pastel background colors, rounded elements, and good spacing. Make it feel lively and on-brand — not just a plain form on a white background.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-track-order-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 10 auto;
    padding: 48px 24px;
    box-sizing: border-box;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    border-radius: 28px;
  }

  .ai-track-order-{{ ai_gen_id }}__inner {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    padding: 42px 32px;
    text-align: center;
    background: {{ block.settings.card_color }};
    border-radius: 24px;
    box-shadow: 0 12px 35px rgba(30, 26, 48, 0.10);
  }

  .ai-track-order-{{ ai_gen_id }}__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 76px;
    height: 76px;
    margin: 0 auto 16px;
    border-radius: 24px;
    background: {{ block.settings.accent_color }};
    box-shadow: 0 6px 14px rgba(30, 26, 48, 0.10);
    line-height: 1;
  }

  .ai-track-order-{{ ai_gen_id }}__icon .bzt-svg {
    width: 58px;
    height: 58px;
  }

  .ai-track-order-{{ ai_gen_id }}__heading {
    margin: 0 0 12px;
    color: {{ block.settings.text_color }};
    font-size: clamp(30px, 5vw, 48px);
    line-height: 1.12;
  }

  .ai-track-order-{{ ai_gen_id }}__description {
    max-width: 560px;
    margin: 0 auto 28px;
    color: {{ block.settings.text_color }};
    font-size: 17px;
    line-height: 1.55;
  }

  .ai-track-order-{{ ai_gen_id }}__form {
    display: flex;
    gap: 10px;
    max-width: 590px;
    margin: 0 auto;
  }

  .ai-track-order-{{ ai_gen_id }}__input {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 58px;
    padding: 14px 18px;
    border: 2px solid {{ block.settings.input_border_color }};
    border-radius: 14px;
    background: #ffffff;
    color: #202020;
    font: inherit;
    font-size: 16px;
  }

  .ai-track-order-{{ ai_gen_id }}__input::placeholder {
    color: #595959;
    opacity: 1;
  }

  .ai-track-order-{{ ai_gen_id }}__input:focus-visible,
  .ai-track-order-{{ ai_gen_id }}__button:focus-visible,
  .ai-track-order-{{ ai_gen_id }}__help-link:focus-visible,
  .ai-track-order-{{ ai_gen_id }}__order-id-link:focus-visible {
    outline: 3px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  .ai-track-order-{{ ai_gen_id }}__button {
    flex: 0 0 auto;
    min-height: 58px;
    padding: 14px 24px;
    border: 0;
    border-radius: 14px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font: inherit;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
  }

  .ai-track-order-{{ ai_gen_id }}__button:hover {
    filter: brightness(0.92);
  }

  .ai-track-order-{{ ai_gen_id }}__hint {
    margin: 16px 0 0;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-track-order-{{ ai_gen_id }}__order-id-link {
    display: inline-block;
    margin-top: 10px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    text-underline-offset: 3px;
    opacity: 0.85;
  }

  .ai-track-order-{{ ai_gen_id }}__help-link {
    display: inline-block;
    margin-top: 12px;
    color: {{ block.settings.text_color }};
    font-weight: 700;
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 600px) {
    .ai-track-order-{{ ai_gen_id }} {
      padding: 24px 14px;
      border-radius: 20px;
    }

    .ai-track-order-{{ ai_gen_id }}__inner {
      padding: 32px 20px;
      border-radius: 18px;
    }

    .ai-track-order-{{ ai_gen_id }}__form {
      flex-direction: column;
    }

    .ai-track-order-{{ ai_gen_id }}__button {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-track-order-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-track-order-{{ ai_gen_id }}__inner" data-bzt-card>
    <div class="ai-track-order-{{ ai_gen_id }}__icon bzt-icon" data-bzt-icon aria-hidden="true">
      <svg class="bzt-svg" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <g class="bzt-lines" stroke="#3d2c4d" stroke-width="2.5" stroke-linecap="round">
          <path d="M3 40 H9"/>
          <path d="M1 47 H8"/>
          <path d="M4 54 H9"/>
        </g>
        <g class="bzt-pin">
          <path d="M32 3 C27 3 23.5 6.8 23.5 11.3 C23.5 17 32 23 32 23 C32 23 40.5 17 40.5 11.3 C40.5 6.8 37 3 32 3 Z" fill="#ff8fa6" stroke="#3d2c4d" stroke-width="2.5" stroke-linejoin="round"/>
          <circle cx="32" cy="11" r="3" fill="#fff"/>
        </g>
        <ellipse class="bzt-shadow" cx="32" cy="60" rx="17" ry="2.6" fill="#3d2c4d" opacity=".14"/>
        <g class="bzt-box">
          <rect x="13" y="35" width="38" height="24" rx="5" fill="#ffd9a8" stroke="#3d2c4d" stroke-width="2.5" stroke-linejoin="round"/>
          <rect x="10" y="27" width="44" height="11" rx="4" fill="#ffbf8e" stroke="#3d2c4d" stroke-width="2.5" stroke-linejoin="round"/>
          <rect x="28" y="27" width="8" height="11" fill="#ffb3cd" stroke="#3d2c4d" stroke-width="2.5" stroke-linejoin="round"/>
          <circle cx="24" cy="46" r="2" fill="#3d2c4d"/>
          <circle cx="40" cy="46" r="2" fill="#3d2c4d"/>
          <ellipse cx="19.5" cy="50.5" rx="2.8" ry="1.9" fill="#ffb3cd" opacity=".9"/>
          <ellipse cx="44.5" cy="50.5" rx="2.8" ry="1.9" fill="#ffb3cd" opacity=".9"/>
          <path d="M28.6 50 Q32 53 35.4 50" fill="none" stroke="#3d2c4d" stroke-width="2" stroke-linecap="round"/>
        </g>
        <g transform="translate(54 30)"><path class="bzt-spark" d="M0 -5 Q0 0 5 0 Q0 0 0 5 Q0 0 -5 0 Q0 0 0 -5Z" fill="#ffe08a" stroke="#3d2c4d" stroke-width="1.5" stroke-linejoin="round"/></g>
      </svg>
    </div>
    <h2 class="ai-track-order-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    <div class="ai-track-order-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>

    <form class="ai-track-order-{{ ai_gen_id }}__form" id="buzzko-track-form-{{ ai_gen_id }}">
      <label class="visually-hidden" for="ai-track-input-{{ ai_gen_id }}">{{ block.settings.input_label | escape }}</label>
      <input
        id="ai-track-input-{{ ai_gen_id }}"
        class="ai-track-order-{{ ai_gen_id }}__input"
        type="text"
        name="tracking_id"
        placeholder="{{ block.settings.input_placeholder | escape }}"
        autocomplete="off"
        required
      >
      <button class="ai-track-order-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label | escape }}</button>
    </form>

    {% if block.settings.hint != blank %}<p class="ai-track-order-{{ ai_gen_id }}__hint">{{ block.settings.hint | escape }}</p>{% endif %}

    {% if block.settings.order_id_link_label != blank %}
      <a class="ai-track-order-{{ ai_gen_id }}__order-id-link" href="{{ block.settings.tracking_base_url | default: 'https://buzzko.shiprocket.co/tracking' }}">
        {{ block.settings.order_id_link_label | escape }}
      </a>
    {% endif %}

    {% if block.settings.help_link != blank %}<a class="ai-track-order-{{ ai_gen_id }}__help-link" href="{{ block.settings.help_link }}">{{ block.settings.help_label | escape }}</a>{% endif %}
  </div>
</div>

<script>
(function() {
  var form = document.getElementById('buzzko-track-form-{{ ai_gen_id }}');
  if (!form) return;

  form.addEventListener('submit', function(event) {
    event.preventDefault();
    var input = document.getElementById('ai-track-input-{{ ai_gen_id }}');
    var trackingId = input ? input.value.trim().replace(/^#/, '') : '';
    if (!trackingId) return;

    var base = '{{ block.settings.tracking_base_url | default: "https://buzzko.shiprocket.co/tracking" }}';
    base = base.replace(/\/+$/, ''); // strip any trailing slash
    window.location.href = base + '/' + encodeURIComponent(trackingId);
  });
})();
</script>

{% stylesheet %}
  .bzt-svg { overflow: visible; }
  .bzt-svg * { transform-box: view-box; }
  .bzt-lines { opacity: .0; }
  .bzt-spark { transform-box: fill-box !important; transform-origin: center; transform: scale(0); }
  .bzt-box { transform-origin: 32px 59px; }
  .bzt-shadow { transform-origin: 32px 60px; }
  .bzt-pin { transform-origin: 32px 23px; }

  .bzt-icon.is-active .bzt-box { animation: bzt-hop 1.1s cubic-bezier(.3, 1.2, .5, 1) both; }
  .bzt-icon.is-active .bzt-shadow { animation: bzt-shadow 1.1s ease-in-out both; }
  .bzt-icon.is-active .bzt-pin { animation: bzt-pin 1.1s ease-in-out both; }
  .bzt-icon.is-active .bzt-lines { animation: bzt-lines 1.1s ease-out both; }
  .bzt-icon.is-active .bzt-spark { animation: bzt-pop .9s .4s ease-out both; }

  @keyframes bzt-hop {
    0% { transform: translateY(0) scale(1, 1); }
    18% { transform: translateY(0) scale(1.1, .88); }
    45% { transform: translateY(-9px) scale(.94, 1.08); }
    72% { transform: translateY(0) scale(1.08, .92); }
    100% { transform: translateY(0) scale(1, 1); }
  }
  @keyframes bzt-shadow { 0%,100% { transform: scale(1); opacity: .14; } 45% { transform: scale(.72); opacity: .07; } }
  @keyframes bzt-pin {
    0%,100% { transform: translateY(0) rotate(0); }
    30% { transform: translateY(-5px) rotate(-8deg); }
    55% { transform: translateY(1px) rotate(6deg); }
    80% { transform: translateY(-2px) rotate(-3deg); }
  }
  @keyframes bzt-lines { 0% { opacity: 0; transform: translateX(-5px); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateX(3px); } }
  @keyframes bzt-pop { 0% { transform: scale(0) rotate(0); } 45% { transform: scale(1.3) rotate(45deg); } 100% { transform: scale(0) rotate(90deg); } }

  @media (prefers-reduced-motion: reduce) {
    .bzt-icon *, .bzt-icon.is-active * { animation: none !important; }
  }
{% endstylesheet %}

{% javascript %}
(function () {
  if (window.__bztInit) return;
  window.__bztInit = true;

  var canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  var io = null;

  function play(icon, ms) {
    icon.classList.remove('is-active');
    void icon.getBoundingClientRect();
    icon.classList.add('is-active');
    clearTimeout(icon.__bztT);
    icon.__bztT = setTimeout(function () { icon.classList.remove('is-active'); }, ms);
  }

  function setup(root) {
    (root || document).querySelectorAll('[data-bzt-icon]:not([data-bzt-ready])').forEach(function (icon) {
      icon.setAttribute('data-bzt-ready', '');
      if (canHover) {
        var card = icon.closest('[data-bzt-card]') || icon.parentElement;
        card.addEventListener('mouseenter', function () { play(icon, 1500); });
        card.addEventListener('focusin', function () { play(icon, 1500); });
      } else if ('IntersectionObserver' in window) {
        if (!io) {
          io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) play(e.target, 1800); });
          }, { threshold: 0.6 });
        }
        io.observe(icon);
      } else {
        icon.classList.add('is-active');
      }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { setup(); });
  else setup();
  document.addEventListener('shopify:section:load', function (e) { setup(e.target); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Buzzko track order",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where's my order?" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Your latest little treasure is on its way. Enter your AWB tracking number below to follow its journey.</p>" },
    { "type": "text", "id": "input_label", "label": "Input label for accessibility", "default": "AWB tracking number" },
    { "type": "text", "id": "input_placeholder", "label": "Input placeholder", "default": "Enter your AWB tracking number" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Track my order" },
    { "type": "text", "id": "hint", "label": "Form note", "default": "Your AWB number is in your shipping confirmation email or SMS." },
    { "type": "text", "id": "order_id_link_label", "label": "Order ID fallback link label", "default": "Have an Order ID instead? Track with order details →" },
    { "type": "url", "id": "help_link", "label": "Help link" },
    { "type": "text", "id": "help_label", "label": "Help link label", "default": "Need a hand? Contact us" },
    { "type": "header", "content": "Tracking destination" },
    { "type": "text", "id": "tracking_base_url", "label": "Shiprocket tracking base URL", "default": "https://buzzko.shiprocket.co/tracking", "info": "The AWB is appended to this URL as /{AWB}. Also used as the destination for the 'Order ID' fallback link." },
    { "type": "header", "content": "Colors and layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Outer background", "default": "#FFE6D6" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#FFF9F2" },
    { "type": "color", "id": "accent_color", "label": "Accent background", "default": "#FFD166" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#222222" },
    { "type": "color", "id": "input_border_color", "label": "Input border", "default": "#7A3E9D" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#7A3E9D" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "Buzzko track order" }
  ],
  "tag": null,
  "class": "buzzko-track-order-block"
}
{% endschema %}