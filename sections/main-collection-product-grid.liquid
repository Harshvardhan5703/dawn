<script>
(function () {
  var root = document.getElementById('ProductGridContainer');
  if (!root || root.dataset.buzzkoAtcInit === 'true') return;
  root.dataset.buzzkoAtcInit = 'true';

  var ROOT = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

  /* ---------- helpers ---------- */

  function state(button, value) {
    if (value) button.setAttribute('data-state', value);
    else button.removeAttribute('data-state');
  }

  function pick(html, selector) {
    if (!html) return null;
    return new DOMParser().parseFromString(html, 'text/html').querySelector(selector);
  }

  function renderSections(sections) {
    if (!sections) return;

    var drawer = document.querySelector('cart-drawer');
    if (drawer && sections['cart-drawer']) {
      var currentInner = drawer.querySelector('.drawer__inner');
      var freshInner = pick(sections['cart-drawer'], '.drawer__inner');
      if (currentInner && freshInner) {
        currentInner.innerHTML = freshInner.innerHTML;
      }
    }

    if (sections['cart-icon-bubble']) {
      var oldBubble = document.querySelector('.cart-count-bubble');
      var host =
        document.getElementById('cart-icon-bubble') ||
        (oldBubble && oldBubble.parentElement);

      if (host) {
        var newBubble = pick(sections['cart-icon-bubble'], '.cart-count-bubble');
        if (newBubble) {
          if (oldBubble) oldBubble.replaceWith(newBubble);
          else host.appendChild(newBubble);
        } else if (oldBubble) {
          oldBubble.remove();
        }
      }
    }
  }

  function updateCounts(cart) {
    if (!cart || typeof cart.item_count !== 'number') return;
    document.querySelectorAll('[data-cart-count], .cart-count').forEach(function (el) {
      var next = String(cart.item_count);
      if (el.textContent !== next) el.textContent = next;
    });
  }

  function openDrawer() {
    var drawer = document.querySelector('cart-drawer');
    if (drawer && typeof drawer.open === 'function') {
      try { drawer.open(); } catch (e) { /* noop */ }
    }
  }

  /* ---------- MODAL LOGIC ---------- */

  var modal = document.getElementById('buzzko-variant-modal');
  var modalImg = document.getElementById('buzzko-modal-img');
  var modalTitle = document.getElementById('buzzko-modal-title');
  var modalPrice = document.getElementById('buzzko-modal-price');
  var modalVariants = document.getElementById('buzzko-modal-variants');
  var modalAddBtn = document.getElementById('buzzko-modal-add');
  var modalCloseBtn = document.getElementById('buzzko-modal-close');
  
  var selectedVariantId = null;

  function openVariantModal(productTitle, defaultImage, variantsJson) {
    var variants = JSON.parse(variantsJson);
    modalTitle.textContent = productTitle;
    modalImg.src = defaultImage || '';
    modalVariants.innerHTML = '';
    selectedVariantId = null;

    var firstAvailableBtn = null;

    variants.forEach(function(v) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'buzzko-modal-variant-btn';
      btn.textContent = v.title;
      
      if (!v.available) {
        btn.disabled = true;
      } else if (!firstAvailableBtn) {
        firstAvailableBtn = btn;
      }

      btn.dataset.variantId = v.id;
      btn.dataset.image = v.image || defaultImage;
      btn.dataset.price = v.price;

      btn.addEventListener('click', function() {
        modalVariants.querySelectorAll('.buzzko-modal-variant-btn').forEach(function(b) {
          b.classList.remove('is-active');
        });
        btn.classList.add('is-active');
        
        if (btn.dataset.image) {
          modalImg.src = btn.dataset.image;
        }
        
        selectedVariantId = btn.dataset.variantId;
        modalPrice.innerHTML = btn.dataset.price;
        
        modalAddBtn.disabled = false;
        modalAddBtn.textContent = 'Add to Cart';
      });

      modalVariants.appendChild(btn);
    });

    if (firstAvailableBtn) {
      firstAvailableBtn.click();
    } else {
      modalPrice.innerHTML = '';
      modalAddBtn.disabled = true;
      modalAddBtn.textContent = 'Sold Out';
    }

    if (typeof modal.showModal === 'function') {
      modal.showModal();
    } else {
      modal.setAttribute('open', '');
    }
  }

  function closeModal() {
    if (typeof modal.close === 'function') {
      modal.close();
    } else {
      modal.removeAttribute('open');
    }
    selectedVariantId = null;
  }

  modalCloseBtn.addEventListener('click', closeModal);
  
  // Close on backdrop click
  modal.addEventListener('click', function(e) {
    if (e.target === modal) closeModal();
  });

  /* ---------- MODAL ADD TO CART ---------- */
  modalAddBtn.addEventListener('click', function() {
    if (!selectedVariantId) return;

    modalAddBtn.textContent = 'Adding...';
    modalAddBtn.disabled = true;

    var data = new FormData();
    data.append('id', selectedVariantId);
    data.append('quantity', 1);
    data.append('sections', 'cart-drawer,cart-icon-bubble');
    data.append('sections_url', window.location.pathname);

    fetch(ROOT + 'cart/add.js', {
      method: 'POST',
      headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: data
    })
    .then(function(res) {
      return res.json().then(function(json) {
        if (!res.ok) throw json;
        return json;
      });
    })
    .then(function(added) {
      renderSections(added.sections);
      return fetch(ROOT + 'cart.js', { headers: { 'Accept': 'application/json' } })
        .then(function(res) { return res.json(); })
        .then(function(cart) { updateCounts(cart); openDrawer(); });
    })
    .then(function() {
      modalAddBtn.textContent = 'Added ✓';
      setTimeout(function() {
        closeModal();
      }, 600);
    })
    .catch(function(err) {
      console.error('[BuzzKo Modal ATC]', err);
      modalAddBtn.textContent = 'Try Again';
      modalAddBtn.disabled = false;
    });
  });

  /* ---------- MAIN CARD HANDLER ---------- */

  root.addEventListener('click', function(event) {
    var button = event.target.closest('.buzzko-product-card__atc');
    if (button && !button.disabled) {
      if (button.dataset.hasVariants === 'true') {
        event.preventDefault(); // Stop form submission
        openVariantModal(
          button.dataset.productTitle,
          button.dataset.productImage,
          button.dataset.variants
        );
      }
    }
  });

  root.addEventListener('submit', function (event) {
    var form = event.target;
    if (!form.matches('[data-buzzko-atc]')) return;

    event.preventDefault();

    var button = form.querySelector('.buzzko-product-card__atc');
    if (!button || button.disabled || button.dataset.state === 'loading') return;

    // If it has variants, the submit shouldn't happen directly. The click handler above prevents it.
    if (button.dataset.hasVariants === 'true') return;

    state(button, 'loading');
    button.disabled = true;

    var data = new FormData(form);
    data.append('sections', 'cart-drawer,cart-icon-bubble');
    data.append('sections_url', window.location.pathname);

    fetch(ROOT + 'cart/add.js', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: data
    })
      .then(function (res) {
        return res.json().then(function (json) {
          if (!res.ok) throw json;
          return json;
        });
      })
      .then(function (added) {
        renderSections(added.sections);

        return fetch(ROOT + 'cart.js', {
          headers: { 'Accept': 'application/json' }
        })
          .then(function (res) { return res.json(); })
          .then(function (cart) {
            updateCounts(cart);
            openDrawer();
          });
      })
      .then(function () {
        state(button, 'success');

        setTimeout(function () {
          state(button, '');
          button.disabled = false;
        }, 600); // Snappy feedback
      })
      .catch(function (error) {
        console.error('[BuzzKo ATC]', error);
        state(button, '');
        button.disabled = false;
      });
  });
})();
</script>

<script>
/* ============================================================
   BuzzKo: Filter caret spacing fixer
   ============================================================ */
(function () {
  function fixCarets() {
    document.querySelectorAll('.facets__summary').forEach(function (summary) {
      var labelSpan = summary.querySelector('span');
      var caret = summary.querySelector('svg, .icon-caret, .svg-wrapper');

      if (caret) {
        caret.style.setProperty('margin-left', '10px', 'important');
        caret.style.setProperty('margin-inline-start', '10px', 'important');
        caret.style.setProperty('flex-shrink', '0', 'important');
      }
      if (labelSpan && labelSpan !== caret) {
        labelSpan.style.setProperty('margin-right', '6px', 'important');
      }
      var inner = summary.querySelector('div, span');
      if (inner && inner.contains(caret)) {
        inner.style.setProperty('display', 'inline-flex', 'important');
        inner.style.setProperty('align-items', 'center', 'important');
        inner.style.setProperty('gap', '10px', 'important');
      }
    });
  }

  fixCarets();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fixCarets);
  } else {
    fixCarets();
  }
  window.addEventListener('load', fixCarets);
  setTimeout(fixCarets, 400);
  setTimeout(fixCarets, 1200);

  if (window.MutationObserver) {
    var scheduled = false;
    new MutationObserver(function () {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(function () { scheduled = false; fixCarets(); });
    }).observe(document.body, { childList: true, subtree: true });
  }
  document.addEventListener('shopify:section:load', fixCarets);
})();
</script>

