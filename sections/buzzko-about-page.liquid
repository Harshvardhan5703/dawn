{% comment %}
  BuzzKo About Page
  Single image, newspaper-style text wrap.
{% endcomment %}

<section id="buzzko-about-{{ section.id }}" class="buzzko-about">
  <div class="buzzko-about__hero page-width">
    {% if section.settings.hero_eyebrow != blank %}
      <p class="buzzko-about__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
    {% endif %}
    <h1 class="buzzko-about__hero-title">{{ section.settings.hero_title | escape | newline_to_br }}</h1>
    <span class="buzzko-about__squiggle" aria-hidden="true"></span>
  </div>

  <div class="buzzko-about__story page-width">
    <div class="buzzko-about__story-content">
      {% if section.settings.story_image != blank %}
        <figure class="buzzko-about__float-figure">
          {{
            section.settings.story_image
            | image_url: width: 1200
            | image_tag:
              class: 'buzzko-about__float-image',
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              alt: section.settings.story_image.alt | default: 'BuzzKo'
          }}
          <span class="buzzko-about__story-tape" aria-hidden="true"></span>
        </figure>
      {% else %}
        <figure class="buzzko-about__float-figure buzzko-about__float-figure--empty">
          <div class="buzzko-about__image-placeholder">
            <span>Add a story image in the section settings</span>
          </div>
        </figure>
      {% endif %}

      <div class="buzzko-about__body">
        {{ section.settings.story_content }}
      </div>
    </div>
  </div>

  <div class="buzzko-about__newsletter-wrap">
    <div class="buzzko-about__newsletter page-width">
      <div class="buzzko-about__newsletter-icon" aria-hidden="true">
        <svg viewBox="0 0 64 52" role="presentation" focusable="false">
          <path d="M5 15.5 31.5 34 59 15.5M8 12h48a4 4 0 0 1 4 4v29a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V16a4 4 0 0 1 4-4Z"
            fill="none" stroke="currentColor" stroke-width="2.8"
            stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M32 4c-3.8-5.4-12.8-1.6-9.8 5.2 1.7 3.9 9.8 9.1 9.8 9.1s8.1-5.2 9.8-9.1C44.8 2.4 35.8-1.4 32 4Z"
            fill="#F06C91" stroke="currentColor" stroke-width="1.8"/>
        </svg>
      </div>

      <div class="buzzko-about__newsletter-copy">
        <h2>{{ section.settings.newsletter_title | escape }}</h2>
        <p>{{ section.settings.newsletter_text | escape }}</p>
      </div>

      <div class="buzzko-about__newsletter-form">
        {% form 'customer', id: 'BuzzkoAboutNewsletter', class: 'buzzko-about__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <label class="visually-hidden" for="BuzzkoAboutEmail-{{ section.id }}">
            Email address
          </label>

          <input
            id="BuzzkoAboutEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ section.settings.email_placeholder | escape }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            required
          >

          <button
            type="submit"
            aria-label="{{ section.settings.newsletter_button_label | escape }}"
          >
            <span aria-hidden="true">→</span>
          </button>

          {% if form.posted_successfully? %}
            <p class="buzzko-about__form-message" role="status">
              {{ section.settings.success_message | escape }}
            </p>
          {% endif %}

          {% if form.errors %}
            <div class="buzzko-about__form-message" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</section>

<style>
  #buzzko-about-{{ section.id }} {
    --buzzko-cream: #FFFAF5;
    --buzzko-pink: #f06c91;
    --buzzko-ink: #1a1a1a;
    --buzzko-muted: #514e4a;
    --buzzko-line: #e9e2db;
    background: var(--buzzko-cream);
    color: var(--buzzko-ink);
    overflow: hidden;
  }

  #buzzko-about-{{ section.id }} .page-width {
    width: min(100% - 48px, 1320px);
    margin-inline: auto;
  }

  /* HERO */

  #buzzko-about-{{ section.id }} .buzzko-about__hero {
    padding-block: 54px 40px;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__eyebrow {
    margin: 0 0 12px;
    color: var(--buzzko-pink);
    font-size: 13px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__hero-title {
    margin: 0;
    max-width: 720px;
    color: var(--buzzko-ink);
    font-size: clamp(42px, 5.5vw, 76px);
    font-weight: 800;
    letter-spacing: -.045em;
    line-height: 1.04;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__squiggle {
    display: block;
    width: 104px;
    height: 13px;
    margin: 22px 0 0;
    border-top: 5px solid var(--buzzko-pink);
    border-radius: 50%;
    transform: rotate(-2deg);
  }

  /* STORY — newspaper-style float */

  #buzzko-about-{{ section.id }} .buzzko-about__story {
    padding-block: 24px 56px;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__story-content {
    max-width: 900px;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__story-content::after {
    content: "";
    display: table;
    clear: both;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__float-figure {
    float: right;
    width: min(42%, 400px);
    margin: 8px 0 24px 32px;
    position: relative;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__float-image {
    display: block;
    width: 100%;
    height: auto;
    border: 8px solid #fffdfa;
    border-radius: 4px;
    box-shadow: 0 9px 24px rgba(26, 26, 26, .13);
    transform: rotate(2deg);
  }

  #buzzko-about-{{ section.id }} .buzzko-about__story-tape {
    position: absolute;
    z-index: 2;
    top: -8px;
    left: 20%;
    width: 90px;
    height: 22px;
    background: repeating-linear-gradient(
      90deg,
      #f6b8c8 0 13px,
      #fff0f3 13px 26px
    );
    opacity: .9;
    transform: rotate(-8deg);
  }

  #buzzko-about-{{ section.id }} .buzzko-about__float-figure--empty {
    margin-bottom: 24px;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__image-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1.1 / 1;
    padding: 24px;
    border: 2px dashed #e5cbd2;
    border-radius: 10px;
    background: #fff;
    color: #77716b;
    text-align: center;
    font-size: 14px;
  }

  /* BODY TEXT */

  #buzzko-about-{{ section.id }} .buzzko-about__body {
    color: var(--buzzko-muted);
    font-size: 15px;
    line-height: 1.75;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__body h3 {
    margin: 32px 0 12px;
    color: var(--buzzko-ink);
    font-size: clamp(22px, 2.2vw, 27px);
    font-weight: 800;
    letter-spacing: -.02em;
    line-height: 1.25;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__body h3:first-child {
    margin-top: 0;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__body p {
    margin: 0 0 16px;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__body p:last-child {
    margin-bottom: 0;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__body strong {
    color: var(--buzzko-ink);
    font-weight: 800;
  }

  /* NEWSLETTER */

  #buzzko-about-{{ section.id }} .buzzko-about__newsletter-wrap {
    padding: 20px 0 42px;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__newsletter {
    display: grid;
    grid-template-columns: 70px minmax(190px, .8fr) minmax(260px, 1.2fr);
    align-items: center;
    gap: 22px;
    padding: 24px clamp(20px, 4vw, 48px);
    background: #fae9e9;
    border-radius: 20px;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__newsletter-icon {
    width: 58px;
    color: var(--buzzko-ink);
  }

  #buzzko-about-{{ section.id }} .buzzko-about__newsletter-icon svg {
    display: block;
    width: 100%;
    height: auto;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__newsletter-copy h2 {
    margin: 0 0 5px;
    color: var(--buzzko-ink);
    font-size: 21px;
    font-weight: 800;
    line-height: 1.2;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__newsletter-copy p {
    margin: 0;
    color: var(--buzzko-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__form {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 4px;
    background: #fffdfa;
    border: 1px solid #e7deda;
    border-radius: 999px;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__form input[type="email"] {
    flex: 1;
    min-width: 0;
    height: 40px;
    padding: 0 15px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--buzzko-ink);
    font: inherit;
    font-size: 13px;
    box-shadow: none;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__form input[type="email"]:focus {
    outline: none;
    box-shadow: none;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__form button {
    flex: 0 0 38px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--buzzko-pink);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    transition: transform .18s ease, background .18s ease;
  }

  #buzzko-about-{{ section.id }} .buzzko-about__form button:hover {
    background: #df587f;
    transform: translateX(2px);
  }

  #buzzko-about-{{ section.id }} .buzzko-about__form-message {
    position: absolute;
    top: calc(100% + 6px);
    left: 16px;
    margin: 0;
    color: var(--buzzko-ink);
    font-size: 12px;
  }

  /* MOBILE */

  @media screen and (max-width: 749px) {
    #buzzko-about-{{ section.id }} .page-width {
      width: min(100% - 36px, 600px);
    }

    #buzzko-about-{{ section.id }} .buzzko-about__hero {
      padding-block: 42px 28px;
    }

    #buzzko-about-{{ section.id }} .buzzko-about__hero-title {
      max-width: 460px;
      font-size: clamp(42px, 12vw, 60px);
    }

    #buzzko-about-{{ section.id }} .buzzko-about__story {
      padding-block: 16px 40px;
    }

    #buzzko-about-{{ section.id }} .buzzko-about__float-figure {
      float: none;
      width: 100%;
      max-width: 460px;
      margin: 0 auto 24px;
    }

    #buzzko-about-{{ section.id }} .buzzko-about__body h3 {
      margin-top: 26px;
    }

    #buzzko-about-{{ section.id }} .buzzko-about__newsletter-wrap {
      padding: 12px 0 32px;
    }

    #buzzko-about-{{ section.id }} .buzzko-about__newsletter {
      grid-template-columns: 46px minmax(0, 1fr);
      gap: 12px;
      padding: 20px 16px 24px;
      border-radius: 16px;
    }

    #buzzko-about-{{ section.id }} .buzzko-about__newsletter-icon {
      width: 44px;
    }

    #buzzko-about-{{ section.id }} .buzzko-about__newsletter-copy h2 {
      font-size: 19px;
    }

    #buzzko-about-{{ section.id }} .buzzko-about__newsletter-form {
      grid-column: 1 / -1;
      margin-top: 5px;
    }

    #buzzko-about-{{ section.id }} .buzzko-about__form-message {
      position: static;
      padding: 6px 12px 0;
    }
  }

  @media screen and (prefers-reduced-motion: reduce) {
    #buzzko-about-{{ section.id }} .buzzko-about__form button {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "BuzzKo about page",
  "tag": "section",
  "class": "section-buzzko-about",
  "settings": [
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Hero eyebrow",
      "default": "A little bit of BuzzKo"
    },
    {
      "type": "textarea",
      "id": "hero_title",
      "label": "Hero heading",
      "default": "Small things.\nBig buzz."
    },
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story image"
    },
    {
      "type": "richtext",
      "id": "story_content",
      "label": "Story content",
      "default": "<h3>It started with a stall (and a sister who had enough of my nonsense)</h3><p>Picture this: a crowded stall, fairy lights, a table full of beautiful jewelry, and me, standing next to it with nothing to sell. Just vibes. Moral support. Occasionally holding things.</p><p>My sister was the one with the brand. I was the one who tagged along to help set up, then stood around while she did the actual work.</p><p>Until one day she looked at me and said, \"Why are you just coming along and doing nothing? You should sell something too. Be productive.\"</p><p>Rude? A little. Fair? Completely.</p><h3>The first little experiments</h3><p>So, I did. I started small, with the things I loved: posters that made a wall feel like a personality, stickers you'd slap on a laptop without thinking twice, bookmarks for people who read (or want to look like they do), and a few little keychains.</p><p>No grand plan. No business course. Just a table, a handful of products, and a lot of curiosity about whether anyone else would love this stuff as much as I did.</p><p>They did. Then the buzz began!!!</p><p>People stopped. They picked things up. They smiled. They came back with friends. Someone bought a keychain for themselves, then came back for three more as gifts.</p><p>That's when it clicked: the little things people carry, stick, hang, and gift are never really \"little.\" They're the things that make a day, a bag, a desk, or a wall feel like yours.</p><p>So Buzzko was born. The name says it all: that spark of excitement you feel when you find something you didn't know you needed.</p><h3>From keychains to a whole universe</h3><p>What began with four products has grown, one obsession at a time: charms, crochet pieces, lighters and plenty more trending finds that make us go \"okay, we need this.\"</p><p>Some of it is quirky. Some are cute. Some are a little chaotic. All of it has one thing in common: I only sell what I'm genuinely passionate about. If I wouldn't buy it, gift it, or proudly display it, it doesn't make the cut. No filler, no \"this will probably sell.\" Just stuff with personality.</p><h3>Yes, there's an engineer behind this!!!</h3><p>Here's the plot twist: I'm an engineer by profession. My days are about logic, systems, and things that must work properly.</p><p>Buzzko is my other side. It's where I get to be creative, playful, and a little unpredictable. It's the side hustle that doesn't feel like work, built in the margins of a busy life: evenings, weekends, and every bit of spare energy I have.</p><p>That means Buzzko is built bit by bit, and I'm proud of that. Every order, every restock, every new product has been grown with care, not rushed out by a corporation. Behind every package is a real person who is genuinely excited that you picked it.</p><h3>What we believe</h3><p>Everyday things shouldn't be boring. Your keys, your bag, your desk, your walls: all of them deserve some personality.</p><p>Passion beats trends. We follow what's hot, but only if we love it too.</p><p>Small brands have big hearts. Every purchase supports a dream being built from scratch.</p><p>Fun is a feature, not a bonus. If it doesn't make you smile, we're not interested.</p><p>Every brand has a few people working quietly in the background, and mine has one who deserves a spotlight, even if she prefers to stay in the shadows.</p><p>She helped me turn Buzzko from a table full of products into an actual website you can visit, scroll, and shop from. She believed in this idea when it was still small, backed me when I was juggling a day job and a side hustle, and gave her time and energy without being asked twice.</p><p>She knows who she is. Her support has shaped Buzzko more than she probably realizes, and every order that comes through this site exists partly because of her.</p><p>Thank you. This brand has your fingerprints on it. 💛</p><h3>Thank you to my customers!!!</h3><p>Every person who has bought, shared, gifted, or just cheered us on has helped this tiny idea grow. You're the reason a stall-side side-quest turned into a brand.</p><p>And to my sister, who told me to stop standing around and start selling, Thank you. This is all your fault. 🙂</p><p>So, scroll around, find something that makes you grin, and take a little piece of Buzzko home.</p><p><strong>Stay curious. Stay quirky. Stay Buzzing. 🐝</strong></p>"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter heading",
      "default": "Let's Stay in Touch"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Be the first to know about new drops, exclusive offers and all things cute."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "Submit button accessible label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    }
  ],
  "presets": [
    {
      "name": "BuzzKo about page"
    }
  ]
}
{% endschema %}