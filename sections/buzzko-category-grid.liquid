<section
  id="BuzzkoCategories-{{ section.id }}"
  class="buzzko-categories"
>
  {%- comment -%} Load any custom fonts used by the cards {%- endcomment -%}
  {%- capture buzzko_font_faces -%}
    {%- for block in section.blocks -%}
      {%- assign bf = block.settings.title_font -%}
      {%- if bf != blank -%}
        {{ bf | font_face: font_display: 'swap' }}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if buzzko_font_faces != blank -%}
    {% style %}{{ buzzko_font_faces }}{% endstyle %}
  {%- endif -%}

  <div class="buzzko-categories__container">

    <!-- HEADER -->
    <div class="buzzko-categories__header">

      {% if section.settings.heading != blank %}
        {%- assign heading_clean = section.settings.heading | remove: '✦' | strip -%}
        <h2 class="buzzko-categories__heading">
          {{ heading_clean }}<span class="buzzko-categories__sparkle">✦</span>
        </h2>
      {% endif %}

      <div class="buzzko-categories__header-right">

        {% if section.settings.show_arrows %}
          <div class="buzzko-categories__nav">
            <button
              type="button"
              class="buzzko-categories__nav-btn"
              data-buzzko-prev
              aria-label="Previous categories"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
              </svg>
            </button>

            <button
              type="button"
              class="buzzko-categories__nav-btn"
              data-buzzko-next
              aria-label="Next categories"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </button>
          </div>
        {% endif %}

        {% if section.settings.show_view_all and section.settings.view_all_link != blank %}
          <a
            href="{{ section.settings.view_all_link }}"
            class="buzzko-categories__view-all"
          >
            {{ section.settings.view_all_text }}
            <svg
              class="buzzko-categories__arrow"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        {% endif %}

      </div>

    </div>


    <!-- CATEGORY CARDS (slider at every breakpoint) -->
    <div class="buzzko-categories__grid">

      {% for block in section.blocks %}

        {%- liquid
          assign collection = block.settings.collection

          if collection != blank
            assign card_title = collection.title
            assign card_url   = collection.url
          else
            assign card_title = block.settings.title
            assign card_url   = block.settings.link
          endif

          assign card_image = block.settings.image
          if card_image == blank and collection != blank
            assign card_image = collection.image
          endif

          assign card_alt = block.settings.image_alt | default: card_title

          assign title_font = block.settings.title_font
        -%}

        {%- capture card_style -%}
          --card-bg: {{ block.settings.background_color | default: '#F8B5D1' }};
          --title-size: {{ block.settings.title_size | default: 26 }}px;
          --title-rotate: {{ block.settings.title_rotation | default: 0 }}deg;
          --title-color: {{ block.settings.title_color | default: '#111111' }};
          {% if title_font != blank %}
            --title-font: {{ title_font.family }}, {{ title_font.fallback_families }};
            --title-weight: {{ title_font.weight }};
            --title-style: {{ title_font.style }};
          {% endif %}
        {%- endcapture -%}

        {%- if card_url != blank -%}
          <a
            href="{{ card_url }}"
            class="buzzko-category-card"
            style="{{ card_style | strip_newlines }}"
            aria-label="{{ card_title | escape }}"
            {{ block.shopify_attributes }}
          >
        {%- else -%}
          <div
            class="buzzko-category-card buzzko-category-card--static"
            style="{{ card_style | strip_newlines }}"
            {{ block.shopify_attributes }}
          >
        {%- endif -%}

          <!-- WAVY BLOB SHAPE -->
          <svg
            class="buzzko-category-card__shape"
            viewBox="0 0 400 340"
            preserveAspectRatio="none"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M20 20
                     C50 2 80 2 110 20
                     C140 38 170 38 200 20
                     C230 2 260 2 290 20
                     C320 38 350 38 380 20
                     C398 53 398 87 380 120
                     C362 153 362 187 380 220
                     C398 253 398 287 380 320
                     C350 338 320 338 290 320
                     C260 302 230 302 200 320
                     C170 338 140 338 110 320
                     C80 302 50 302 20 320
                     C2 287 2 253 20 220
                     C38 187 38 153 20 120
                     C2 87 2 53 20 20 Z" />
          </svg>


          <!-- IMAGE -->
          <div class="buzzko-category-card__media">
            {% if card_image != blank %}
              {{
                card_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '300,450,600,750,900',
                  sizes: '(min-width: 990px) 25vw, 76vw',
                  alt: card_alt,
                  class: 'buzzko-category-card__img'
              }}
            {% endif %}
          </div>


          <!-- TITLE -->
          <div class="buzzko-category-card__content buzzko-category-card__content--v-{{ block.settings.text_vertical }} buzzko-category-card__content--h-{{ block.settings.text_align }}">
            <span class="buzzko-category-card__title">{{ card_title }}</span>
          </div>

        {%- if card_url != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}

      {% endfor %}

    </div>

  </div>
</section>


<style>

  #BuzzkoCategories-{{ section.id }} {
    --buzzko-page-bg: #fffaf5;
    --buzzko-text: #111111;

    background: var(--buzzko-page-bg);
    width: 100%;
  }


  /* CONTAINER */

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__container {
    width: min(1400px, calc(100% - 64px));
    margin: 0 auto;
    padding: 28px 0 64px;
  }


  /* HEADER */

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    margin-bottom: 26px;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__header-right {
    display: flex;
    align-items: center;
    gap: 18px;

    flex-shrink: 0;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__heading {
    margin: 0;

    color: var(--buzzko-text);

    font-size: clamp(30px, 3vw, 44px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  /* Sparkle gets its own size, matching the Trending section's ratio */
  #BuzzkoCategories-{{ section.id }} .buzzko-categories__sparkle {
    display: inline-block;
    margin-left: 8px;
    font-size: 0.8em;
    font-weight: 400;
    transform: none;
    vertical-align: middle;
  }


  /* CAROUSEL ARROWS */

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__nav {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /* the [hidden] attribute must beat the display rule above */
  #BuzzkoCategories-{{ section.id }} .buzzko-categories__nav[hidden] {
    display: none;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 38px;
    height: 38px;
    padding: 0;

    border: 1px solid rgba(17, 17, 17, 0.15);
    border-radius: 50%;

    background: #ffffff;
    color: #111111;

    cursor: pointer;

    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__nav-btn svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__nav-btn:hover:not(:disabled) {
    background: #111111;
    border-color: #111111;
    color: #ffffff;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__nav-btn:disabled {
    opacity: 0.28;
    cursor: default;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__nav-btn:focus-visible {
    outline: 2px solid #111;
    outline-offset: 2px;
  }


  /* VIEW ALL — SVG arrow + hover (matches Trending) */

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__view-all {
    display: inline-flex;
    align-items: center;
    gap: 12px;

    color: #111;
    text-decoration: none;

    font-size: 15px;
    font-weight: 500;
    line-height: 1;

    transition: color 0.2s ease;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__arrow {
    width: 18px;
    height: 18px;

    flex-shrink: 0;
    display: block;

    transition: transform 0.25s cubic-bezier(0.3, 1.2, 0.5, 1);
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__view-all:hover {
    color: #FF60B9;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__view-all:hover .buzzko-categories__arrow {
    transform: translateX(5px);
  }


  /* ============================================================
     TRACK — horizontal scroller at EVERY breakpoint
     --buzzko-per-view : how many cards are fully visible
     (the decimal part is the "peek" of the next card)
     ============================================================ */

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__grid {
    --buzzko-gap: 18px;
    --buzzko-per-view: 4.2;

    display: flex;
    align-items: flex-start;      /* keep aspect-ratio heights, no stretch */
    gap: var(--buzzko-gap);

    overflow-x: auto;
    overflow-y: hidden;

    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;

    scrollbar-width: none;
    -ms-overflow-style: none;

    /* headroom so the hover lift + drop shadow aren't clipped */
    padding: 8px 0 30px;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-categories__grid::-webkit-scrollbar {
    display: none;
  }


  /* CARD (whole card is the link) */

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card {
    position: relative;

    display: block;

    flex: 0 0 calc(
      (100% - (var(--buzzko-per-view) - 1) * var(--buzzko-gap)) / var(--buzzko-per-view)
    );

    min-width: 0;

    aspect-ratio: 400 / 340;

    scroll-snap-align: start;

    background: transparent;

    color: inherit;
    text-decoration: none;

    cursor: pointer;

    -webkit-tap-highlight-color: transparent;

    transition:
      transform 200ms ease,
      filter 200ms ease;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card--static {
    cursor: default;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card:hover {
    transform: translateY(-5px);
    filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.10));
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card:focus-visible {
    outline: 2px solid #111;
    outline-offset: 4px;
    border-radius: 24px;
  }


  /* WAVY SHAPE */

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__shape {
    position: absolute;
    inset: 0;

    display: block;

    width: 100%;
    height: 100%;

    z-index: 0;

    overflow: visible;

    pointer-events: none;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__shape path {
    fill: var(--card-bg, #F8B5D1);
  }


  /* IMAGE */

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__media {
    position: absolute;

    inset: 17% 9% 15% 9%;

    z-index: 1;

    display: flex;
    align-items: center;
    justify-content: center;

    pointer-events: none;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;
    object-position: center;

    mix-blend-mode: normal;
  }


  /* TEXT WRAPPER */

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__content {
    position: absolute;
    inset: 0;

    z-index: 2;

    display: flex;
    flex-direction: column;

    padding: 9% 9% 11% 9%;

    pointer-events: none;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__content--v-top    { justify-content: flex-start; }
  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__content--v-middle { justify-content: center; }
  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__content--v-bottom { justify-content: flex-end; }

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__content--h-left   { align-items: flex-start; }
  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__content--h-center { align-items: center; }
  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__content--h-right  { align-items: flex-end; }


  /* TITLE */

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__title {
    display: inline-block;

    max-width: 78%;

    font-family: var(--title-font, inherit);
    font-weight: var(--title-weight, 700);
    font-style: var(--title-style, normal);

    font-size: var(--title-size, 26px);
    line-height: 1.05;
    letter-spacing: -0.02em;

    color: var(--title-color, #111);

    transform: rotate(var(--title-rotate, 0deg));

    white-space: pre-line;
    overflow-wrap: break-word;
  }

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__content--h-left
  .buzzko-category-card__title { transform-origin: left center; }

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__content--h-center
  .buzzko-category-card__title { transform-origin: center center; text-align: center; }

  #BuzzkoCategories-{{ section.id }} .buzzko-category-card__content--h-right
  .buzzko-category-card__title { transform-origin: right center; text-align: right; }


  /* TABLET */

  @media screen and (max-width: 989px) {

    #BuzzkoCategories-{{ section.id }} .buzzko-categories__container {
      width: min(100% - 40px, 700px);
    }

    #BuzzkoCategories-{{ section.id }} .buzzko-categories__grid {
      --buzzko-gap: 14px;
      --buzzko-per-view: 2.2;
    }

  }


  /* MOBILE */

  @media screen and (max-width: 749px) {

    #BuzzkoCategories-{{ section.id }} .buzzko-categories__container {
      width: calc(100% - 28px);
      padding: 24px 0 44px;
    }

    #BuzzkoCategories-{{ section.id }} .buzzko-categories__header {
      margin-bottom: 18px;
    }

    #BuzzkoCategories-{{ section.id }} .buzzko-categories__heading {
      font-size: 28px;
    }

    #BuzzkoCategories-{{ section.id }} .buzzko-categories__sparkle {
      font-size: 0.7em;
      margin-left: 6px;
    }

    /* swipe is the interaction on touch — drop the arrows */
    #BuzzkoCategories-{{ section.id }} .buzzko-categories__nav {
      display: none;
    }

    #BuzzkoCategories-{{ section.id }} .buzzko-categories__view-all {
      gap: 8px;
      font-size: 13px;
    }

    #BuzzkoCategories-{{ section.id }} .buzzko-categories__arrow {
      width: 15px;
      height: 15px;
    }

    #BuzzkoCategories-{{ section.id }} .buzzko-categories__grid {
      --buzzko-gap: 12px;
      --buzzko-per-view: 1.3;

      /* let the last card bleed to the screen edge */
      margin-right: -14px;
      padding: 8px 14px 26px 0;
    }

    #BuzzkoCategories-{{ section.id }} .buzzko-category-card__content {
      padding: 10% 10% 12% 10%;
    }

    #BuzzkoCategories-{{ section.id }} .buzzko-category-card__title {
      font-size: calc(var(--title-size, 26px) * 0.86);
      max-width: 84%;
    }

  }

</style>


<script>
  (function () {
    var root = document.getElementById('BuzzkoCategories-{{ section.id }}');
    if (!root) return;

    var track = root.querySelector('.buzzko-categories__grid');
    var prev  = root.querySelector('[data-buzzko-prev]');
    var next  = root.querySelector('[data-buzzko-next]');
    var nav   = root.querySelector('.buzzko-categories__nav');

    if (!track || !prev || !next) return;

    function stepSize() {
      var card = track.querySelector('.buzzko-category-card');
      if (!card) return track.clientWidth;

      var gap = parseFloat(getComputedStyle(track).columnGap);
      if (isNaN(gap)) gap = 0;

      return card.getBoundingClientRect().width + gap;
    }

    function update() {
      var maxScroll = track.scrollWidth - track.clientWidth;
      var x = track.scrollLeft;

      prev.disabled = x <= 1;
      next.disabled = x >= maxScroll - 1;

      if (nav) nav.hidden = maxScroll <= 1;
    }

    prev.addEventListener('click', function () {
      track.scrollBy({ left: -stepSize(), behavior: 'smooth' });
    });

    next.addEventListener('click', function () {
      track.scrollBy({ left: stepSize(), behavior: 'smooth' });
    });

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    window.addEventListener('load', update);

    if (window.ResizeObserver) {
      new ResizeObserver(update).observe(track);
    }

    /* images are lazy-loaded, so re-check once they settle */
    setTimeout(update, 400);
    setTimeout(update, 1200);

    update();
  })();
</script>


{% schema %}

{
  "name": "BuzzKo Categories",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },

    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show carousel arrows",
      "info": "Hidden on mobile — visitors swipe instead.",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All link",
      "default": true
    },

    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All text",
      "default": "View All"
    },

    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All link"
    }

  ],

  "blocks": [

    {
      "type": "category",
      "name": "Category",

      "settings": [

        {
          "type": "header",
          "content": "Content"
        },

        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },

        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Use a transparent PNG cut-out for the best result. If left empty, the collection image is used."
        },

        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Custom title",
          "info": "Only used when no collection is selected."
        },

        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Only used when no collection is selected."
        },

        {
          "type": "color",
          "id": "background_color",
          "label": "Card background",
          "default": "#F8B5D1"
        },

        {
          "type": "header",
          "content": "Title text"
        },

        {
          "type": "font_picker",
          "id": "title_font",
          "label": "Font",
          "default": "assistant_n4"
        },

        {
          "type": "range",
          "id": "title_size",
          "label": "Font size",
          "min": 12,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 26
        },

        {
          "type": "range",
          "id": "title_rotation",
          "label": "Rotation",
          "min": -45,
          "max": 45,
          "step": 1,
          "unit": "deg",
          "default": 0
        },

        {
          "type": "color",
          "id": "title_color",
          "label": "Text color",
          "default": "#111111"
        },

        {
          "type": "select",
          "id": "text_vertical",
          "label": "Vertical placement",
          "options": [
            { "value": "top",    "label": "Top" },
            { "value": "middle", "label": "Middle" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "top"
        },

        {
          "type": "select",
          "id": "text_align",
          "label": "Horizontal placement",
          "options": [
            { "value": "left",   "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right",  "label": "Right" }
          ],
          "default": "left"
        }

      ]

    }

  ],

  "max_blocks": 8,

  "presets": [

    {
      "name": "BuzzKo Categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }

  ]

}

{% endschema %}