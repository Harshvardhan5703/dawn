{% doc %}
  @prompt
    In the header section, add a static country/currency label that looks exactly like the native Shopify country selector button — same styling, same position. It should display "India" with the Indian flag emoji (🇮🇳) and "INR" as a static, non-clickable label. Match the font, size, and appearance of the existing country selector in the header as closely as possible.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-country-label-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-country-label-{{ ai_gen_id }}__content {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8rem 1.5rem 0.8rem 1.5rem;
    color: rgb(var(--color-foreground));
    font-family: inherit;
    font-size: 1.2rem;
    line-height: calc(1 + 0.2 / var(--font-body-scale, 1));
    white-space: nowrap;
  }

  .ai-country-label-{{ ai_gen_id }}__flag {
    font-size: 1.6rem;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-country-label-{{ ai_gen_id }}__content {
      padding: 0.8rem 1rem;
    }
  }
{% endstyle %}

<div class="ai-country-label-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <span class="ai-country-label-{{ ai_gen_id }}__content" aria-label="India, Indian rupees">
    <span class="ai-country-label-{{ ai_gen_id }}__flag" aria-hidden="true">🇮🇳</span>
    <span>India</span>
    <span>(INR ₹)</span>
  </span>
</div>

{% schema %}
{
  "name": "India currency label",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "India currency label"
    }
  ],
  "tag": null,
  "class": "india-currency-label"
}
{% endschema %}