{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign offer_threshold = 500 | times: 100
  assign offer_percent = 10
  assign discount_code = 'BUZZKO10'

  assign offer_remaining = offer_threshold | minus: cart.items_subtotal_price
  assign offer_progress = cart.items_subtotal_price | times: 100.0 | divided_by: offer_threshold
  if offer_progress > 100
    assign offer_progress = 100
  endif
  assign offer_unlocked = false
  if offer_remaining <= 0
    assign offer_unlocked = true
  endif

  assign normalized_discount_code = discount_code | downcase | strip
  assign offer_discount_applied = false

  for cart_discount in cart.cart_level_discount_applications
    assign t = cart_discount.title | downcase
    if t contains normalized_discount_code
      assign offer_discount_applied = true
      break
    endif
  endfor

  if offer_discount_applied == false and cart.discount_applications
    for cart_discount in cart.discount_applications
      assign t = cart_discount.title | default: cart_discount.code | downcase
      if t contains normalized_discount_code
        assign offer_discount_applied = true
        break
      endif
    endfor
  endif

  assign has_any_other_code = false
  for cart_discount in cart.cart_level_discount_applications
    assign t = cart_discount.title | downcase
    unless t contains normalized_discount_code
      assign has_any_other_code = true
      break
    endunless
  endfor

  assign initial_discount = 0
  if offer_unlocked and offer_discount_applied == false and has_any_other_code == false
    assign initial_discount = cart.items_subtotal_price | times: offer_percent | divided_by: 100
  endif
  
  assign initial_discounted_total = cart.total_price
  if initial_discount > 0
    assign initial_discounted_total = cart.items_subtotal_price | minus: initial_discount
  endif

  assign applied_codes_str = ''
  for d in cart.cart_level_discount_applications
    assign t = d.title | downcase
    if applied_codes_str == ''
      assign applied_codes_str = t
    else
      assign applied_codes_str = applied_codes_str | append: '||' | append: t
    endif
  endfor

  for line in cart.items
    for alloc in line.line_level_discount_allocations
      assign t = alloc.discount_application.title | downcase
      unless applied_codes_str contains t
        if applied_codes_str == ''
          assign applied_codes_str = t
        else
          assign applied_codes_str = applied_codes_str | append: '||' | append: t
        endif
      endunless
    endfor
  endfor

  assign removable_codes_str = ''
  for d in cart.cart_level_discount_applications
    if d.type == 'discount_code'
      if removable_codes_str == ''
        assign removable_codes_str = d.title
      else
        assign removable_codes_str = removable_codes_str | append: '||' | append: d.title
      endif
    endif
  endfor
-%}

{%- style -%}
  #main-cart-footer .buzzko-summary {
    position: sticky; top: 24px; padding: 26px 24px 24px;
    background: #BEE3F8; border-radius: 20px;
  }
  @media screen and (max-width: 989px) { #main-cart-footer .buzzko-summary { position: static; } }

  #main-cart-footer .buzzko-summary__title {
    margin: 0 0 20px; color: #1A1A1A; font-size: 20px; font-weight: 800; letter-spacing: -0.025em;
  }
  #main-cart-footer .buzzko-summary__rows {
    display: flex; flex-direction: column; gap: 10px;
    padding-bottom: 20px; margin-bottom: 20px; border-bottom: 1px solid rgba(26, 26, 26, 0.08);
  }
  #main-cart-footer .buzzko-summary__row {
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
    color: #6B6663; font-size: 13.5px; line-height: 1.4;
  }
  #main-cart-footer .buzzko-summary__row-value { color: #1A1A1A; font-weight: 600; white-space: nowrap; }

  #main-cart-footer [data-buzzko-discount-row] { color: #1A1A1A; font-weight: 600; }
  #main-cart-footer [data-buzzko-discount-row] .buzzko-summary__row-value { color: #008A3E; font-weight: 700; }
  #main-cart-footer [data-buzzko-discount-row][hidden] { display: none; }
  #main-cart-footer .buzzko-summary.buzzko-has-buzzko10 [data-buzzko-discount-row] { display: none !important; }

  #main-cart-footer .buzzko-discount__remove {
    display: inline-grid; place-items: center; width: 18px; height: 18px; margin-left: 6px; padding: 0;
    border: 0; border-radius: 50%; background: rgba(26, 26, 26, 0.12); color: #1A1A1A;
    font-size: 10px; line-height: 1; cursor: pointer; vertical-align: middle;
    transition: background .15s ease;
  }
  #main-cart-footer .buzzko-discount__remove:hover { background: rgba(26, 26, 26, 0.25); }
  #main-cart-footer .buzzko-discount__remove[disabled] { opacity: .5; cursor: wait; }

  #main-cart-footer .buzzko-promo { display: flex; gap: 8px; margin: 0 0 16px; }
  #main-cart-footer .buzzko-promo__input {
    flex: 1; min-width: 0; height: 42px; padding: 0 16px;
    border: 1.5px solid #EBE5DF; border-radius: 999px; background: #fff;
    color: #1A1A1A; font-size: 13px; font-family: inherit; transition: border-color .15s ease;
  }
  #main-cart-footer .buzzko-promo__input::placeholder { color: #B5AEA7; }
  #main-cart-footer .buzzko-promo__input:focus { outline: none; border-color: #FF60B9; }
  #main-cart-footer .buzzko-promo__btn {
    flex-shrink: 0; height: 42px; padding: 0 20px; border: 0; border-radius: 999px;
    background: #1A1A1A; color: #fff; font-size: 13px; font-weight: 700; font-family: inherit;
    cursor: pointer; transition: background .15s ease, transform .15s ease;
  }
  #main-cart-footer .buzzko-promo__btn:hover { background: #333; transform: translateY(-1px); }

  #main-cart-footer .buzzko-gift {
    display: flex; align-items: flex-start; gap: 10px; padding: 14px 16px; margin: 0 0 16px;
    background: #fff; border: 1.5px dashed #FF60B9; border-radius: 14px; cursor: pointer;
    transition: background .15s ease;
  }
  #main-cart-footer .buzzko-gift:hover { background: #FFF8FC; }
  #main-cart-footer .buzzko-gift input { position: absolute; opacity: 0; pointer-events: none; }
  #main-cart-footer .buzzko-gift__box {
    flex-shrink: 0; width: 20px; height: 20px; margin-top: 1px; display: grid; place-items: center;
    border: 1.5px solid #1A1A1A; border-radius: 6px; background: #fff; transition: background .15s ease;
  }
  #main-cart-footer .buzzko-gift__box::after {
    content: ""; width: 10px; height: 6px;
    border-left: 2px solid #1A1A1A; border-bottom: 2px solid #1A1A1A;
    transform: rotate(-45deg) translate(1px, -1px); opacity: 0; transition: opacity .15s ease;
  }
  #main-cart-footer .buzzko-gift input:checked + .buzzko-gift__box { background: #FF60B9; }
  #main-cart-footer .buzzko-gift input:checked + .buzzko-gift__box::after { opacity: 1; }
  #main-cart-footer .buzzko-gift input:focus-visible + .buzzko-gift__box { outline: 2px solid #FF60B9; outline-offset: 2px; }
  #main-cart-footer .buzzko-gift__label { color: #1A1A1A; font-size: 13px; font-weight: 600; line-height: 1.4; }

  #main-cart-footer .buzzko-note { margin: 0 0 20px; }
  #main-cart-footer .buzzko-note summary {
    display: flex; align-items: center; gap: 6px; cursor: pointer; color: #1A1A1A;
    font-size: 13px; font-weight: 600; list-style: none; padding: 4px 0;
  }
  #main-cart-footer .buzzko-note summary::-webkit-details-marker { display: none; }
  #main-cart-footer .buzzko-note summary svg { width: 10px; height: 10px; transition: transform .2s ease; }
  #main-cart-footer .buzzko-note[open] summary svg { transform: rotate(180deg); }
  #main-cart-footer .buzzko-note__textarea {
    width: 100%; min-height: 72px; margin-top: 10px; padding: 12px 14px;
    border: 1.5px solid #EBE5DF; border-radius: 12px; background: #fff;
    color: #1A1A1A; font-size: 13px; font-family: inherit; line-height: 1.5;
    resize: vertical; box-sizing: border-box;
  }
  #main-cart-footer .buzzko-note__textarea:focus { outline: none; border-color: #FF60B9; }

  #main-cart-footer .buzzko-offer {
    position: relative; padding: 14px 16px 16px; margin: 0 0 20px;
    background: #fff; border: 1.5px solid #EBE5DF; border-radius: 14px; overflow: hidden;
    transition: background .35s ease, border-color .35s ease;
  }
  #main-cart-footer .buzzko-offer--unlocked { background: #FFF0F8; border-color: #FFC7E3; }
  #main-cart-footer .buzzko-offer__row {
    display: flex; align-items: center; gap: 8px; margin-bottom: 10px;
    color: #1A1A1A; font-size: 13px; font-weight: 600; line-height: 1.35;
  }
  #main-cart-footer .buzzko-offer__sparkle {
    flex-shrink: 0; color: #FF60B9; font-size: 12px; line-height: 1;
    transition: color .3s ease, transform .3s ease;
  }
  #main-cart-footer .buzzko-offer--unlocked .buzzko-offer__sparkle { color: #1A1A1A; transform: rotate(20deg) scale(1.2); }
  #main-cart-footer .buzzko-offer__track {
    position: relative !important; display: block !important; height: 8px !important;
    background: #F1ECE7 !important; border-radius: 999px !important; overflow: hidden !important;
  }
  #main-cart-footer .buzzko-offer--unlocked .buzzko-offer__track { background: rgba(255, 96, 185, 0.18) !important; }
  #main-cart-footer .buzzko-offer__fill {
    display: block !important; position: absolute !important; left: 0 !important; top: 0 !important;
    height: 8px !important; min-height: 8px !important; width: 0; min-width: 0;
    border-radius: 999px !important;
    background-color: #FF60B9 !important;
    background-image: linear-gradient(90deg, #FF60B9 0%, #F8B5D1 100%) !important;
    box-sizing: border-box !important;
    transition: width .55s cubic-bezier(.25, 1, .35, 1) !important;
  }
  #main-cart-footer .buzzko-offer--unlocked .buzzko-offer__fill {
    background-image: linear-gradient(90deg, #FF60B9 0%, #FF8EC9 100%) !important;
  }
  #main-cart-footer .buzzko-offer__fill::after {
    content: ""; position: absolute; top: 0; left: 0; height: 100%; width: 100%;
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, .35) 50%, transparent 100%);
    transform: translateX(-100%); animation: buzzkoShimmer 2.8s ease-in-out infinite; pointer-events: none;
  }
  @keyframes buzzkoShimmer { 0% { transform: translateX(-100%); } 60%, 100% { transform: translateX(200%); } }

  #main-cart-footer .buzzko-total {
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 20px;
  }
  #main-cart-footer .buzzko-total__label { margin: 0; color: #1A1A1A; font-size: 16px; font-weight: 700; letter-spacing: -0.01em; }
  #main-cart-footer .buzzko-total__value {
    margin: 0; color: #1A1A1A; font-size: 22px; font-weight: 900; letter-spacing: -0.03em;
    display: inline-block; transition: transform .3s ease, color .3s ease;
  }
  #main-cart-footer .buzzko-total__value.is-updated { animation: buzzkoPulse .55s cubic-bezier(.3, 1.4, .5, 1); }
  @keyframes buzzkoPulse {
    0% { transform: scale(1); color: #1A1A1A; }
    35% { transform: scale(1.08); color: #FF60B9; }
    100% { transform: scale(1); color: #1A1A1A; }
  }

  #main-cart-footer .cart__ctas { margin: 0; }
  #main-cart-footer .cart__checkout-button {
    width: 100%; min-height: 52px; padding: 14px 24px; border: 0; border-radius: 999px;
    background: #e656a8; color: #1A1A1A; font-family: inherit; font-size: 15px; font-weight: 800;
    letter-spacing: 0.01em; cursor: pointer; transition: background .15s ease, transform .15s ease;
  }
  #main-cart-footer .cart__checkout-button:hover:not(:disabled) { background: #e469af; transform: translateY(-1px); }
  #main-cart-footer .cart__checkout-button:disabled { background: #E5DED7; color: #85807B; cursor: not-allowed; transform: none; }
  #main-cart-footer .additional-checkout-buttons { margin-top: 10px; }

  #main-cart-footer .buzzko-trust {
    display: flex; flex-direction: column; gap: 8px; margin-top: 18px; padding-top: 18px;
    border-top: 1px solid rgba(26, 26, 26, 0.08);
  }
  #main-cart-footer .buzzko-trust__row { display: flex; align-items: center; gap: 8px; color: #6B6663; font-size: 12px; line-height: 1.4; }
  #main-cart-footer .buzzko-trust__row svg { width: 14px; height: 14px; flex-shrink: 0; color: #1A1A1A; }

  #main-cart-footer.is-empty .js-contents,
  #main-cart-footer.is-empty .buzzko-summary {
    display: none !important;
  }

  @media screen and (max-width: 749px) {
    #main-cart-footer .buzzko-summary { padding: 22px 18px; border-radius: 18px; }
    #main-cart-footer .buzzko-total__value { font-size: 20px; }
    #main-cart-footer .cart__checkout-button { min-height: 50px; font-size: 14px; }
  }
{%- endstyle -%}

<div
  class="gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
>
  <div class="js-contents">
    {%- if cart != empty -%}
    <div class="buzzko-summary{% if offer_discount_applied %} buzzko-has-buzzko10{% endif %}{% if has_any_other_code %} buzzko-has-other-code{% endif %}">

      <h2 class="buzzko-summary__title">Order Summary</h2>

      <div class="buzzko-summary__rows">
        <div class="buzzko-summary__row">
          <span>Subtotal ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
          <span class="buzzko-summary__row-value" data-buzzko-subtotal>{{ cart.items_subtotal_price | money }}</span>
        </div>

        <div
          class="buzzko-summary__row"
          data-buzzko-discount-row
          {% unless offer_unlocked and offer_discount_applied == false and has_any_other_code == false %}hidden{% endunless %}
        >
          <span>Discount ({{ offer_percent }}%)</span>
          <span class="buzzko-summary__row-value" data-buzzko-discount-amount>
            -{{ initial_discount | money }}
          </span>
        </div>

        {%- if cart.cart_level_discount_applications.size > 0 -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="buzzko-summary__row">
              <span>
                {{- discount.title | escape -}}
                {%- assign discount_title_lc = discount.title | downcase -%}
                {%- if discount.type == 'discount_code' and discount_title_lc != normalized_discount_code -%}
                  <button type="button" class="buzzko-discount__remove" data-buzzko-remove-code="{{ discount.title | escape }}" aria-label="Remove code {{ discount.title | escape }}">&#10005;</button>
                {%- endif -%}
              </span>
              <span class="buzzko-summary__row-value">-{{ discount.total_allocated_amount | money }}</span>
            </div>
          {%- endfor -%}
        {%- endif -%}

        <div class="buzzko-summary__row">
          <span>Shipping</span>
          <span class="buzzko-summary__row-value">Calculated at checkout</span>
        </div>

        {%- if cart.taxes_included -%}
          <div class="buzzko-summary__row">
            <span>Tax</span>
            <span class="buzzko-summary__row-value">Included</span>
          </div>
        {%- endif -%}
      </div>

      <form class="buzzko-promo" data-buzzko-promo>
        <input type="text" class="buzzko-promo__input" placeholder="Promo code" aria-label="Promo code">
        <button type="submit" class="buzzko-promo__btn">Apply</button>
      </form>

      <span hidden data-buzzko-applied-codes="{{ applied_codes_str | escape }}" data-buzzko-removable-codes="{{ removable_codes_str | escape }}"></span>

      <label class="buzzko-gift" for="Cart-gift-{{ section.id }}">
        <input
          type="checkbox"
          id="Cart-gift-{{ section.id }}"
          data-buzzko-gift
          {% if cart.attributes.gift == 'Yes' %}checked{% endif %}
        >
        <span class="buzzko-gift__box" aria-hidden="true"></span>
        <span class="buzzko-gift__label">Is it a gift? Make it special at no extra cost.</span>
      </label>

      {%- if settings.show_cart_note -%}
        <details class="buzzko-note">
          <summary>
            <span>Add a note</span>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <cart-note>
            <textarea
              class="buzzko-note__textarea"
              name="note"
              form="cart"
              id="Cart-note"
              placeholder="{{ 'sections.cart.note' | t }}"
            >{{ cart.note }}</textarea>
          </cart-note>
        </details>
      {%- endif -%}

      <div
        class="buzzko-offer{% if offer_unlocked %} buzzko-offer--unlocked{% endif %}"
        data-buzzko-offer
        data-threshold="{{ offer_threshold }}"
        data-percent="{{ offer_percent }}"
        data-discount-code="{{ discount_code }}"
        aria-live="polite"
      >
        <div class="buzzko-offer__row">
          <span class="buzzko-offer__sparkle" aria-hidden="true">✦</span>
          <span data-buzzko-offer-label>
            {%- if offer_unlocked -%}
              {{ offer_percent }}% off unlocked and auto applied!
            {%- else -%}
              Add {{ offer_remaining | money }} more to unlock {{ offer_percent }}% off!
            {%- endif -%}
          </span>
        </div>
        <div class="buzzko-offer__track">
          <div class="buzzko-offer__fill" data-buzzko-offer-fill style="width: {{ offer_progress }}%;"></div>
        </div>
      </div>

      <div class="buzzko-total">
        <h3 class="buzzko-total__label">Total</h3>
        <p
          class="buzzko-total__value"
          data-buzzko-total
          data-total-cents="{{ cart.items_subtotal_price }}"
        >{{ initial_discounted_total | money }}</p>
      </div>

      <div class="cart__ctas">
        <button type="submit" id="checkout" class="cart__checkout-button" name="checkout" form="cart">
          Proceed to Checkout
        </button>
      </div>

      {%- if additional_checkout_buttons -%}
        <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
          {{ content_for_additional_checkout_buttons }}
        </div>
      {%- endif -%}

      <div class="buzzko-trust">
        <div class="buzzko-trust__row">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M8 1.5l5 2v4c0 3-2.5 5.5-5 7-2.5-1.5-5-4-5-7v-4l5-2z" stroke-linejoin="round"/>
            <path d="M5.5 8l1.8 1.8L10.5 6.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Secure checkout, encrypted payment</span>
        </div>
        <div class="buzzko-trust__row">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M2 5.5h8v6H2zM10 7h2.5L14 9v2.5h-4z" stroke-linejoin="round"/>
            <circle cx="4.5" cy="11.5" r="1.2"/>
            <circle cx="11.5" cy="11.5" r="1.2"/>
          </svg>
          <span>Free delivery on orders above ₹499</span>
        </div>
      </div>
    </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    if (window.__buzzkoCartFooterInit) return;
    window.__buzzkoCartFooterInit = true;

    var ROOT = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
    var DISCOUNT_CODE = {{ discount_code | json }};
    var DISCOUNT_CODE_UPPER = DISCOUNT_CODE.toUpperCase();
    var OFFER_PERCENT = {{ offer_percent | json }};

    function showPromoMessage(form, text, color) {
      var msg = form.querySelector('[data-buzzko-promo-message]');
      if (!msg) {
        msg = document.createElement('p');
        msg.setAttribute('data-buzzko-promo-message', '');
        form.style.flexWrap = 'wrap';
        msg.style.cssText =
          'flex-basis:100%;width:100%;margin:0 0 0 4px;font-size:12px;line-height:1.4;';
        form.appendChild(msg);
      }
      msg.style.color = color;
      msg.textContent = text;
    }

    function clearPromoMessage(form) {
      var msg = form.querySelector('[data-buzzko-promo-message]');
      if (msg) msg.remove();
    }

    /* ---- Promo code ---- */
    document.addEventListener('submit', function (event) {
      var form = event.target;
      if (!form.matches || !form.matches('[data-buzzko-promo]')) return;
      event.preventDefault();

      var input = form.querySelector('input');
      var code = input && input.value ? input.value.trim() : '';

      if (!code) {
        showPromoMessage(form, 'Enter a code first.', '#C24545');
        if (input) {
          input.setAttribute('aria-invalid', 'true');
          input.focus();
        }
        return;
      }

      if (code.toUpperCase() === DISCOUNT_CODE_UPPER) {
        showPromoMessage(
          form,
          'This ' + OFFER_PERCENT + '% offer is applied automatically. ' +
          'You do not need to enter ' + DISCOUNT_CODE_UPPER + '.',
          '#9C285F'
        );
        input.setAttribute('aria-invalid', 'true');
        return;
      }

      clearPromoMessage(form);
      input.removeAttribute('aria-invalid');

      try {
        sessionStorage.setItem('buzzko_promo_attempt', code);
      } catch (e) { /* Safari private mode etc. */ }

      window.location.href = ROOT + 'discount/' + encodeURIComponent(code) +
                             '?redirect=' + encodeURIComponent(ROOT + 'cart');
    });

    (function reportFailedPromo() {
      var tried;
      try { tried = sessionStorage.getItem('buzzko_promo_attempt'); } catch (e) {}
      if (!tried) return;
      try { sessionStorage.removeItem('buzzko_promo_attempt'); } catch (e) {}

      var form = document.querySelector('[data-buzzko-promo]');
      if (!form) return;

      var host = document.querySelector('[data-buzzko-applied-codes]');
      var appliedRaw = host ? (host.getAttribute('data-buzzko-applied-codes') || '') : '';
      var applied = appliedRaw ? appliedRaw.split('||') : [];
      var needle = tried.toLowerCase();
      var landed = applied.some(function (t) { return t && t.indexOf(needle) !== -1; });

      if (landed) return;

      showPromoMessage(
        form,
        '\u201C' + tried + '\u201D isn\u2019t valid on this cart. ' +
        'Check the spelling or try a different code.',
        '#C24545'
      );
      var input = form.querySelector('input');
      if (input) {
        input.value = tried;
        input.setAttribute('aria-invalid', 'true');
      }
    })();

    /* ---- Remove an applied promo code ---- */
    function codeStillApplied(cart, code) {
      var needle = code.toLowerCase();
      var found = (cart.cart_level_discount_applications || []).some(function (d) {
        return d && d.title && d.title.toLowerCase() === needle;
      });
      if (found) return true;
      return (cart.items || []).some(function (item) {
        return (item.discounts || []).some(function (d) {
          return d && d.title && d.title.toLowerCase() === needle;
        });
      });
    }

    document.addEventListener('click', function (event) {
      var btn = event.target.closest && event.target.closest('[data-buzzko-remove-code]');
      if (!btn || btn.disabled) return;
      event.preventDefault();

      var code = btn.getAttribute('data-buzzko-remove-code');
      var host = document.querySelector('[data-buzzko-removable-codes]');
      var raw = host ? host.getAttribute('data-buzzko-removable-codes') : '';
      var all = raw ? raw.split('||') : [];
      var remaining = all.filter(function (c) { return c.toLowerCase() !== code.toLowerCase(); });
      var form = document.querySelector('[data-buzzko-promo]');

      btn.disabled = true;

      fetch(ROOT + 'cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ discount: remaining.join(',') })
      })
      .then(function (res) { return res.json(); })
      .then(function (cart) {
        if (codeStillApplied(cart, code)) throw new Error('still-applied');
        window.location.reload();
      })
      .catch(function () {
        btn.disabled = false;
        if (form) showPromoMessage(form, 'Could not remove ' + code + '. You can change it at checkout.', '#C24545');
      });
    });

    /* ---- Gift checkbox ---- */
    document.addEventListener('change', function (event) {
      var cb = event.target;
      if (!cb.matches || !cb.matches('[data-buzzko-gift]')) return;

      var value = cb.checked ? 'Yes' : '';
      document.querySelectorAll('[data-buzzko-gift]').forEach(function (other) {
        if (other !== cb) other.checked = cb.checked;
      });

      fetch(ROOT + 'cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ attributes: { gift: value } })
      }).catch(function () {});
    });

    /* ---- Checkout: route through /discount/CODE when offer unlocked ---- */
    document.addEventListener('click', function (event) {
      var btn = event.target.closest && event.target.closest('#checkout');
      if (!btn) return;

      // Guard: If a +/- request is currently in flight, wait for it to finish
      var list = document.getElementById('main-cart-items');
      if (list && list.classList.contains('cart__items--disabled')) {
        event.preventDefault(); 
        event.stopImmediatePropagation();
        var t = setInterval(function () {
          if (!list.classList.contains('cart__items--disabled')) { 
            clearInterval(t); 
            btn.click(); 
          }
        }, 80);
        return;
      }

      if (btn.dataset.buzzkoRedirecting) return;

      var summary = btn.closest('.buzzko-summary');
      if (summary && (
        summary.classList.contains('buzzko-has-buzzko10') ||
        summary.classList.contains('buzzko-has-other-code')
      )) {
        return;
      }

      var totalEl = document.querySelector('[data-buzzko-total]');
      var offerEl = document.querySelector('[data-buzzko-offer]');
      if (!totalEl || !offerEl) return;

      var cents = parseInt(totalEl.getAttribute('data-total-cents'), 10) || 0;
      var threshold = parseInt(offerEl.getAttribute('data-threshold'), 10) || 0;
      var code = offerEl.getAttribute('data-discount-code') || '';

      if (cents >= threshold && code) {
        event.preventDefault();
        btn.dataset.buzzkoRedirecting = '1';
        window.location.href = ROOT + 'discount/' + encodeURIComponent(code) +
                               '?redirect=' + encodeURIComponent(ROOT + 'checkout');
      }
    }, true);

    function pulseTotal() {
      var totalEl = document.querySelector('[data-buzzko-total]');
      if (!totalEl) return;
      totalEl.classList.remove('is-updated');
      void totalEl.offsetWidth;
      totalEl.classList.add('is-updated');
      setTimeout(function () { totalEl.classList.remove('is-updated'); }, 700);
    }

    function __buzzkoOnCartUpdate(event) {
      var data = event && event.detail && event.detail.cartData;
      if (!data || typeof data.item_count !== 'number') return;

      // 1. Remove shimmer from footer and line items
      document.querySelectorAll('.buzzko-is-loading').forEach(function(el) {
        el.classList.remove('buzzko-is-loading');
      });

      // 2. Pulse footer total
      pulseTotal();

      // 3. Flash line item price
      var key = window.__buzzkoLastClickedLineKey;
      if (key) {
        var linePrice = document.querySelector('.buzzko-item[data-line-key="' + key + '"] .buzzko-item__price');
        if (linePrice) {
          var priceElements = linePrice.querySelectorAll('span, s');
          priceElements.forEach(function(el) {
            el.classList.remove('is-updated');
            void el.offsetWidth; // Force browser reflow to restart animation
            el.classList.add('is-updated');
            setTimeout(function() { el.classList.remove('is-updated'); }, 700);
          });
        }
        window.__buzzkoLastClickedLineKey = null; // Reset for next click
      }
    }

    // Hook into Dawn's native Pub/Sub
function hookPubSub() {
  if (typeof subscribe !== 'function' || !window.PUB_SUB_EVENTS) return;
  subscribe(PUB_SUB_EVENTS.cartUpdate, function (e) {
    setTimeout(function () {
      __buzzkoOnCartUpdate({ detail: { cartData: e.cartData } });
    }, 50);
  });
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', hookPubSub);
} else {
  hookPubSub();
}
  })();
</script>

