{%- comment -%} BuzzKo per‑variant image strip — includes current main image, swap on click {%- endcomment -%}
<div class="variant-gallery" data-variant-gallery hidden></div>

<script type="application/json" id="VariantGalleryData-{{ section.id }}">
  {
    {%- for variant in product.variants -%}
      {%- assign files = variant.metafields.custom.variant_gallery.value -%}
      "{{ variant.id }}": [
        {%- if files -%}
          {%- for file in files -%}
            {
              "thumb": {{ file | image_url: width: 240 | json }},
              "full":  {{ file | image_url: width: 1400 | json }},
              "alt":   {{ file.alt | default: variant.title | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      ]{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
</script>

<style>
  #MainProduct-{{ section.id }} .variant-gallery {
    display: flex;
    gap: 10px;
    margin-top: 14px;
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
  }
  #MainProduct-{{ section.id }} .variant-gallery__thumb {
    width: 76px; height: 76px; padding: 0;
    border: 2px solid #F8B5D1; border-radius: 12px;
    overflow: hidden; background: #fff; cursor: pointer;
    transition: border-color .15s ease, transform .1s ease;
    flex: 0 0 auto;
  }
  #MainProduct-{{ section.id }} .variant-gallery__thumb img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  #MainProduct-{{ section.id }} .variant-gallery__thumb:hover,
  #MainProduct-{{ section.id }} .variant-gallery__thumb.is-active {
    border-color: #050505;
  }
  #MainProduct-{{ section.id }} .variant-gallery__thumb:active { transform: scale(.96); }

  @media screen and (min-width: 990px) {
    #MainProduct-{{ section.id }} .product__media-wrapper {
      position: sticky;
      top: 3rem;
      align-self: start;
      z-index: 1;
    }
  }

  @media screen and (max-width: 749px) {
    #MainProduct-{{ section.id }} .variant-gallery {
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 6px;
      scrollbar-width: thin;
    }
    #MainProduct-{{ section.id }} .variant-gallery__thumb { scroll-snap-align: start; }
    #MainProduct-{{ section.id }} .variant-gallery::-webkit-scrollbar { height: 4px; }
    #MainProduct-{{ section.id }} .variant-gallery::-webkit-scrollbar-thumb {
      background: #F8B5D1; border-radius: 4px;
    }
  }
</style>

<script>
(function () {
  const sectionId = '{{ section.id }}';
  const root      = document.getElementById('MainProduct-' + sectionId);
  if (!root) return;

  const dataEl    = document.getElementById('VariantGalleryData-' + sectionId);
  const container = root.querySelector('[data-variant-gallery]');
  if (!dataEl || !container) return;

  let data = {};
  try { data = JSON.parse(dataEl.textContent); } catch (e) { return; }

  let currentVariantId = null;

  function getVariantId() {
    const input = root.querySelector('form[action*="/cart/add"] input[name="id"]');
    return input ? String(input.value) : null;
  }
  function getMainImage() {
    const gallery = root.querySelector('#MediaGallery-' + sectionId);
    if (!gallery) return null;
    return gallery.querySelector('.product__media img');
  }
  function setMainImage(src, alt) {
    const mainImg = getMainImage();
    if (!mainImg) return;
    mainImg.removeAttribute('srcset');
    mainImg.removeAttribute('sizes');
    mainImg.src = src;
    if (alt) mainImg.alt = alt;
  }
  function baseName(url) {
    if (!url) return '';
    return url.split('?')[0].split('/').pop();
  }
  function withWidth(url, w) {
    if (!url) return url;
    const qIndex = url.indexOf('?');
    let base = url, vParam = '';
    if (qIndex >= 0) {
      base = url.substring(0, qIndex);
      url.substring(qIndex + 1).split('&').forEach(p => {
        if (p.startsWith('v=')) vParam = p;
      });
    }
    const qs = [vParam, 'width=' + w].filter(Boolean).join('&');
    return base + '?' + qs;
  }

  function alignStrip() {
    if (!container) return;
    container.style.paddingLeft  = '';
    container.style.paddingRight = '';
    if (window.innerWidth < 750) return;
    const gallery = root.querySelector('#MediaGallery-' + sectionId);
    if (!gallery) return;
    const mediaEl = gallery.querySelector('.product-media-container')
                 || gallery.querySelector('.product__media')
                 || gallery;
    const mediaRect   = mediaEl.getBoundingClientRect();
    const wrapperRect = container.parentElement.getBoundingClientRect();
    const padLeft  = Math.max(0, Math.round(mediaRect.left  - wrapperRect.left));
    const padRight = Math.max(0, Math.round(wrapperRect.right - mediaRect.right));
    container.style.paddingLeft  = padLeft  + 'px';
    container.style.paddingRight = padRight + 'px';
  }

  function neutralizeInnerSticky() {
    if (window.innerWidth < 990) return;
    const wrapper = root.querySelector('.product__media-wrapper');
    const gallery = root.querySelector('#MediaGallery-' + sectionId);
    if (!wrapper || !gallery) return;
    let el = gallery;
    while (el && el !== wrapper) {
      if (getComputedStyle(el).position === 'sticky') {
        el.style.position = 'static';
        el.style.top = '';
      }
      el = el.parentElement;
    }
  }

  /* Build the strip: [ current main image (active) ] + [ metafield gallery ] */
  function buildStrip() {
    const id = getVariantId();
    if (!id) return;

    const mainImg = getMainImage();
    const mainSrc = mainImg ? (mainImg.currentSrc || mainImg.src) : '';
    const mainAlt = mainImg ? (mainImg.alt || '') : '';

    const items = [];
    if (mainSrc) {
      items.push({
        thumb: withWidth(mainSrc, 240),
        full:  withWidth(mainSrc, 1400),
        alt:   mainAlt,
        isMain: true
      });
    }

    const mainKey = baseName(mainSrc);
    (data[id] || []).forEach(img => {
      if (baseName(img.full) !== mainKey) items.push(img);
    });

    // Nothing beyond the main image → strip is pointless, hide it
    if (items.length <= 1) {
      container.hidden = true;
      container.innerHTML = '';
      return;
    }

    container.hidden = false;
    container.innerHTML = items.map((img, i) => `
      <button type="button"
              class="variant-gallery__thumb${img.isMain ? ' is-active' : ''}"
              data-full="${img.full}"
              data-alt="${img.alt}"
              aria-label="${img.alt}">
        <img src="${img.thumb}" alt="${img.alt}" loading="lazy" width="120" height="120">
      </button>
    `).join('');

    requestAnimationFrame(alignStrip);
  }

  /* On variant change: wait for Dawn to update the main image, then rebuild */
  let settleTimer = null;
  function render() {
    const id = getVariantId();
    if (!id || id === currentVariantId) return;
    currentVariantId = id;

    // Immediate attempt + a couple of retries as Dawn updates the main img async
    clearTimeout(settleTimer);
    buildStrip();
    setTimeout(buildStrip, 120);
    setTimeout(buildStrip, 400);
  }

  container.addEventListener('click', function (e) {
  const btn = e.target.closest('.variant-gallery__thumb');
  if (!btn) return;
  if (btn.classList.contains('is-active')) return;

  const mainImg = getMainImage();
  if (!mainImg) return;

  // Just change the main image — no shuffling of the strip
  setMainImage(btn.dataset.full, btn.dataset.alt || '');

  // Move the black border to the clicked thumb
  container.querySelectorAll('.variant-gallery__thumb')
    .forEach(b => b.classList.remove('is-active'));
  btn.classList.add('is-active');
});

  document.addEventListener('change', () => setTimeout(render, 100));
  window.addEventListener('popstate', () => setTimeout(render, 100));
  window.addEventListener('resize', () => { neutralizeInnerSticky(); alignStrip(); });
  setInterval(render, 400);

  neutralizeInnerSticky();
  render();
  alignStrip();
})();
</script>