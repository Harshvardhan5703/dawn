        <path d="M27 25.5 H37" stroke="var(--bz-ink)" stroke-width="2" stroke-linecap="round" opacity=".5"/>
        <rect class="bz-s" x="19" y="29" width="26" height="30" rx="6" fill="var(--bz-blue)"/>
        <circle cx="27" cy="40" r="2" fill="var(--bz-ink)"/>
        <circle cx="37" cy="40" r="2" fill="var(--bz-ink)"/>
        <ellipse cx="23.5" cy="45" rx="3" ry="2" fill="var(--bz-pink)" opacity=".85"/>
        <ellipse cx="40.5" cy="45" rx="3" ry="2" fill="var(--bz-pink)" opacity=".85"/>
        <path class="bz-s" d="M29.5 44.5 Q32 47.2 34.5 44.5" stroke-width="2"/>
        <path d="M23 33 V36" stroke="#fff" stroke-width="2.2" stroke-linecap="round" opacity=".85"/>
      </svg>

    {%- when 8 -%}
      <svg class="bz-svg" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <circle class="bz-s" cx="32" cy="5" r="2.2" fill="var(--bz-pink)" stroke-width="2"/>
        <g class="bz-frame">
