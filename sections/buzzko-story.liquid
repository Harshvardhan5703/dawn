<section
  id="buzzko-story-{{ section.id }}"
  class="buzzko-story"
>
  <div class="buzzko-story__container">

    <!-- LEFT IMAGE -->
    <div class="buzzko-story__visual buzzko-story__visual--left">

      {% if section.settings.left_image != blank %}

        {{
          section.settings.left_image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 900',
            sizes: '(min-width: 990px) 30vw, 50vw',
            alt: section.settings.left_image_alt,
            class: 'buzzko-story__image'
        }}

      {% endif %}

    </div>


    <!-- CENTER CONTENT -->
    <div class="buzzko-story__content">

      {% if section.settings.eyebrow != blank %}
        <p class="buzzko-story__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}


      {% if section.settings.heading != blank %}
        <h2 class="buzzko-story__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}


      {% if section.settings.description != blank %}
        <div class="buzzko-story__description">
          {{ section.settings.description }}
        </div>
      {% endif %}


      {% if section.settings.button_label != blank and section.settings.button_link != blank %}

        <a
          href="{{ section.settings.button_link }}"
          class="buzzko-story__button"
        >
          {{ section.settings.button_label }}
          <span>→</span>
        </a>

      {% endif %}

    </div>


    <!-- RIGHT IMAGE -->
    <div class="buzzko-story__visual buzzko-story__visual--right">

      {% if section.settings.right_image != blank %}

        {{
          section.settings.right_image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 900',
            sizes: '(min-width: 990px) 30vw, 50vw',
            alt: section.settings.right_image_alt,
            class: 'buzzko-story__image'
        }}

      {% endif %}

    </div>

  </div>
</section>


<style>

  /* =========================================
     SECTION
  ========================================= */

  #buzzko-story-{{ section.id }} {
    background: #FFFAF5;
    overflow: hidden;
  }


  #buzzko-story-{{ section.id }} .buzzko-story__container {
    width: 100%;
    min-height: 450px;

    display: grid;
    grid-template-columns: 1fr 1.15fr 1fr;
    align-items: center;

    position: relative;
  }


  /* =========================================
     VISUALS
  ========================================= */

  #buzzko-story-{{ section.id }} .buzzko-story__visual {
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    pointer-events: none;
  }


  #buzzko-story-{{ section.id }} .buzzko-story__visual--left {
    justify-content: center;
  }


  #buzzko-story-{{ section.id }} .buzzko-story__visual--right {
    justify-content: center;
  }


  #buzzko-story-{{ section.id }} .buzzko-story__image {
    display: block;

    width: 100%;
    height: auto;

    object-fit: contain;
  }


  #buzzko-story-{{ section.id }} .buzzko-story__visual--left
  .buzzko-story__image {
    max-width: 430px;
    max-height: 410px;
  }


  #buzzko-story-{{ section.id }} .buzzko-story__visual--right
  .buzzko-story__image {
    max-width: 440px;
    max-height: 410px;
  }


  /* =========================================
     CENTER CONTENT
  ========================================= */

  #buzzko-story-{{ section.id }} .buzzko-story__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    padding: 30px 20px;
  }


  #buzzko-story-{{ section.id }} .buzzko-story__eyebrow {
    margin: 0 0 25px;

    color: #222;

    font-size: 25px;
    line-height: 1.1;
    font-weight: 800;

    letter-spacing: -0.8px;
  }


  #buzzko-story-{{ section.id }} .buzzko-story__heading {
    margin: 0;

    max-width: 500px;

    color: #F45F9B;

    font-size: clamp(38px, 4vw, 62px);
    line-height: 0.95;
    font-weight: 900;

    letter-spacing: -2px;
  }


  /* =========================================
     DESCRIPTION (new)
  ========================================= */

  #buzzko-story-{{ section.id }} .buzzko-story__description {
    margin: 22px 0 0;

    max-width: 440px;

    color: #4a4a4a;

    font-size: 15px;
    line-height: 1.55;
    font-weight: 400;
  }

  #buzzko-story-{{ section.id }} .buzzko-story__description p {
    margin: 0 0 10px;
  }

  #buzzko-story-{{ section.id }} .buzzko-story__description p:last-child {
    margin-bottom: 0;
  }

  #buzzko-story-{{ section.id }} .buzzko-story__description a {
    color: #F45F9B;
    text-decoration: underline;
  }


  /* =========================================
     BUTTON
  ========================================= */

  #buzzko-story-{{ section.id }} .buzzko-story__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 6px;

    margin-top: 80px;

    min-width: 165px;
    min-height: 54px;

    padding: 13px 24px;

    background: #F45F9B;
    color: #111;

    border-radius: 999px;

    font-size: 14px;
    line-height: 1;
    font-weight: 700;

    text-decoration: none;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }


  #buzzko-story-{{ section.id }} .buzzko-story__button span {
    font-size: 18px;
    line-height: 1;
  }


  #buzzko-story-{{ section.id }} .buzzko-story__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 7px 18px rgba(0, 0, 0, 0.08);
  }


  /* =========================================
     TABLET
  ========================================= */

  @media screen and (max-width: 989px) {

    #buzzko-story-{{ section.id }} .buzzko-story__container {
      min-height: 380px;

      grid-template-columns: 0.8fr 1.2fr 0.8fr;
    }


    #buzzko-story-{{ section.id }} .buzzko-story__visual--left
    .buzzko-story__image {
      max-width: 320px;
    }


    #buzzko-story-{{ section.id }} .buzzko-story__visual--right
    .buzzko-story__image {
      max-width: 330px;
    }


    #buzzko-story-{{ section.id }} .buzzko-story__eyebrow {
      font-size: 20px;
      margin-bottom: 18px;
    }


    #buzzko-story-{{ section.id }} .buzzko-story__heading {
      font-size: 42px;
    }


    #buzzko-story-{{ section.id }} .buzzko-story__description {
      margin-top: 18px;
      font-size: 14px;
    }


    #buzzko-story-{{ section.id }} .buzzko-story__button {
      margin-top: 50px;
    }

  }


  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 749px) {

    #buzzko-story-{{ section.id }} {
      padding: 35px 0 40px;
    }


    #buzzko-story-{{ section.id }} .buzzko-story__container {
      min-height: auto;

      display: flex;
      flex-direction: column;

      gap: 10px;
    }


    /* Center first */
    #buzzko-story-{{ section.id }} .buzzko-story__content {
      order: 1;

      width: 100%;

      align-items: center;
      text-align: center;

      padding: 10px 24px 20px;
    }


    #buzzko-story-{{ section.id }} .buzzko-story__eyebrow {
      margin-bottom: 14px;

      font-size: 19px;
    }


    #buzzko-story-{{ section.id }} .buzzko-story__heading {
      max-width: 350px;

      font-size: 38px;
      letter-spacing: -1.5px;
    }


    #buzzko-story-{{ section.id }} .buzzko-story__description {
      margin-top: 16px;

      max-width: 350px;

      font-size: 13px;
      line-height: 1.5;
    }


    #buzzko-story-{{ section.id }} .buzzko-story__button {
      margin-top: 30px;

      min-height: 48px;
      min-width: 150px;
    }


    /* Left image */
    #buzzko-story-{{ section.id }} .buzzko-story__visual--left {
      order: 2;

      width: 100%;
    }


    #buzzko-story-{{ section.id }} .buzzko-story__visual--left
    .buzzko-story__image {
      width: 75%;
      max-width: 350px;
    }


    /* Right image */
    #buzzko-story-{{ section.id }} .buzzko-story__visual--right {
      order: 3;

      width: 100%;
    }


    #buzzko-story-{{ section.id }} .buzzko-story__visual--right
    .buzzko-story__image {
      width: 75%;
      max-width: 350px;
    }

  }

</style>


{% schema %}

{
  "name": "BuzzKo Our Story",

  "settings": [

    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },

    {
      "type": "text",
      "id": "left_image_alt",
      "label": "Left Image Alt Text",
      "default": "BuzzKo accessories"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small Heading",
      "default": "More Than Accessories"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "A BRIGHTER YOU."
    },

    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtfully designed pieces that bring a little more joy to your everyday.</p>"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Our Story"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },

    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Image"
    },

    {
      "type": "text",
      "id": "right_image_alt",
      "label": "Right Image Alt Text",
      "default": "Create Personalise Carry Joy"
    }

  ],

  "presets": [

    {
      "name": "BuzzKo Our Story"
    }

  ]

}

{% endschema %}