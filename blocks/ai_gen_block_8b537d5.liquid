{% doc %}
  Buzzko First Visit Flyer Popup

  Desktop: Landscape flyer (1600 x 1200)
  Mobile: Portrait flyer (900 x 1200)

  Features:
  - Separate desktop and mobile images
  - Desktop image is the default
  - No image stretching or cropping
  - Hero-style CTA at bottom-left
  - Close button at top-right
  - First-visit-only display using localStorage
  - Popup reveals only once the flyer is decoded (no empty-box flash)
  - Editable Shopify theme settings
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-welcome-popup-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-welcome-popup-{{ ai_gen_id }}[hidden] {
    display: none !important;
  }

  /* OVERLAY */

  .ai-welcome-popup-{{ ai_gen_id }}__overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.68);
  }

  /* DESKTOP PANEL */

  .ai-welcome-popup-{{ ai_gen_id }}__panel {
    position: relative;
    width: 100%;
    max-width: 720px;
    max-height: calc(100vh - 40px);
    max-height: calc(100dvh - 40px);
    overflow: hidden;
    border-radius: 18px;
    background: #fffaf5;
    box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.18);
  }

  /* FLYER IMAGE */

  .ai-welcome-popup-{{ ai_gen_id }}__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #fdf3f5;
  }

  .ai-welcome-popup-{{ ai_gen_id }}__picture {
    display: block;
    width: 100%;
  }

  .ai-welcome-popup-{{ ai_gen_id }}__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100vh - 40px);
    max-height: calc(100dvh - 40px);
    object-fit: contain;
    object-position: center;
  }

  /* CTA POSITION: BOTTOM LEFT */

  .ai-welcome-popup-{{ ai_gen_id }}__cta {
    position: absolute;
    z-index: 2;
    left: 28px;
    bottom: 28px;
    display: flex;
    pointer-events: none;
  }

  /* HERO-STYLE BUTTON */

  .ai-welcome-popup-{{ ai_gen_id }}__button {
    pointer-events: auto;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    max-width: 100%;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    text-decoration: none;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.2;
    color: var(--btn-text, #111);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .ai-welcome-popup-{{ ai_gen_id }}__button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--btn-bg, #ff5ca8);
    opacity: 0.82;
    transition:
      opacity 180ms ease,
      background 180ms ease;
  }

  .ai-welcome-popup-{{ ai_gen_id }}__button:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
  }

  .ai-welcome-popup-{{ ai_gen_id }}__button:hover::before {
    opacity: 1;
    background: var(--btn-hover, #e94a96);
  }

  .ai-welcome-popup-{{ ai_gen_id }}__button:active {
    transform: translateY(0);
  }

  /* CLOSE BUTTON */

  .ai-welcome-popup-{{ ai_gen_id }}__close {
    position: absolute;
    z-index: 5;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    color: #111;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 50%;
    font-size: 27px;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    transition:
      transform 180ms ease,
      background 180ms ease;
  }

  .ai-welcome-popup-{{ ai_gen_id }}__close:hover {
    transform: rotate(90deg);
    background: #fff;
  }

  .ai-welcome-popup-{{ ai_gen_id }}__button:focus-visible,
  .ai-welcome-popup-{{ ai_gen_id }}__close:focus-visible {
    outline: 3px solid #ff5ca8;
    outline-offset: 3px;
  }

  /* MOBILE */

  @media screen and (max-width: 749px) {
    .ai-welcome-popup-{{ ai_gen_id }}__overlay {
      padding: 16px;
    }

    .ai-welcome-popup-{{ ai_gen_id }}__panel {
      width: 100%;
      max-width: 440px;
      max-height: calc(100vh - 32px);
      max-height: calc(100dvh - 32px);
      border-radius: 16px;
      box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.18);
    }

    .ai-welcome-popup-{{ ai_gen_id }}__image {
      max-height: calc(100vh - 32px);
      max-height: calc(100dvh - 32px);
      object-fit: contain;
    }

    .ai-welcome-popup-{{ ai_gen_id }}__cta {
      left: 16px;
      bottom: 16px;
    }

    .ai-welcome-popup-{{ ai_gen_id }}__button {
      min-height: 38px;
      padding: 0 18px;
      font-size: 12px;
    }

    .ai-welcome-popup-{{ ai_gen_id }}__close {
      top: 10px;
      right: 10px;
      width: 38px;
      height: 38px;
      font-size: 25px;
    }
  }

  /* SHORT VIEWPORTS */

  @media screen and (max-height: 500px) {
    .ai-welcome-popup-{{ ai_gen_id }}__overlay {
      padding: 12px;
    }

    .ai-welcome-popup-{{ ai_gen_id }}__panel {
      max-height: calc(100vh - 24px);
      max-height: calc(100dvh - 24px);
    }

    .ai-welcome-popup-{{ ai_gen_id }}__image {
      max-height: calc(100vh - 24px);
      max-height: calc(100dvh - 24px);
    }
  }
{% endstyle %}

<first-visit-popup-{{ ai_gen_id }}
  class="ai-welcome-popup-{{ ai_gen_id }}"
  data-storage-key="ai-welcome-popup-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  hidden
>
  <div class="ai-welcome-popup-{{ ai_gen_id }}__overlay">

    <section
      class="ai-welcome-popup-{{ ai_gen_id }}__panel"
      role="dialog"
      aria-modal="true"
      aria-label="Special offer"
      tabindex="-1"
    >

      <!-- CLOSE BUTTON -->

      <button
        class="ai-welcome-popup-{{ ai_gen_id }}__close"
        type="button"
        aria-label="Close popup"
      >×</button>

      <!-- RESPONSIVE FLYER -->

      {% if block.settings.image != blank %}

        <div class="ai-welcome-popup-{{ ai_gen_id }}__media">

          <picture class="ai-welcome-popup-{{ ai_gen_id }}__picture">

            {% if block.settings.mobile_image != blank %}
              <source
                media="(max-width: 749px)"
                srcset="
                  {{ block.settings.mobile_image | image_url: width: 600 }} 600w,
                  {{ block.settings.mobile_image | image_url: width: 900 }} 900w,
                  {{ block.settings.mobile_image | image_url: width: 1200 }} 1200w
                "
                sizes="(max-width: 749px) calc(100vw - 32px), 440px"
              >
            {% endif %}

            <img
              class="ai-welcome-popup-{{ ai_gen_id }}__image"
              src="{{ block.settings.image | image_url: width: 1600 }}"
              srcset="
                {{ block.settings.image | image_url: width: 720 }} 720w,
                {{ block.settings.image | image_url: width: 1080 }} 1080w,
                {{ block.settings.image | image_url: width: 1600 }} 1600w
              "
              sizes="(max-width: 749px) calc(100vw - 32px), 720px"
              alt="{{ block.settings.image.alt | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            >

          </picture>

          <!-- CTA BUTTON -->

          {% if block.settings.button_label != blank %}

            <div class="ai-welcome-popup-{{ ai_gen_id }}__cta">

              <a
                href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
                class="ai-welcome-popup-{{ ai_gen_id }}__button"
                style="
                  --btn-bg: {{ block.settings.button_color }};
                  --btn-text: {{ block.settings.button_text_color }};
                  --btn-hover: {{ block.settings.button_hover_color }};
                "
              >
                {{ block.settings.button_label | escape }}
              </a>

            </div>

          {% endif %}

        </div>

      {% endif %}

    </section>
  </div>
</first-visit-popup-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'first-visit-popup-{{ ai_gen_id }}';

    if (customElements.get(tagName)) return;

    class FirstVisitPopup{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;

        this.dialog = this.querySelector('[role="dialog"]');

        this.closeButton = this.querySelector(
          '.ai-welcome-popup-{{ ai_gen_id }}__close'
        );

        this.image = this.querySelector(
          '.ai-welcome-popup-{{ ai_gen_id }}__image'
        );

        this.storageKey = this.dataset.storageKey;

        const isEditor = Boolean(window.Shopify && window.Shopify.designMode);

        let alreadySeen = false;
        try {
          alreadySeen = localStorage.getItem(this.storageKey) === 'seen';
        } catch (error) {}

        if (!isEditor && alreadySeen) return;

        this.closeButton?.addEventListener('click', () => this.closePopup());

        this.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            this.closePopup();
          }

          if (event.key === 'Tab' && !this.hidden) {
            const focusable = Array.from(
              this.dialog.querySelectorAll('button:not([disabled]), a[href]')
            );

            if (!focusable.length) return;

            const first = focusable[0];
            const last = focusable[focusable.length - 1];

            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          }
        });

        this.revealWhenImageReady(isEditor);
      }

      // Wait for the flyer to be decoded before removing [hidden],
      // so the empty cream panel never flashes before the artwork.
      revealWhenImageReady(isEditor) {
        let revealed = false;

        const reveal = () => {
          if (revealed) return;
          revealed = true;

          this.hidden = false;
          this.closeButton?.focus({ preventScroll: true });

          if (!isEditor) {
            try {
              localStorage.setItem(this.storageKey, 'seen');
            } catch (error) {}
          }
        };

        const img = this.image;

        // No image configured — just show.
        if (!img) {
          reveal();
          return;
        }

        // Safety net: never block the popup forever on a broken image.
        const fallback = setTimeout(reveal, 3000);

        const done = () => {
          clearTimeout(fallback);
          if (typeof img.decode === 'function') {
            img.decode().then(reveal).catch(reveal);
          } else {
            reveal();
          }
        };

        if (img.complete && img.naturalWidth > 0) {
          done();
          return;
        }

        img.addEventListener('load', done, { once: true });
        img.addEventListener(
          'error',
          () => {
            clearTimeout(fallback);
            reveal();
          },
          { once: true }
        );
      }

      closePopup() {
        this.hidden = true;
      }
    }

    customElements.define(tagName, FirstVisitPopup{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "First visit popup",
  "settings": [
    {
      "type": "header",
      "content": "Flyer images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop flyer",
      "info": "Recommended: 1600 x 1200 px (4:3 landscape)."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile flyer",
      "info": "Recommended: 900 x 1200 px (3:4 portrait). Leave empty to use the desktop image."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop New Collection",
      "info": "Leave empty to hide the button."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#ff5ca8"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button background on hover",
      "default": "#e94a96"
    }
  ],
  "presets": [
    {
      "name": "First visit popup"
    }
  ],
  "tag": null,
  "class": "first-visit-popup"
}
{% endschema %}