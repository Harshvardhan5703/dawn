
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif %}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

<style>
  .template-search__header {
    margin-bottom: 3rem;
  }

  .template-search__search {
    margin: 0 auto 3.5rem;
    max-width: 74.1rem;
  }

  .template-search__search .search {
    margin-top: 3rem;
  }

  .template-search--empty {
    padding-bottom: 18rem;
  }

  @media screen and (min-width: 750px) {
    .template-search__header {
      margin-bottom: 5rem;
    }
  }

  .search__button .icon {
    height: 1.8rem;
  }

  /* ===== BuzzKo search page styling ===== */
  .template-search {
    background: #FFFAF5;
  }

  .template-search__header {
    text-align: center;
  }

  .template-search__header .buzzko-search-title {
    position: relative;
    display: inline-block;
    margin: 0 auto;
    color: #1A1A1A;
    font-size: clamp(2.8rem, 5vw, 5.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .template-search__header .buzzko-search-title::after {
    content: "✦";
    position: absolute;
    top: -0.3em;
    right: -0.65em;
    color: #FF60B9;
    font-size: 0.42em;
    transform: rotate(12deg);
  }

  .template-search__search {
    max-width: 68rem;
  }

  .template-search__search .search {
    margin-top: 2.4rem;
  }

  .template-search__search .field {
    min-height: 5.4rem;
    overflow: hidden;
    border: 1.5px solid #D8D1CB;
    border-radius: 999px;
    background: #fff;
    box-shadow: none;
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  .template-search__search .field:focus-within {
    border-color: #FF60B9;
    box-shadow: 0 0 0 2px rgba(255, 96, 185, .12);
  }

  .template-search__search .field::before,
  .template-search__search .field::after {
    content: none;
  }

  .template-search__search .search__input {
    min-height: 5.2rem;
    padding: 0 1.6rem 0 2rem;
    border: 0;
    box-shadow: none;
    background: transparent;
    color: #1A1A1A;
    font-size: 1.45rem;
    line-height: 1.4;
  }

  .template-search__search .search__input::placeholder {
    color: #96908B;
    opacity: 1;
  }

  .template-search__search .field__label {
    left: 2rem;
    color: #96908B;
    font-size: 1.4rem;
  }

  .template-search__search .search__input:not(:placeholder-shown) + .field__label,
  .template-search__search .search__input:focus + .field__label {
    opacity: 0;
    visibility: hidden;
  }

  .template-search__search .field__button {
    width: 3.8rem;
    height: 3.8rem;
    min-width: 3.8rem;
    margin: 0.7rem;
    padding: 0;
    border-radius: 50%;
    background: transparent;
    color: #77716D;
    transition: background .2s ease, color .2s ease;
  }

  .template-search__search .field__button:hover {
    background: #FFF0F8;
    color: #1A1A1A;
  }

  .template-search__search .field__button .svg-wrapper,
  .template-search__search .field__button svg {
    width: 1.55rem;
    height: 1.55rem;
  }

  .template-search__search .reset__button {
    color: #9A938D;
  }

  .template-search__search .reset__button .svg-wrapper,
  .template-search__search .reset__button svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* ===== BuzzKo empty search state ===== */
  .buzzko-search-empty {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    max-width: 78rem;
    min-height: 30rem;
    margin: 3rem auto 5rem;
    padding: 6rem 2.5rem;
    border: 1.5px solid #F8B5D1;
    border-radius: 2.4rem;
    background: #FFFAF5;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .buzzko-search-empty::before,
  .buzzko-search-empty::after {
    content: "";
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
  }

  .buzzko-search-empty::before {
    width: 19rem;
    height: 19rem;
    top: -9rem;
    left: -5rem;
    background: #F8B5D1;
    opacity: 0.35;
  }

  .buzzko-search-empty::after {
    width: 17rem;
    height: 17rem;
    right: -5rem;
    bottom: -8rem;
    background: #BEE3F8;
    opacity: 0.5;
  }

  .buzzko-search-empty__emoji {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6.5rem;
    height: 6.5rem;
    margin-bottom: 2rem;
    border-radius: 50%;
    background: #FFECB3;
    font-size: 3rem;
    line-height: 1;
    box-shadow: 4px 4px 0 #1A1A1A;
  }

  .buzzko-search-empty h2 {
    max-width: 55rem;
    margin: 0 0 1.2rem;
    color: #1A1A1A;
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .buzzko-search-empty p {
    max-width: 48rem;
    margin: 0;
    color: #6B6663;
    font-size: 1.5rem;
    line-height: 1.7;
  }

  .buzzko-search-empty .buzzko-search-contact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2.2rem;
    padding: 1.2rem 2.4rem;
    border: 1.5px solid #1A1A1A;
    border-radius: 999px;
    background: #F8B5D1;
    color: #1A1A1A;
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 3px 3px 0 #1A1A1A;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .buzzko-search-empty .buzzko-search-contact:hover {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 #1A1A1A;
  }

  .buzzko-search-empty__note {
    margin-top: 1.5rem;
    color: #96908B;
    font-size: 1.2rem;
  }

  @media screen and (max-width: 749px) {
    .template-search__header {
      margin-bottom: 2.5rem;
    }

    .template-search__header .buzzko-search-title {
      max-width: calc(100% - 2rem);
      font-size: clamp(2.7rem, 9vw, 3.8rem);
    }

    .template-search__search .search {
      margin-top: 2rem;
    }

    .template-search__search .field {
      min-height: 4.9rem;
    }

    .template-search__search .search__input {
      min-height: 4.7rem;
      padding-left: 1.6rem;
      font-size: 1.35rem;
    }

    .template-search__search .field__label {
      left: 1.6rem;
      font-size: 1.3rem;
    }

    .template-search__search .field__button {
      width: 3.4rem;
      height: 3.4rem;
      min-width: 3.4rem;
      margin: 0.6rem;
    }

    .template-search__search .field__button .svg-wrapper,
    .template-search__search .field__button svg {
      width: 1.4rem;
      height: 1.4rem;
    }

    .buzzko-search-empty {
      min-height: 27rem;
      margin: 2rem 1.5rem 3rem;
      padding: 4rem 2rem;
      border-radius: 1.8rem;
    }

    .buzzko-search-empty::before {
      width: 13rem;
      height: 13rem;
      top: -6rem;
      left: -5rem;
    }

    .buzzko-search-empty::after {
      width: 12rem;
      height: 12rem;
      right: -4rem;
      bottom: -5rem;
    }

    .buzzko-search-empty__emoji {
      width: 5.5rem;
      height: 5.5rem;
      font-size: 2.5rem;
    }

    .buzzko-search-empty h2 {
      font-size: 2.6rem;
    }

    .buzzko-search-empty p {
      font-size: 1.35rem;
    }
  }

  /* ===== BuzzKo product card styles (scoped to search) ===== */
  #ProductGridContainer {
    background: #FFFAF5;
  }

  #ProductGridContainer .product-grid {
    row-gap: 20px;
  }

  #ProductGridContainer .buzzko-product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: #faf8f6;
    border: 3px solid var(--card-border);
    border-radius: 18px;
    padding: 11px;
    color: inherit;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  #ProductGridContainer .buzzko-product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,0,0,.06);
  }

  #ProductGridContainer .buzzko-product-card__image-wrapper {
    width: 100%;
    aspect-ratio: 1.65 / 1;
    overflow: hidden;
    border-radius: 11px;
    background: #eee;
  }

  #ProductGridContainer .buzzko-product-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  #ProductGridContainer .buzzko-product-card__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform .3s ease;
  }

  #ProductGridContainer .buzzko-product-card:hover .buzzko-product-card__image {
    transform: scale(1.025);
  }

  #ProductGridContainer .buzzko-product-card__content {
    padding: 15px 6px 8px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  #ProductGridContainer .buzzko-product-card__title {
    margin: 0;
    color: #111;
    font-size: 15px;
    line-height: 1.3;
    font-weight: 800;
    letter-spacing: -.2px;
  }

  #ProductGridContainer .buzzko-product-card__title-link {
    color: inherit;
    text-decoration: none;
  }

  #ProductGridContainer .buzzko-product-card__subtitle {
    margin: 5px 0 0;
    color: #777;
    font-size: 12px;
    line-height: 1.35;
  }

  #ProductGridContainer .buzzko-product-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 17px;
  }

  #ProductGridContainer .buzzko-product-card__price {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  #ProductGridContainer .buzzko-product-card__price-current {
    color: #111;
    font-size: 15px;
    line-height: 1;
    font-weight: 800;
  }

  #ProductGridContainer .buzzko-product-card__price-compare {
    color: #999;
    font-size: 12px;
    text-decoration: line-through;
  }

  #ProductGridContainer .buzzko-product-card__form {
    margin: 0;
    flex-shrink: 0;
  }

  #ProductGridContainer .buzzko-product-card__atc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 7px 14px;
    background: #FF60B9;
    color: #201e1e;
    border: 0;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .3px;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
  }

  #ProductGridContainer .buzzko-product-card__atc:hover:not(:disabled) {
    background: #e469af;
  }

  #ProductGridContainer .buzzko-product-card__atc:disabled {
    background: #ccc;
    cursor: not-allowed;
  }

  #ProductGridContainer .buzzko-product-card__atc[data-state="loading"] {
    opacity: .7;
    cursor: wait;
  }

  #ProductGridContainer .buzzko-product-card__atc[data-state="success"] {
    background: #B9E404;
  }

  /* BuzzKo: force 2 products per row on mobile */
  @media screen and (max-width: 749px) {
    #ProductGridContainer .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      column-gap: 10px;
      row-gap: 14px;
    }

    #ProductGridContainer .product-grid .grid__item {
      width: 100%;
      max-width: 100%;
    }

    #ProductGridContainer .buzzko-product-card {
      padding: 7px;
      border-width: 2px;
      border-radius: 13px;
    }

    #ProductGridContainer .buzzko-product-card__image-wrapper {
      border-radius: 8px;
    }

    #ProductGridContainer .buzzko-product-card__content {
      padding: 10px 3px 5px;
    }

    #ProductGridContainer .buzzko-product-card__title {
      font-size: 13px;
      line-height: 1.25;
    }

    #ProductGridContainer .buzzko-product-card__subtitle {
      font-size: 10px;
      margin-top: 4px;
    }

    #ProductGridContainer .buzzko-product-card__footer {
      padding-top: 12px;
      gap: 6px;
    }

    #ProductGridContainer .buzzko-product-card__price-current {
      font-size: 13px;
    }

    #ProductGridContainer .buzzko-product-card__atc {
      padding: 6px 10px;
      font-size: 10px;
      min-height: 34px;
    }
  }
</style>

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% paginate search.results by 24 %}
  <div class="template-search{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %} section-{{ section.id }}-padding">
    <div class="template-search__header page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <h1 class="buzzko-search-title">
        {%- if search.performed -%}
          Here's all the good stuff
        {%- else -%}
          Find your little favourite
        {%- endif -%}
      </h1>
      <div class="template-search__search">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- endif -%}
        <main-search>
          <form action="{{ routes.search_url }}" method="get" role="search" class="search">
            <div class="field">
              <input
                class="search__input field__input"
                id="Search-In-Template"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'general.search.search' | t }}"
                {%- if settings.predictive_search_enabled -%}
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="predictive-search-results"
                  aria-controls="predictive-search-results"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                {%- endif -%}
              >

              <input name="options[prefix]" type="hidden" value="last">

              {%- if settings.predictive_search_enabled -%}
                <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
                  {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
                </div>

                <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
              {%- endif -%}

              <button
                type="reset"
                class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
                aria-label="{{ 'general.search.reset' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-reset.svg' | inline_asset_content -}}
                </span>
              </button>
              <button type="submit" class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                <span class="svg-wrapper">
                  {{- 'icon-search.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          </form>
        </main-search>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- endif -%}
      </div>

      {%- if search.performed -%}
        {%- unless section.settings.enable_filtering or section.settings.enable_sorting -%}
          {%- if search.results_count > 0 -%}
            <p role="status">
              {{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}
            </p>
          {%- endif -%}
        {%- endunless -%}

        {%- if search.results_count == 0 and search.filters == empty -%}
          <div class="buzzko-search-empty" role="status">
            <span class="buzzko-search-empty__emoji" aria-hidden="true">🔎</span>
            <h2>Didn't find your little favourite?</h2>
            <p>
              We couldn't find anything for “{{ search.terms | escape }}”.
              But don't worry, we're here to help you find it!
            </p>
            <a href="/pages/contact" class="buzzko-search-contact">
              Contact us
              <span aria-hidden="true">↗</span>
            </a>
            <span class="buzzko-search-empty__note">
              Let's find something you'll love.
            </span>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if search.performed -%}
      {%- if section.settings.enable_sorting
        and section.settings.filter_type == 'vertical'
        and search.filters != empty
      -%}
        <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
          <form class="facets-vertical-form" id="FacetSortForm">
            <div class="facet-filters sorting caption">
              <div class="facet-filters__field">
                <h2 class="facet-filters__label caption-large text-body">
                  <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
                </h2>
                <div class="select">
                  {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
                  <select
                    name="sort_by"
                    class="facet-filters__sort select__select caption-large"
                    id="SortBy"
                    aria-describedby="a11y-refresh-page-message"
                  >
                    {%- for option in search.sort_options -%}
                      <option
                        value="{{ option.value | escape }}"
                        {% if option.value == sort_by %}
                          selected="selected"
                        {% endif %}
                      >
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                  <span class="svg-wrapper">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </div>
              </div>
            </div>

            <div class="product-count-vertical light" role="status">
              <h2 class="product-count__text text-body">
                <span id="ProductCountDesktop">
  {{ search.products_count }} 
  {% if search.products_count == 1 %}
    product
  {% else %}
    products
  {% endif %}
</span>
              </h2>
              {%- render 'loading-spinner' -%}
            </div>
          </form>
        </facet-filters-form>
      {%- endif -%}

      <div
        {% if section.settings.filter_type == 'vertical' %}
          class="facets-vertical page-width"
        {% endif %}
      >
        {%- if search.filters != empty -%}
          {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
            <aside
              aria-labelledby="verticalTitle"
              class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="main-search-filters"
              data-id="{{ section.id }}"
            >
              {% render 'facets',
                results: search,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: section.settings.enable_sorting,
                filter_type: section.settings.filter_type,
                paginate: paginate
              %}
            </aside>
          {%- endif -%}
        {%- endif -%}

        <div class="product-grid-container" id="ProductGridContainer">
          {%- if search.results.size == 0 and search.filters != empty -%}
            <div
              class="template-search__results collection collection--empty{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <div class="buzzko-search-empty" role="status">
                <span class="buzzko-search-empty__emoji" aria-hidden="true">🔎</span>
                <h2>Didn't find your little favourite?</h2>
                <p>
                  We couldn't find anything for “{{ search.terms | escape }}”.
                  But don't worry, we're here to help you find it!
                </p>
                <a href="{{ routes.contact_url }}" class="buzzko-search-contact">
                  Contact us
                  <span aria-hidden="true">↗</span>
                </a>
                <span class="buzzko-search-empty__note">
                  Let's find something you'll love.
                </span>
              </div>
            </div>
          {%- else -%}
            <div
              class="template-search__results collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <ul
                class="grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
                role="list"
              >
                {%- assign skip_card_product_styles = false -%}
                {%- assign buzzko_index = 0 -%}
                {%- for item in search.results -%}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}

                  <li
                    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                    {% endif %}
                  >
                    {%- case item.object_type -%}
                      {%- when 'product' -%}
                        {%- assign product = item -%}
                        {%- assign variant = product.selected_or_first_available_variant -%}
                        {%- assign border_index = buzzko_index | modulo: 6 -%}
                        {%- case border_index -%}
                          {%- when 0 -%}{%- assign card_border = '#F7CFCF' -%}
                          {%- when 1 -%}{%- assign card_border = '#B9E404' -%}
                          {%- when 2 -%}{%- assign card_border = '#9DDCF7' -%}
                          {%- when 3 -%}{%- assign card_border = '#FFD96A' -%}
                          {%- when 4 -%}{%- assign card_border = '#CDB8F5' -%}
                          {%- else -%}{%- assign card_border = '#FF9FC8' -%}
                        {%- endcase -%}

                        <div class="buzzko-product-card" style="--card-border: {{ card_border }};">
                          <joy-wishlist-button
                            type="collection"
                            product-handle="{{ product.handle }}"
                            class="buzzko-wishlist-button"
                            style="position: absolute; top: 8px; right: 8px; z-index: 10;"
                          ></joy-wishlist-button>

                          <div class="buzzko-product-card__image-wrapper">
                            <a href="{{ product.url }}" class="buzzko-product-card__image-link" aria-label="{{ product.title | escape }}">
                              {% if product.featured_image != blank %}
                                {% assign image_alt = product.featured_image.alt | default: product.title %}
                                {{
                                  product.featured_image
                                  | image_url: width: 700
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '300,450,600,700',
                                    sizes: '(min-width: 990px) 22vw, (min-width: 750px) 45vw, 90vw',
                                    alt: image_alt,
                                    class: 'buzzko-product-card__image'
                                }}
                              {% else %}
                                {{ 'product-1' | placeholder_svg_tag: 'buzzko-product-card__placeholder' }}
                              {% endif %}
                            </a>
                          </div>

                          <div class="buzzko-product-card__content">
                            <h3 class="buzzko-product-card__title">
                              <a href="{{ product.url }}" class="buzzko-product-card__title-link">
                                {{ product.title }}
                              </a>
                            </h3>

                            {% if section.settings.card_subtitle != blank %}
                              <p class="buzzko-product-card__subtitle">
                                {{ section.settings.card_subtitle }}
                              </p>
                            {% endif %}

                            <div class="buzzko-product-card__footer">
                              <div class="buzzko-product-card__price">
                                {% if product.compare_at_price > product.price %}
                                  <span class="buzzko-product-card__price-current">{{ product.price | money }}</span>
                                  <span class="buzzko-product-card__price-compare">{{ product.compare_at_price | money }}</span>
                                {% else %}
                                  <span class="buzzko-product-card__price-current">{{ product.price | money }}</span>
                                {% endif %}
                              </div>

                              <form action="/cart/add" method="post" class="buzzko-product-card__form" data-buzzko-atc>
                                <input type="hidden" name="id" value="{{ variant.id }}">
                                <button
                                  type="submit"
                                  name="add"
                                  class="buzzko-product-card__atc"
                                  data-label-default="Add to Cart"
                                  data-label-loading="Adding…"
                                  data-label-success="Added ✓"
                                  {% unless variant.available %}disabled{% endunless %}
                                >
                                  {% if variant.available %}Add to Cart{% else %}Sold Out{% endif %}
                                </button>
                              </form>
                            </div>
                          </div>
                        </div>
                        {%- assign buzzko_index = buzzko_index | plus: 1 -%}

                      {%- when 'article' -%}
                        {% render 'article-card',
                          article: item,
                          show_image: true,
                          show_date: section.settings.article_show_date,
                          show_author: section.settings.article_show_author,
                          show_badge: true,
                          media_aspect_ratio: 1,
                          lazy_load: lazy_load
                        %}

                      {%- when 'page' -%}
                        <div class="article-card-wrapper card-wrapper underline-links-hover">
                          <div
                            class="card card--card card--text ratio color-{{ settings.blog_card_color_scheme }}"
                            style="--ratio-percent: 100%;"
                          >
                            <div class="card__content">
                              <div class="card__information">
                                <h3 class="card__heading">
                                  <a href="{{ item.url }}" class="full-unstyled-link">
                                    {{ item.title | truncate: 50 | escape }}
                                  </a>
                                </h3>
                              </div>
                              <div class="card__badge {{ settings.badge_position }}">
                                <span class="badge color-{{ settings.color_schemes | first }}">
                                  {{- 'templates.search.page' | t -}}
                                </span>
                              </div>
                            </div>
                          </div>
                        </div>
                    {%- endcase -%}
                  </li>
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{% endpaginate %}

{% if section.settings.image_shape == 'arch' %}
  {{ 'mask-arch.svg' | inline_asset_content }}
{%- endif -%}

<script>
(function () {
  var root = document.getElementById('ProductGridContainer');
  if (!root || root.dataset.buzzkoAtcInit === 'true') return;
  root.dataset.buzzkoAtcInit = 'true';

  // Respect locale/market subfolders (e.g. /en/cart/add.js)
  var ROOT = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

  /* ---------- helpers ---------- */

  function state(button, value, label) {
    if (value) button.setAttribute('data-state', value);
    else button.removeAttribute('data-state');
    if (typeof label === 'string') button.textContent = label;
  }

  // Parse an HTML string and pull a specific element out of it.
  function pick(html, selector) {
    if (!html) return null;
    return new DOMParser().parseFromString(html, 'text/html').querySelector(selector);
  }

  /**
   * Render the section HTML that /cart/add.js returns when you pass
   * `sections=cart-drawer,cart-icon-bubble`. This is what actually creates
   * the cart-count bubble on the very first add of a session — the bubble
   * simply isn't in the DOM while the cart is empty.
   */
  function renderSections(sections) {
    if (!sections) return;

    // 1. Cart drawer (Dawn-style)
    var drawer = document.querySelector('cart-drawer');
    if (drawer && sections['cart-drawer']) {
      var currentInner = drawer.querySelector('.drawer__inner');
      var freshInner = pick(sections['cart-drawer'], '.drawer__inner');
      if (currentInner && freshInner) {
        currentInner.innerHTML = freshInner.innerHTML;
      }
    }

    // 2. Cart count bubble — creates it on the first add of the session
    if (sections['cart-icon-bubble']) {
      var oldBubble = document.querySelector('.cart-count-bubble');
      var host =
        document.getElementById('cart-icon-bubble') ||
        (oldBubble && oldBubble.parentElement);

      if (host) {
        var newBubble = pick(sections['cart-icon-bubble'], '.cart-count-bubble');
        if (newBubble) {
          if (oldBubble) oldBubble.replaceWith(newBubble);
          else host.appendChild(newBubble);   // <-- first-add case
        } else if (oldBubble) {
          oldBubble.remove();                 // cart emptied
        }
      }
    }
  }

  // Fallback: patch any count nodes already in the DOM.
  function updateCounts(cart) {
    if (!cart || typeof cart.item_count !== 'number') return;
    document.querySelectorAll('[data-cart-count], .cart-count').forEach(function (el) {
      var next = String(cart.item_count);
      if (el.textContent !== next) el.textContent = next;
    });
  }

  function openDrawer() {
    var drawer = document.querySelector('cart-drawer');
    if (drawer && typeof drawer.open === 'function') {
      try { drawer.open(); } catch (e) { /* noop */ }
    }
  }

  /* ---------- main handler (delegated on #ProductGridContainer) ---------- */

  root.addEventListener('submit', function (event) {
    var form = event.target;
    if (!form.matches('[data-buzzko-atc]')) return;

    event.preventDefault();

    var button = form.querySelector('.buzzko-product-card__atc');
    if (!button || button.disabled || button.dataset.state === 'loading') return;

    var normal = button.dataset.labelDefault || 'Add to Cart';
    state(button, 'loading', button.dataset.labelLoading || 'Adding…');
    button.disabled = true;

    var data = new FormData(form);
    data.append('sections', 'cart-drawer,cart-icon-bubble');
    data.append('sections_url', window.location.pathname);

    fetch(ROOT + 'cart/add.js', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: data
    })
      .then(function (res) {
        return res.json().then(function (json) {
          if (!res.ok) throw json;
          return json;
        });
      })
      .then(function (added) {
        // 1) Inject server-rendered sections — creates the count bubble
        //    on the first add of the session.
        renderSections(added.sections);

        // 2) Fetch fresh cart state and patch any remaining count nodes.
        return fetch(ROOT + 'cart.js', {
          headers: { 'Accept': 'application/json' }
        })
          .then(function (res) { return res.json(); })
          .then(function (cart) {
            updateCounts(cart);
            openDrawer();
          });
      })
      .then(function () {
        state(button, 'success', button.dataset.labelSuccess || 'Added ✓');

        setTimeout(function () {
          state(button, '', normal);
          button.disabled = false;
        }, 1400);
      })
      .catch(function (error) {
        console.error('[BuzzKo ATC]', error);
        state(button, '', 'Try again');
        button.disabled = false;

        setTimeout(function () {
          state(button, '', normal);
        }, 1600);
      });
  });
})();
</script>

{% schema %}
{
  "name": "t:sections.main-search.name",
