{% comment %}
  BuzzKo - Trending Products
{% endcomment %}

<section
  id="buzzko-trending-{{ section.id }}"
  class="buzzko-trending"
>
  <div class="buzzko-trending__container">

    <div class="buzzko-trending__header">
      <h2 class="buzzko-trending__heading">
        {{ section.settings.heading }}<span class="buzzko-trending__sparkles">✦</span>
      </h2>

      {% if section.settings.show_view_all and section.settings.view_all_link != blank %}
        {%- assign view_all_url = section.settings.view_all_link -%}
        {%- if view_all_url contains '?' -%}
          {%- assign view_all_url = view_all_url | append: '&sort_by=best-selling' -%}
        {%- else -%}
          {%- assign view_all_url = view_all_url | append: '?sort_by=best-selling' -%}
        {%- endif -%}

        <a href="{{ view_all_url }}" class="buzzko-trending__view-all">
          {{ section.settings.view_all_text }}
          <svg
            class="buzzko-trending__arrow"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      {% endif %}
    </div>

    <div class="buzzko-trending__grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        
        {% if product != blank %}

          {% comment %} Resolve the chosen variant (falls back to first/selected) {% endcomment %}
          {%- assign selected_variant = product.selected_or_first_available_variant -%}
          {%- assign variant_input = block.settings.variant_id | strip -%}
          {%- if variant_input != blank -%}
            {%- for v in product.variants -%}
              {%- assign v_id_str = v.id | append: '' -%}
              {%- if v_id_str == variant_input -%}
                {%- assign selected_variant = v -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {% render 'buzzko-product-card',
             product: product,
             variant: selected_variant,
             index: forloop.index0,
             card_subtitle: block.settings.subtitle
          %}
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
  #buzzko-trending-{{ section.id }} {
    background: {{ section.settings.section_bg_color }};
    padding: 24px 0;
  }

  #buzzko-trending-{{ section.id }} .buzzko-trending__container {
    width: min(1380px, calc(100% - 64px));
    margin: 0 auto;
    padding: 56px 56px 60px;

    background: linear-gradient(
      135deg,
      {{ section.settings.gradient_color_1 }} 0%,
      {{ section.settings.gradient_color_2 }} 50%,
      {{ section.settings.gradient_color_3 }} 100%
    );
    background-size: 200% 200%;
    border-radius: 28px;
    animation: buzzkoTrendingShift 20s ease-in-out infinite;
  }

  @keyframes buzzkoTrendingShift {
    0% { background-position: 0% 0%; }
    50% { background-position: 100% 100%; }
    100% { background-position: 0% 0%; }
  }

  @media (prefers-reduced-motion: reduce) {
    #buzzko-trending-{{ section.id }} .buzzko-trending__container {
      animation: none;
    }
  }

  #buzzko-trending-{{ section.id }} .buzzko-trending__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 48px;
  }

  #buzzko-trending-{{ section.id }} .buzzko-trending__heading {
    margin: 0;
    font-size: 38px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: -1.5px;
    color: #111;
  }

  #buzzko-trending-{{ section.id }} .buzzko-trending__sparkles {
    display: inline-block;
    margin-left: 8px;
    font-size: 30px;
    font-weight: 400;
    vertical-align: middle;
  }

  #buzzko-trending-{{ section.id }} .buzzko-trending__view-all {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #111;
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    transition: color 0.2s ease;
  }

  #buzzko-trending-{{ section.id }} .buzzko-trending__arrow {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    display: block;
    transition: transform 0.25s cubic-bezier(0.3, 1.2, 0.5, 1);
  }

  #buzzko-trending-{{ section.id }} .buzzko-trending__view-all:hover {
    color: #FF60B9;
  }

  #buzzko-trending-{{ section.id }} .buzzko-trending__view-all:hover .buzzko-trending__arrow {
    transform: translateX(5px);
  }

  #buzzko-trending-{{ section.id }} .buzzko-trending__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  @media screen and (max-width: 989px) {
    #buzzko-trending-{{ section.id }} .buzzko-trending__container {
      width: min(100% - 32px, 700px);
      padding: 40px 32px 44px;
      border-radius: 24px;
    }

    #buzzko-trending-{{ section.id }} .buzzko-trending__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
  }

  @media screen and (max-width: 749px) {
    #buzzko-trending-{{ section.id }} {
      padding: 12px 0;
    }

    #buzzko-trending-{{ section.id }} .buzzko-trending__container {
      width: calc(100% - 24px);
      padding: 32px 20px 36px;
      border-radius: 20px;
    }

    #buzzko-trending-{{ section.id }} .buzzko-trending__header {
      margin-bottom: 24px;
    }

    #buzzko-trending-{{ section.id }} .buzzko-trending__heading {
      font-size: 26px;
      letter-spacing: -1px;
    }

    #buzzko-trending-{{ section.id }} .buzzko-trending__sparkles {
      font-size: 20px;
      margin-left: 4px;
    }

    #buzzko-trending-{{ section.id }} .buzzko-trending__view-all {
      gap: 8px;
      font-size: 13px;
    }

    #buzzko-trending-{{ section.id }} .buzzko-trending__arrow {
      width: 15px;
      height: 15px;
    }

    #buzzko-trending-{{ section.id }} .buzzko-trending__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      overflow: visible;
    }
  }
</style>

{% schema %}
{
  "name": "BuzzKo Trending Products",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Now"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background",
      "default": "#FFFAF5"
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Card background — gradient color 1",
      "default": "#FFDCEF"
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Card background — gradient color 2",
      "default": "#F3F9D2"
    },
    {
      "type": "color",
      "id": "gradient_color_3",
      "label": "Card background — gradient color 3",
      "default": "#FFDCEF"
    },
    {
      "type": "header",
      "content": "View All"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "See All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "header",
          "content": "Variant"
        },
        {
          "type": "text",
          "id": "variant_id",
          "label": "Variant ID",
          "info": "Optional. Paste the variant ID so this card shows that specific variant's image. Find it in the product admin → Variants → click the variant → the number at the end of the URL (e.g. …/variants/45123456789012). If left empty, the first available variant is used."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Card Border Color",
          "info": "Note: The global card snippet auto-assigns pastel borders based on position. This setting is ignored for consistency.",
          "default": "#F7CFCF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BuzzKo Trending Products",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}