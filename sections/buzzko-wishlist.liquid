
<section class="buzzko-wishlist" data-buzzko-wishlist-page>
  {% if customer %}

    <div class="buzzko-wishlist__inner page-width">
      <header class="buzzko-wishlist__header">
        <p class="buzzko-wishlist__eyebrow">YOUR LITTLE COLLECTION</p>
        <h1 class="buzzko-wishlist__title">
          {{ section.settings.heading | escape }}
          <span class="buzzko-wishlist__sparkle" aria-hidden="true">✦</span>
        </h1>
        {% if section.settings.description != blank %}
          <p class="buzzko-wishlist__description">
            {{ section.settings.description | escape }}
          </p>
        {% endif %}
      </header>

      <div class="buzzko-wishlist__action-row">
        <p class="buzzko-wishlist__count" data-buzzko-wishlist-page-count>
          Your saved favourites
        </p>
        <a class="buzzko-wishlist__continue" href="{{ routes.all_products_collection_url }}">
          Continue exploring <span aria-hidden="true">→</span>
        </a>
      </div>

      <p class="buzzko-wishlist__loading" data-buzzko-wishlist-loading hidden aria-live="polite">
        Gathering your favourites…
      </p>

      <div class="buzzko-wishlist__empty" data-buzzko-wishlist-empty hidden>
        <div class="buzzko-wishlist__empty-icon" aria-hidden="true">♡</div>
        <h2>Your wishlist is waiting for a little love.</h2>
        <p>Your favourite finds will live here. Spot something you love? Save it for later.</p>
        <a href="{{ routes.all_products_collection_url }}" class="buzzko-wishlist__shop">
          Explore all products <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="buzzko-wishlist__grid" data-buzzko-wishlist-grid></div>
    </div>

  {% else %}

    <div class="buzzko-wishlist__login-wrap">
      <div class="buzzko-wishlist__login-card">
        <span class="buzzko-wishlist__login-heart" aria-hidden="true">♡</span>
        <p class="buzzko-wishlist__eyebrow">A LITTLE SPACE JUST FOR YOU</p>
        <h1 class="buzzko-wishlist__login-title">Your favourites deserve a home.</h1>
        <p class="buzzko-wishlist__login-description">
          Log in to see your wishlist and keep your favourite finds close.
        </p>

        <a
          class="buzzko-wishlist__login-button buzzko-wishlist__login-button--primary"
          href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}"
        >
          Log in to your account
        </a>

        <a
          class="buzzko-wishlist__login-button buzzko-wishlist__login-button--secondary"
          href="{{ routes.account_register_url }}?return_url={{ request.path | url_encode }}"
        >
          Create an account
        </a>
      </div>
    </div>

  {% endif %}
</section>

<style>
  .buzzko-wishlist {
    padding: 48px 0 72px;
    background: #FFFAF5;
    color: #1A1A1A;
    min-height: 50vh;
  }

  .buzzko-wishlist__inner {
    max-width: 1380px;
    margin: 0 auto;
  }

  .buzzko-wishlist__header {
    max-width: 680px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .buzzko-wishlist__eyebrow {
    margin: 0 0 14px;
    color: #6B6663;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .16em;
    line-height: 1.4;
  }

  .buzzko-wishlist__title {
    margin: 0;
    color: #1A1A1A;
    font-family: var(--font-heading-family);
    font-size: clamp(34px, 4.2vw, 52px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -.04em;
  }

  .buzzko-wishlist__sparkle {
    display: inline-block;
    color: #FF60B9;
    font-size: .55em;
    vertical-align: middle;
    transform: translateY(-.05em) rotate(-8deg);
  }

  .buzzko-wishlist__description {
    max-width: 460px;
    margin: 14px auto 0;
    color: #6B6663;
    font-size: 15px;
    line-height: 1.55;
  }

  .buzzko-wishlist__action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 16px 0;
    margin-bottom: 28px;
    border-top: 1px solid rgba(26, 26, 26, .08);
    border-bottom: 1px solid rgba(26, 26, 26, .08);
  }

  .buzzko-wishlist__count {
    margin: 0;
    color: #6B6663;
    font-size: 14px;
    font-weight: 650;
  }

  .buzzko-wishlist__continue {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #1A1A1A;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .buzzko-wishlist__continue:hover {
    color: #C84A91;
  }

  .buzzko-wishlist__continue span,
  .buzzko-wishlist__shop span {
    transition: transform .18s ease;
  }

  .buzzko-wishlist__continue:hover span,
  .buzzko-wishlist__shop:hover span {
    transform: translateX(3px);
  }

  .buzzko-wishlist__loading {
    margin: 0 0 18px;
    color: #6B6663;
    font-size: 13px;
    text-align: center;
  }

  /* Skeleton placeholders only. Real product cards keep their existing styles. */

/* Skeletons reuse the real BuzzKo product-card layout */
.buzzko-wishlist .buzzko-wishlist__skeleton-image,
.buzzko-wishlist .buzzko-wishlist__skeleton-line,
.buzzko-wishlist .buzzko-wishlist__skeleton-button {
  background: linear-gradient(
    100deg,
    #FFE9F3 20%,
    #FFF8FB 40%,
    #FFE9F3 60%
  );
  background-size: 220% 100%;
  animation: buzzko-skeleton-shimmer 1.4s ease-in-out infinite;
}

.buzzko-wishlist .buzzko-wishlist__skeleton-image {
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.buzzko-wishlist .buzzko-wishlist__skeleton-line {
  height: 12px;
  border-radius: 999px;
}

.buzzko-wishlist .buzzko-wishlist__skeleton-line--title {
  width: 78%;
  height: 15px;
  margin-bottom: 10px;
}

.buzzko-wishlist .buzzko-wishlist__skeleton-line--subtitle {
  width: 48%;
}

.buzzko-wishlist .buzzko-wishlist__skeleton-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: auto;
  padding-top: 17px;
}

.buzzko-wishlist .buzzko-wishlist__skeleton-line--price {
  width: 30%;
  height: 15px;
}

.buzzko-wishlist .buzzko-wishlist__skeleton-button {
  width: 82px;
  height: 34px;
  border-radius: 999px;
}

@keyframes buzzko-skeleton-shimmer {
  from { background-position: 100% 0; }
  to { background-position: -120% 0; }
}

@media screen and (max-width: 749px) {
  .buzzko-wishlist .buzzko-wishlist__skeleton-line--title {
    height: 13px;
  }

  .buzzko-wishlist .buzzko-wishlist__skeleton-footer {
    padding-top: 12px;
    gap: 6px;
  }

  .buzzko-wishlist .buzzko-wishlist__skeleton-button {
    width: 64px;
    height: 30px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .buzzko-wishlist .buzzko-wishlist__skeleton-image,
  .buzzko-wishlist .buzzko-wishlist__skeleton-line,
  .buzzko-wishlist .buzzko-wishlist__skeleton-button {
    animation: none;
  }
}


  /* Empty state */
  .buzzko-wishlist__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    box-sizing: border-box;
    max-width: 560px;
    margin: 24px auto;
    padding: 60px 28px;
    border: 1.5px solid #FFDCEF;
    border-radius: 24px;
    background:
      radial-gradient(ellipse at 15% 20%, #F8B5D1 0, transparent 30%),
      radial-gradient(ellipse at 85% 25%, #BEE3F8 0, transparent 30%),
      radial-gradient(ellipse at 80% 85%, #D0F4DE 0, transparent 28%),
      radial-gradient(ellipse at 15% 85%, #FFECB3 0, transparent 26%),
      #FFF9F6;
    text-align: center;
  }

  .buzzko-wishlist__empty[hidden],
  .buzzko-wishlist__loading[hidden] {
    display: none !important;
  }

  .buzzko-wishlist__empty-icon,
  .buzzko-wishlist__login-heart {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    flex: 0 0 auto;
    border: 1px solid #FFDCEF;
    border-radius: 50%;
    background: #FFFFFF;
    color: #FF60B9;
    font-family: Arial, sans-serif;
    font-size: 42px;
    line-height: 1;
    box-shadow: 0 5px 18px rgba(255, 96, 185, .12);
  }

  .buzzko-wishlist__empty h2 {
    margin: 0;
    color: #1A1A1A;
    font-family: var(--font-heading-family);
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -.035em;
  }

  .buzzko-wishlist__empty p {
    max-width: 380px;
    margin: 0;
    color: #6B6663;
    font-size: 14px;
    line-height: 1.55;
  }

  .buzzko-wishlist__shop {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    margin-top: 8px;
    padding: 0 24px;
    border: 0;
    border-radius: 999px;
    background: #FF60B9;
    color: #1A1A1A;
    font-size: 14px;
    font-weight: 750;
    text-decoration: none;
    transition: background .15s ease, transform .15s ease;
  }

  .buzzko-wishlist__shop:hover {
    background: #E469AF;
    color: #1A1A1A;
    transform: translateY(-1px);
  }

  /* Logged-out state */
  .buzzko-wishlist__login-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    padding: 16px 20px 24px;
  }

  .buzzko-wishlist__login-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    width: 100%;
    max-width: 620px;
    min-height: 390px;
    padding: 48px 40px;
    overflow: hidden;
    border: 2px solid #FFDCEF;
    border-radius: 28px;
    background:
      radial-gradient(circle at 10% 15%, rgba(255, 96, 185, .16), transparent 28%),
      radial-gradient(circle at 90% 20%, rgba(157, 220, 247, .24), transparent 28%),
      radial-gradient(circle at 85% 90%, rgba(255, 217, 106, .22), transparent 30%),
      #FFF9F6;
    text-align: center;
    box-shadow: 0 12px 35px rgba(26, 26, 26, .06);
  }

  .buzzko-wishlist__login-heart {
    margin-bottom: 22px;
  }

  .buzzko-wishlist__login-card .buzzko-wishlist__eyebrow {
    margin-bottom: 12px;
  }

  .buzzko-wishlist__login-title {
    max-width: 460px;
    margin: 0 0 12px;
    color: #1A1A1A;
    font-family: var(--font-heading-family);
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -.035em;
  }

  .buzzko-wishlist__login-description {
    max-width: 420px;
    margin: 0 0 26px;
    color: #6B6663;
    font-size: 14px;
    line-height: 1.55;
  }

  .buzzko-wishlist__login-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    max-width: 260px;
    min-height: 46px;
    padding: 12px 24px;
    border: 1.5px solid transparent;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    transition: transform .15s ease, background .15s ease, color .15s ease;
  }

  .buzzko-wishlist__login-button:hover {
    transform: translateY(-2px);
  }

  .buzzko-wishlist__login-button--primary {
    margin-bottom: 10px;
    border-color: #FF60B9;
    background: #FF60B9;
    color: #1A1A1A;
  }

  .buzzko-wishlist__login-button--primary:hover {
    border-color: #E469AF;
    background: #E469AF;
    color: #1A1A1A;
  }

  .buzzko-wishlist__login-button--secondary {
    border-color: rgba(26, 26, 26, .14);
    background: #FFFFFF;
    color: #1A1A1A;
  }

  .buzzko-wishlist__login-button--secondary:hover {
    border-color: #1A1A1A;
    background: #1A1A1A;
    color: #FFFAF5;
  }

  @media screen and (max-width: 749px) {
    .buzzko-wishlist {
      padding: 32px 0 48px;
    }

    .buzzko-wishlist__header {
      margin-bottom: 26px;
    }

    .buzzko-wishlist__title {
      font-size: 32px;
    }

    .buzzko-wishlist__description {
      font-size: 14px;
    }

    .buzzko-wishlist__action-row {
      padding: 12px 0;
      margin-bottom: 22px;
      gap: 12px;
    }

    .buzzko-wishlist__count,
    .buzzko-wishlist__continue {
      font-size: 12px;
    }

    .buzzko-wishlist__skeleton {
      padding: 7px;
      border-width: 2px;
      border-radius: 13px;
    }

    .buzzko-wishlist__skeleton-image {
      border-radius: 8px;
    }

    .buzzko-wishlist__skeleton-content {
      padding: 10px 3px 5px;
    }

    .buzzko-wishlist__skeleton-footer {
      gap: 6px;
    }

    .buzzko-wishlist__skeleton-button {
      width: 64px;
      height: 28px;
    }

    .buzzko-wishlist__empty {
      gap: 12px;
      padding: 46px 22px;
      border-radius: 20px;
    }

    .buzzko-wishlist__empty-icon,
    .buzzko-wishlist__login-heart {
      width: 62px;
      height: 62px;
      font-size: 36px;
    }

    .buzzko-wishlist__empty h2 {
      font-size: 22px;
    }

    .buzzko-wishlist__empty p {
      font-size: 13px;
    }

    .buzzko-wishlist__login-wrap {
      padding: 0 12px;
    }

    .buzzko-wishlist__login-card {
      min-height: 0;
      padding: 40px 22px;
      border-radius: 22px;
    }

    .buzzko-wishlist__login-title {
      font-size: 26px;
    }

    .buzzko-wishlist__login-description {
      font-size: 13px;
      margin-bottom: 24px;
    }

    .buzzko-wishlist__login-button {
      max-width: 240px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .buzzko-wishlist__skeleton-image,
    .buzzko-wishlist__skeleton-line,
    .buzzko-wishlist__skeleton-button {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "BuzzKo Wishlist",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Wishlist"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "All the little things you have your eye on."
    }
  ],
  "presets": [
    {
      "name": "BuzzKo Wishlist"
    }
  ]
}
{% endschema %}
