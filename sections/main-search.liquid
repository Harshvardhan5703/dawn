{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif %}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

<style>
  .template-search__header {
    margin-bottom: 3rem;
  }

  .template-search__search {
    margin: 0 auto 3.5rem;
    max-width: 74.1rem;
  }

  .template-search__search .search {
    margin-top: 3rem;
  }

  .template-search--empty {
    padding-bottom: 18rem;
  }

  @media screen and (min-width: 750px) {
    .template-search__header {
      margin-bottom: 5rem;
    }
  }

  .search__button .icon {
    height: 1.8rem;
  }

  /* ===== BuzzKo search page styling ===== */
  .template-search {
    background: #FFFAF5;
  }

  .template-search__header {
    text-align: center;
  }

  .template-search__header .buzzko-search-title {
    position: relative;
    display: inline-block;
    margin: 0 auto;
    color: #1A1A1A;
    font-size: clamp(2.8rem, 5vw, 5.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .template-search__header .buzzko-search-title::after {
    content: "✦";
    position: absolute;
    top: -0.3em;
    right: -0.65em;
    color: #FF60B9;
    font-size: 0.42em;
    transform: rotate(12deg);
  }

  .template-search__search {
    max-width: 68rem;
  }

  .template-search__search .search {
    margin-top: 2.4rem;
  }

  .template-search__search .field {
    min-height: 5.4rem;
    overflow: hidden;
    border: 1.5px solid #D8D1CB;
    border-radius: 999px;
    background: #fff;
    box-shadow: none;
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  .template-search__search .field:focus-within {
    border-color: #FF60B9;
    box-shadow: 0 0 0 2px rgba(255, 96, 185, .12);
  }

  .template-search__search .field::before,
  .template-search__search .field::after {
    content: none;
  }

  .template-search__search .search__input {
    min-height: 5.2rem;
    padding: 0 1.6rem 0 2rem;
    border: 0;
    box-shadow: none;
    background: transparent;
    color: #1A1A1A;
    font-size: 1.45rem;
    line-height: 1.4;
  }

  .template-search__search .search__input::placeholder {
    color: #96908B;
    opacity: 1;
  }

  .template-search__search .field__label {
    left: 2rem;
    color: #96908B;
    font-size: 1.4rem;
  }

  .template-search__search .search__input:not(:placeholder-shown) + .field__label,
  .template-search__search .search__input:focus + .field__label {
    opacity: 0;
    visibility: hidden;
  }

  .template-search__search .field__button {
    width: 3.8rem;
    height: 3.8rem;
    min-width: 3.8rem;
    margin: 0.7rem;
    padding: 0;
    border-radius: 50%;
    background: transparent;
    color: #77716D;
    transition: background .2s ease, color .2s ease;
  }

  .template-search__search .field__button:hover {
    background: #FFF0F8;
    color: #1A1A1A;
  }

  .template-search__search .field__button .svg-wrapper,
  .template-search__search .field__button svg {
    width: 1.55rem;
    height: 1.55rem;
  }

  .template-search__search .reset__button {
    color: #9A938D;
  }

  .template-search__search .reset__button .svg-wrapper,
  .template-search__search .reset__button svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* ===== BuzzKo: minimum character hint ===== */
  .template-search__search .search-min-chars-message {
    display: none;
    margin: 1rem 0 0;
    padding: 0 2rem;
    color: #B05A2B;
    font-size: 1.3rem;
    line-height: 1.5;
    text-align: left;
  }

  .template-search__search .search-min-chars-message.is-visible {
    display: block;
  }

  /* ===== BuzzKo empty search state ===== */
  .buzzko-search-empty {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    max-width: 78rem;
    min-height: 30rem;
    margin: 3rem auto 5rem;
    padding: 6rem 2.5rem;
    border: 1.5px solid #F8B5D1;
    border-radius: 2.4rem;
    background: #FFFAF5;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .buzzko-search-empty::before,
  .buzzko-search-empty::after {
    content: "";
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
  }

  .buzzko-search-empty::before {
    width: 19rem;
    height: 19rem;
    top: -9rem;
    left: -5rem;
    background: #F8B5D1;
    opacity: 0.35;
  }

  .buzzko-search-empty::after {
    width: 17rem;
    height: 17rem;
    right: -5rem;
    bottom: -8rem;
    background: #BEE3F8;
    opacity: 0.5;
  }

  .buzzko-search-empty__emoji {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6.5rem;
    height: 6.5rem;
    margin-bottom: 2rem;
    border-radius: 50%;
    background: #FFECB3;
    font-size: 3rem;
    line-height: 1;
    box-shadow: 4px 4px 0 #1A1A1A;
  }

  .buzzko-search-empty h2 {
    max-width: 55rem;
    margin: 0 0 1.2rem;
    color: #1A1A1A;
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .buzzko-search-empty p {
    max-width: 48rem;
    margin: 0;
    color: #6B6663;
    font-size: 1.5rem;
    line-height: 1.7;
  }

  .buzzko-search-empty .buzzko-search-contact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2.2rem;
    padding: 1.2rem 2.4rem;
    border: 1.5px solid #1A1A1A;
    border-radius: 999px;
    background: #F8B5D1;
    color: #1A1A1A;
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 3px 3px 0 #1A1A1A;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .buzzko-search-empty .buzzko-search-contact:hover {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 #1A1A1A;
  }

  .buzzko-search-empty__note {
    margin-top: 1.5rem;
    color: #96908B;
    font-size: 1.2rem;
  }

  @media screen and (max-width: 749px) {
    .template-search__header {
      margin-bottom: 2.5rem;
    }

    .template-search__header .buzzko-search-title {
      max-width: calc(100% - 2rem);
      font-size: clamp(2.7rem, 9vw, 3.8rem);
    }

    .template-search__search .search {
      margin-top: 2rem;
    }

    .template-search__search .field {
      min-height: 4.9rem;
    }

    .template-search__search .search__input {
      min-height: 4.7rem;
      padding-left: 1.6rem;
      font-size: 1.35rem;
    }

    .template-search__search .field__label {
      left: 1.6rem;
      font-size: 1.3rem;
    }

    .template-search__search .field__button {
      width: 3.4rem;
      height: 3.4rem;
      min-width: 3.4rem;
      margin: 0.6rem;
    }

    .template-search__search .field__button .svg-wrapper,
    .template-search__search .field__button svg {
      width: 1.4rem;
      height: 1.4rem;
    }

    .template-search__search .search-min-chars-message {
      padding: 0 1.6rem;
      font-size: 1.25rem;
    }

    .buzzko-search-empty {
      min-height: 27rem;
      margin: 2rem 1.5rem 3rem;
      padding: 4rem 2rem;
      border-radius: 1.8rem;
    }

    .buzzko-search-empty::before {
      width: 13rem;
      height: 13rem;
      top: -6rem;
      left: -5rem;
    }

    .buzzko-search-empty::after {
      width: 12rem;
      height: 12rem;
      right: -4rem;
      bottom: -5rem;
    }

    .buzzko-search-empty__emoji {
      width: 5.5rem;
      height: 5.5rem;
      font-size: 2.5rem;
    }

    .buzzko-search-empty h2 {
      font-size: 2.6rem;
    }

    .buzzko-search-empty p {
      font-size: 1.35rem;
    }
  }

  /* ============================================================
     BuzzKo: FORCE 2 products per row on mobile.
     ============================================================ */
  @media screen and (max-width: 749px) {
    #ProductGridContainer #product-grid.product-grid,
    #ProductGridContainer .product-grid {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      grid-auto-flow: row !important;
      column-gap: 10px !important;
      row-gap: 14px !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      list-style: none !important;
    }

    #ProductGridContainer .product-grid > .grid__item {
      display: block !important;
      width: auto !important;
      max-width: none !important;
      min-width: 0 !important;
      flex: 0 0 auto !important;
      grid-column: auto !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    #ProductGridContainer .product-grid > .grid__item:only-child {
      grid-column: span 2 !important;
    }
  }
</style>

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

    /* BuzzKo: breathing room between filters and product grid */
    #main-search-filters,
    .facets-wrapper,
    .facets-container,
    .facets__wrapper {
      margin-bottom: 24px !important;
    }

    .mobile-facets__wrapper,
    .mobile-facets {
      margin-bottom: 8px;
    }

    #ProductGridContainer {
      padding-top: 8px;
    }
{%- endstyle -%}

{% paginate search.results by 24 %}
  <div class="template-search{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %} section-{{ section.id }}-padding">
    <div class="template-search__header page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <h1 class="buzzko-search-title">
        {%- if search.performed -%}
          Here's all the good stuff
        {%- else -%}
          Find your little favourite
        {%- endif -%}
      </h1>
      <div class="template-search__search">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- endif -%}
        <main-search>
          <form action="{{ routes.search_url }}" method="get" role="search" class="search">
            <div class="field">
              <input
                class="search__input field__input"
                id="Search-In-Template"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'general.search.search' | t }}"
                {%- if settings.predictive_search_enabled -%}
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="predictive-search-results"
                  aria-controls="predictive-search-results"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                {%- endif -%}
              >

              <input name="options[prefix]" type="hidden" value="last">

              {%- if settings.predictive_search_enabled -%}
                <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
                  {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
                </div>

                <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
              {%- endif -%}

              <button
                type="reset"
                class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
                aria-label="{{ 'general.search.reset' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-reset.svg' | inline_asset_content -}}
                </span>
              </button>
              <button type="submit" class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                <span class="svg-wrapper">
                  {{- 'icon-search.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          </form>
        </main-search>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- endif -%}

        <p id="SearchMinCharsMessage" class="search-min-chars-message" role="status" aria-live="polite">
          Please type at least 3 characters to search.
        </p>
      </div>

      {%- if search.performed -%}
        {%- unless section.settings.enable_filtering or section.settings.enable_sorting -%}
          {%- if search.results_count > 0 -%}
            <p role="status">
              {{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count }}
            </p>
          {%- endif -%}
        {%- endunless -%}

        {%- if search.results_count == 0 and search.filters == empty -%}
          <div class="buzzko-search-empty" role="status">
            <span class="buzzko-search-empty__emoji" aria-hidden="true">🔎</span>
            <h2>Didn't find your little favourite?</h2>
            <p>
              We couldn't find anything for “{{ search.terms | escape }}”.
              But don't worry, we're here to help you find it!
            </p>
            <a href="/pages/contact" class="buzzko-search-contact">
              Contact us
              <span aria-hidden="true">↗</span>
            </a>
            <span class="buzzko-search-empty__note">
              Let's find something you'll love.
            </span>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if search.performed -%}
      {%- if section.settings.enable_sorting
        and section.settings.filter_type == 'vertical'
        and search.filters != empty
      -%}
        <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
          <form class="facets-vertical-form" id="FacetSortForm">
            <div class="facet-filters sorting caption">
              <div class="facet-filters__field">
                <h2 class="facet-filters__label caption-large text-body">
                  <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
                </h2>
                <div class="select">
                  {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
                  <select
                    name="sort_by"
                    class="facet-filters__sort select__select caption-large"
                    id="SortBy"
                    aria-describedby="a11y-refresh-page-message"
                  >
                    {%- for option in search.sort_options -%}
                      <option
                        value="{{ option.value | escape }}"
                        {% if option.value == sort_by %}
                          selected="selected"
                        {% endif %}
                      >
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                  <span class="svg-wrapper">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </div>
              </div>
            </div>

            <div class="product-count-vertical light" role="status">
              <h2 class="product-count__text text-body">
                <span id="ProductCountDesktop">
  {{ search.products_count }} 
  {% if search.products_count == 1 %}
    product
  {% else %}
    products
  {% endif %}
</span>
              </h2>
              {%- render 'loading-spinner' -%}
            </div>
          </form>
        </facet-filters-form>
      {%- endif -%}

      <div
        {% if section.settings.filter_type == 'vertical' %}
          class="facets-vertical page-width"
        {% endif %}
      >
                {%- if search.filters != empty -%}
          {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}

            {%- comment -%}
              BuzzKo: hide the "Charm Style" filter on the search page.
              Match by label, then pre-hide by data-index — for BOTH the
              desktop copy (data-index="N") and the mobile drawer copy
              (data-index="mobile-N"). Emitted before facets render, so
              there is zero flash.
            {%- endcomment -%}
            {%- assign buzzko_search_hidden = '' -%}
            {%- for buzzko_filter in search.filters -%}
              {%- assign buzzko_label = buzzko_filter.label | downcase -%}
              {%- if buzzko_label contains 'charm style' -%}
                {%- assign buzzko_search_hidden = buzzko_search_hidden | append: forloop.index | append: ',' -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if buzzko_search_hidden != blank -%}
              <style>
                {%- assign buzzko_search_indices = buzzko_search_hidden | split: ',' -%}
                {%- for buzzko_idx in buzzko_search_indices -%}
                  {%- if buzzko_idx != blank -%}
                    .js-filter[data-index="{{ buzzko_idx }}"],
                    .facets__disclosure[data-index="{{ buzzko_idx }}"],
                    .js-filter[data-index="mobile-{{ buzzko_idx }}"],
                    .facets__disclosure[data-index="mobile-{{ buzzko_idx }}"],
                    .mobile-facets__details[data-index="mobile-{{ buzzko_idx }}"] {
                      display: none !important;
                    }
                  {%- endif -%}
                {%- endfor -%}
              </style>
            {%- endif -%}

            <aside
              aria-labelledby="verticalTitle"
              class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="main-search-filters"
              data-id="{{ section.id }}"
            >
              {% render 'facets',
                results: search,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: section.settings.enable_sorting,
                filter_type: section.settings.filter_type,
                paginate: paginate
              %}
            </aside>
          {%- endif -%}
        {%- endif -%}

        <div class="product-grid-container" id="ProductGridContainer">
          {%- if search.results.size == 0 and search.filters != empty -%}
            <div
              class="template-search__results collection collection--empty{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <div class="buzzko-search-empty" role="status">
                <span class="buzzko-search-empty__emoji" aria-hidden="true">🔎</span>
                <h2>Didn't find your little favourite?</h2>
                <p>
                  We couldn't find anything for “{{ search.terms | escape }}”.
                  But don't worry, we're here to help you find it!
                </p>
                <a href="{{ routes.contact_url }}" class="buzzko-search-contact">
                  Contact us
                  <span aria-hidden="true">↗</span>
                </a>
                <span class="buzzko-search-empty__note">
                  Let's find something you'll love.
                </span>
              </div>
            </div>
          {%- else -%}
            <div
              class="template-search__results collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <ul
                class="grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
                role="list"
              >
                {%- assign skip_card_product_styles = false -%}
                {%- assign buzzko_index = 0 -%}
                {%- for item in search.results -%}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif %}

                  <li
                    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                    {% endif %}
                  >
                    {%- case item.object_type -%}
                      {%- when 'product' -%}
                        {%- assign product = item -%}
                        
                        {% comment %} 
                          RENDER THE GLOBAL PRODUCT CARD SNIPPET HERE 
                        {% endcomment %}
                        {% render 'buzzko-product-card', product: product, index: buzzko_index, card_subtitle: section.settings.card_subtitle %}
                        
                        {%- assign buzzko_index = buzzko_index | plus: 1 -%}

                      {%- when 'article' -%}
                        {% render 'article-card',
                          article: item,
                          show_image: true,
                          show_date: section.settings.article_show_date,
                          show_author: section.settings.article_show_author,
                          show_badge: true,
                          media_aspect_ratio: 1,
                          lazy_load: lazy_load
                        %}

                      {%- when 'page' -%}
                        <div class="article-card-wrapper card-wrapper underline-links-hover">
                          <div
                            class="card card--card card--text ratio color-{{ settings.blog_card_color_scheme }}"
                            style="--ratio-percent: 100%;"
                          >
                            <div class="card__content">
                              <div class="card__information">
                                <h3 class="card__heading">
                                  <a href="{{ item.url }}" class="full-unstyled-link">
                                    {{ item.title | truncate: 50 | escape }}
                                  </a>
                                </h3>
                              </div>
                              <div class="card__badge {{ settings.badge_position }}">
                                <span class="badge color-{{ settings.color_schemes | first }}">
                                  {{- 'templates.search.page' | t -}}
                                </span>
                              </div>
                            </div>
                          </div>
                        </div>
                    {%- endcase -%}
                  </li>
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{% endpaginate %}

<script>
  (function () {
    function init() {
      // Minimum characters required. Set to 4 for strictly "more than 3".
      var MIN_CHARS = 4;

      var form = document.querySelector('.template-search__search form.search');
      if (!form) return;
      var input = form.querySelector('input[name="q"]');
      if (!input) return;

      var predictive = document.querySelector('predictive-search');
      var message = document.getElementById('SearchMinCharsMessage');

      function showMessage() {
        if (message) message.classList.add('is-visible');
      }
      function hideMessage() {
        if (message) message.classList.remove('is-visible');
      }

      // 1. Block form submit for 1–2 character queries
      document.addEventListener(
        'submit',
        function (e) {
          if (e.target !== form) return;
          var q = (input.value || '').trim();
          if (q.length > 0 && q.length < MIN_CHARS) {
            e.preventDefault();
            e.stopImmediatePropagation();
            showMessage();
            input.focus();
          }
        },
        true
      );

      // 2. Block predictive search (live results) for 1–2 character queries
      document.addEventListener(
        'input',
        function (e) {
          if (e.target !== input) return;
          var q = (input.value || '').trim();
          if (q.length > 0 && q.length < MIN_CHARS) {
            // Stop the event so predictive-search.js never fires a request
            e.stopImmediatePropagation();
            if (predictive && typeof predictive.close === 'function') {
              predictive.close();
            }
            showMessage();
          } else {
            hideMessage();
          }
        },
        true
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

