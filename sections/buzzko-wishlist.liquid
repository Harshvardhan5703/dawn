<section class="buzzko-wishlist page-width" data-buzzko-wishlist-page>
  <header class="buzzko-wishlist__header">
    <p class="buzzko-wishlist__eyebrow">YOUR LITTLE COLLECTION</p>
    <h1 class="buzzko-wishlist__title">{{ section.settings.heading | escape }}</h1>
    {% if section.settings.description != blank %}
      <p class="buzzko-wishlist__description">{{ section.settings.description | escape }}</p>
    {% endif %}
  </header>

  <p class="buzzko-wishlist__loading" data-buzzko-wishlist-loading hidden>Loading your saved favourites…</p>

  <div class="buzzko-wishlist__empty" data-buzzko-wishlist-empty hidden>
    <span class="buzzko-wishlist__empty-heart" aria-hidden="true">♡</span>
    <h2>Your wishlist is waiting for a little love.</h2>
    <p>Tap the heart on a product page to save your favourites here.</p>
    <a href="{{ routes.all_products_collection_url }}" class="buzzko-wishlist__shop">Explore all products</a>
  </div>

  <div class="buzzko-wishlist__grid" data-buzzko-wishlist-grid></div>
</section>

<style>
  .buzzko-wishlist { padding-top: 4rem; padding-bottom: 6rem; color: #1A1A1A; }
  .buzzko-wishlist__header { text-align: center; margin: 0 auto 3.5rem; max-width: 680px; }
  .buzzko-wishlist__eyebrow { margin: 0 0 1rem; font-size: 1.1rem; letter-spacing: .16em; font-weight: 700; }
  .buzzko-wishlist__title { margin: 0; font-size: clamp(3.2rem, 5vw, 5.2rem); line-height: 1.05; letter-spacing: -.04em; }
  .buzzko-wishlist__description { margin: 1.2rem 0 0; color: #5C5754; font-size: 1.5rem; }
  .buzzko-wishlist__loading { text-align: center; padding: 3rem 0; }
  .buzzko-wishlist__empty { text-align: center; max-width: 520px; margin: 0 auto; padding: 3rem 1rem 4rem; }
  .buzzko-wishlist__empty-heart { display: inline-flex; align-items: center; justify-content: center; width: 7rem; height: 7rem; border: 1px solid #1A1A1A; border-radius: 50%; font-size: 4.5rem; line-height: 1; margin-bottom: 1.5rem; }
  .buzzko-wishlist__empty h2 { margin: 0; font-size: clamp(2.2rem, 4vw, 3.2rem); }
  .buzzko-wishlist__empty p { color: #5C5754; line-height: 1.6; }
  .buzzko-wishlist__shop { display: inline-flex; align-items: center; justify-content: center; margin-top: 1rem; min-height: 4.4rem; padding: 0 2.2rem; border: 1px solid #1A1A1A; border-radius: 999px; background: #1A1A1A; color: #FFFAF5; text-decoration: none; font-weight: 600; }
  .buzzko-wishlist__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
  .buzzko-wishlist-card { min-width: 0; overflow: hidden; border: 2px solid #F8B5D1; border-radius: 20px; background: #FFFAF5; padding: 1rem; }
  .buzzko-wishlist-card:nth-child(6n + 2) { border-color: #B9E404; }
  .buzzko-wishlist-card:nth-child(6n + 3) { border-color: #9DDCF7; }
  .buzzko-wishlist-card:nth-child(6n + 4) { border-color: #FFD96A; }
  .buzzko-wishlist-card:nth-child(6n + 5) { border-color: #CDB8F5; }
  .buzzko-wishlist-card:nth-child(6n + 6) { border-color: #FF9FC8; }
  .buzzko-wishlist-card__image { display: block; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 13px; background: #F5F1EC; }
  .buzzko-wishlist-card__image img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .buzzko-wishlist-card__body { padding: 1.2rem .2rem .2rem; }
  .buzzko-wishlist-card__title { display: block; color: inherit; font-size: 1.55rem; line-height: 1.35; text-decoration: none; font-weight: 650; }
  .buzzko-wishlist-card__variant { margin: .4rem 0 0; color: #6F6964; font-size: 1.2rem; }
  .buzzko-wishlist-card__price { margin: .8rem 0 1.2rem; font-size: 1.5rem; font-weight: 700; }
  .buzzko-wishlist-card__actions { display: flex; flex-direction: column; gap: .7rem; }
  .buzzko-wishlist-card__atc, .buzzko-wishlist-card__remove { display: inline-flex; align-items: center; justify-content: center; min-height: 3.8rem; padding: .8rem 1.2rem; border-radius: 999px; font: inherit; font-size: 1.3rem; font-weight: 600; cursor: pointer; }
  .buzzko-wishlist-card__atc { border: 1px solid #1A1A1A; background: #1A1A1A; color: #FFFAF5; }
  .buzzko-wishlist-card__atc:disabled { opacity: .5; cursor: not-allowed; }
  .buzzko-wishlist-card__remove { border: 1px solid rgba(26,26,26,.35); background: transparent; color: #1A1A1A; }
  @media screen and (max-width: 989px) { .buzzko-wishlist__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem; } }
  @media screen and (max-width: 749px) {
    .buzzko-wishlist { padding-top: 2.8rem; padding-bottom: 4rem; }
    .buzzko-wishlist__header { margin-bottom: 2.4rem; }
    .buzzko-wishlist__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .buzzko-wishlist-card { padding: .7rem; border-radius: 14px; border-width: 2px; }
    .buzzko-wishlist-card__image { border-radius: 9px; }
    .buzzko-wishlist-card__body { padding: .9rem .2rem .2rem; }
    .buzzko-wishlist-card__title { font-size: 1.3rem; }
    .buzzko-wishlist-card__price { font-size: 1.3rem; margin: .6rem 0 1rem; }
    .buzzko-wishlist-card__atc, .buzzko-wishlist-card__remove { min-height: 3.4rem; font-size: 1.1rem; padding: .6rem .7rem; }
  }
</style>

{% schema %}
{
  "name": "BuzzKo Wishlist",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Wishlist"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "All the little things you have your eye on."
    }
  ],
  "presets": [
    {
      "name": "BuzzKo Wishlist"
    }
  ]
}
{% endschema %}
